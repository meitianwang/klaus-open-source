  "ancestryCases": [
    { "selfSigned": true, "ancestorMatched": true, "trusted": true },
    { "selfSigned": true, "ancestorMatched": false, "trusted": false },
    { "selfSigned": false, "ancestorMatched": false, "trusted": true },
    { "selfSigned": false, "ancestorMatched": true, "trusted": true }
  ],
  "lockedUse": {
    "_why": "Locked-use hardening: a watch mode the host arms after this helper family unlocked the screen treats any unmarked physical input as a person taking over, re-locks with the standard chord and pauses the turn with verbatim wording; the ancestry gate keeps the stored credential spendable only by a trusted launcher.",
    "watchMethod": "watchLockedUse",
    "startedMarker": "klaus-locked-use-watch-started",
    "watchFrames": ["physicalInput", "tapDisabled", "unavailable", "stopped"],
    "relockedField": "relocked",
    "ownInputMark": "0x4b4c4155",
    "armGraceMs": 1500,
    "relockVerifyMs": 2000,
    "relockChord": { "keycode": 12, "modifiers": "control+command" },
    "ancestorWalkDepth": 10,
    "autoUnlockedField": "autoUnlocked",
    "overlayAllDisplaysOnAutoUnlock": true,
    "trustMessage": "Automatic unlock is unavailable because this helper was not launched by a trusted Klaus process. Ask the user to unlock the Mac manually.",
    "pauseMessages": {
      "relocked": "Physical keyboard or mouse input was detected, so the screen was re-locked and this Computer Use turn is paused. Ask the user to unlock the Mac manually; work can continue in a new turn.",
      "relockFailed": "Physical keyboard or mouse input was detected and this Computer Use turn is paused, but the screen could not be re-locked automatically. Ask the user to lock the Mac manually; work can continue in a new turn."
    }
  },
  "inputCases": [
