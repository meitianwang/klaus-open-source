    { "name": "no stored password", "locked": [true], "idle": 10, "enabled": true, "password": false, "attempts": 0, "outcome": "manual", "trusted": true, "returned": false },
    { "name": "person at lock screen", "locked": [true], "idle": 4.9, "enabled": true, "password": true, "attempts": 0, "outcome": "paused", "trusted": true, "returned": false },
    { "name": "unknown physical input", "locked": [true], "idle": -1, "enabled": true, "password": true, "attempts": 0, "outcome": "paused", "trusted": true, "returned": false },
    { "name": "system refuses unlock", "locked": [true, true], "idle": 10, "enabled": true, "password": true, "attempts": 1, "outcome": "manual", "trusted": true, "returned": false },
    { "name": "observed unlocked after attempt", "locked": [true, false], "idle": 10, "enabled": true, "password": true, "attempts": 1, "outcome": "unlocked", "trusted": true, "returned": true },
    { "name": "lock state cannot be read", "locked": [null], "idle": 10, "enabled": true, "password": true, "attempts": 0, "outcome": "manual", "trusted": true, "returned": false },
    { "name": "verification cannot be read", "locked": [true, null], "idle": 10, "enabled": true, "password": true, "attempts": 1, "outcome": "manual", "trusted": true, "returned": false },
    { "name": "cancelled before input", "locked": [true], "idle": 10, "enabled": true, "password": true, "cancelBeforeInput": true, "attempts": 0, "outcome": "cancelled", "trusted": true, "returned": false },
    { "name": "untrusted launcher", "locked": [true], "idle": 10, "enabled": true, "password": true, "trusted": false, "attempts": 0, "outcome": "untrusted", "returned": false }
