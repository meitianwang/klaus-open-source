{
  "_why": "Computer Use preserves standing auto-unlock intent and secret-free policy results. Native input collection, fixed-account keychain access, cancellation ownership and observed unlock results are pinned independently of any other client.",
  "credential": { "service": "agent-engine", "account": "computer_use.login_password", "promptTimeoutMs": 180000, "passwordInHost": false },
