  "rejectedEditionServices": ["arbitrary", "agent-engine-", "agent-engine--sample", "agent-engine-Sample", "agent-engine_sample", "xagent-engine"],
  "presence": { "interactionSeconds": 1.5, "ownPostMarginSeconds": 0.2, "cooldownMs": 2000, "lockedPhysicalSeconds": 5 },
  "verificationDelayMs": 600,
  "lockCases": [
