  ],
  "rules": {
    "startedVisible": true,
    "terminalRowsRetainedInCompletedProcess": true,
    "terminalRowsKeepOriginalTurn": true,
    "historicalStartCannotPinCompletedProcess": true,
    "explicitDisclosureChoiceSurvivesHandoff": true,
    "childUsesStreamingTranscript": true,
    "unphasedChildTerminalTailIsFinal": true,
    "explicitCommentaryIsNeverInferredFinal": true,
    "persistentRunCompletionIndependentOfTaskLifetime": true,
    "adjacentLifecycleStatesShareBoundedGroup": true,
    "latestNoticePerChildWithinGroup": true,
    "savedLateRowsAcrossTurnsReturnToOwningProcess": true,
    "ordinaryResumedTextKeepsChronology": true,
    "lastGroupReflectsCurrentOwnedCompletion": true,
    "laterParentOwnershipSettlesOlderProcess": true,
    "replayedIdentitiesSkipEntranceAnimation": true,
    "newIdentityAnimatesOncePerTurn": true,
    "unknownTerminalRecordsHaveNoDeadControl": true,
    "knownTerminalRecordsOpenConversation": true,
    "localizedCountAndPluralStatusMatchReference": true,
    "savedSpawnOnlyRowsReflectCurrentCompletion": true,
    "savedSpawnOnlyRowsSkipReplayAnimation": true,
    "lateLifecycleRowsSelectFinalOwningSegment": true,
    "mixedResumedSegmentsReturnOnlyLifecycleRowsToProcess": true,
    "flatSavedCommentaryRetainsExplicitPhase": true,
    "liveResumedTextKeepsChronology": true,
    "aliasIdentitySharedByGroupingAndEntrance": true,
    "unregisteredSavedSpawnHasNoDeadControl": true,
    "unownedLifecycleRowsAreDropped": true,
    "activeChildBeforeTaskRegistrationHydratesExistingFacade": true,
    "parentSwitchDuringHydrationCannotOpenAnotherChild": true,
    "earlyLifecycleIdentityCoalescesIntoTaskCallAndOpenTab": true
  },
  "compactPresentation": {
