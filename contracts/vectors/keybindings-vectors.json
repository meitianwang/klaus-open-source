      },
      {
        "accelerator": "CmdOrCtrl+Plus",
        "label": "⌘+"
      },
      {
        "accelerator": "LeftOption+RightOption",
        "label": "⌥ + ⌥"
      },
      {
        "accelerator": "LeftCommand+RightCommand",
        "label": "⌘ + ⌘"
      },
      {
        "accelerator": "LeftShift+RightShift",
        "label": "⇧ + ⇧"
      },
      {
        "accelerator": "Fn",
        "label": "Fn"
      },
      {
        "accelerator": "MouseBack",
        "label": "Mouse Back"
      }
    ],
    "_note_macOS": "⌃ appears ONLY for an explicit Control token. CmdOrCtrl contributes Command alone, so CmdOrCtrl+Alt+Shift+C is ⌥⇧⌘C — verified by running the formatter itself, not by hand. Plus renders as + only on macOS.",
    "windows": [
      {
        "accelerator": "CmdOrCtrl+Shift+T",
        "label": "Ctrl+Shift+T"
      },
      {
        "accelerator": "CmdOrCtrl+Alt+Shift+C",
        "label": "Ctrl+Alt+Shift+C"
      },
      {
        "accelerator": "Control+Alt+Shift+Command+C",
        "label": "Ctrl+Alt+Shift+Win+C"
      },
      {
        "accelerator": "Shift+Escape",
        "label": "Shift+Esc"
      },
      {
        "accelerator": "Super+Alt+P",
        "label": "Alt+Win+P"
      },
      {
        "accelerator": "CmdOrCtrl+Shift+/",
        "label": "Ctrl+Shift+/"
      },
      {
        "accelerator": "CmdOrCtrl+Plus",
        "label": "Ctrl+Plus"
      },
      {
        "accelerator": "LeftOption+RightOption",
        "label": "Right Option"
      }
    ],
    "_note_windows": "Order is Ctrl,Alt,Shift,Cmd,Super,Win, so Super+Alt+P prints Alt+Win+P. The whole-segment aliases apply on macOS only, so LeftOption+RightOption falls through to per-token handling where the LAST unrecognized token becomes the main key: 'Right Option'.",
    "linux": [
      {
        "accelerator": "Super+Alt+P",
        "label": "Alt+Super+P"
      },
      {
        "accelerator": "Command+Shift+G",
        "label": "Shift+Super+G"
      }
    ],
    "_note_linux": "Command maps to Super on Linux (not Win, and not Cmd), and the same modifier order applies."
  },
