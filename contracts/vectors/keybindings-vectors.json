{
  "_why": "The keybinding engine's rules are documented beside the implementation in contracts/keybindings.ts. These vectors pin the observable rules so a refactor cannot silently regress them: the file shape and its two distinct empty meanings (absent command = registry default, key:null = explicitly unassigned), the resolution order (custom -> platformDefaultKeybindings -> defaultKeybindings, where a platform array REPLACES rather than merges), accelerator formatting on all three platforms including the ⌃⌥⇧⌘ order and the Shift+/ -> ? fold, capture normalization (Ctrl,Command,Alt,Shift order, Up not ArrowUp, Space not ' '), chord-prefix conflict detection, the equivalent-command exemption that lets ⌘K open the command menu everywhere except the work panel where it starts the close-tabs chord, reserved native-Find keys versus the find-handoff key (⌘F binds like any command key and only an active in-surface find bar takes it over), lenient parsing of a hand-edited file, sorted+indented+newline-terminated writes, and the os-global single-binding rule.",
  "storage": {
    "fileName": "keybindings.json",
    "serialized": "[\n  {\n    \"command\": \"newChat\",\n    \"key\": \"CmdOrCtrl+Alt+N\"\n  }\n]\n",
    "rowShape": {
      "command": "newChat",
      "key": "CmdOrCtrl+Alt+N"
    },
    "explicitUnassignedShape": {
      "command": "newChat",
      "key": null
    },
    "sortIsByCommandId": {
      "input": [
        {
          "command": "toggleSidebar",
          "key": "CmdOrCtrl+B"
        },
        {
          "command": "archiveThread",
          "key": "CmdOrCtrl+Shift+A"
        }
      ],
      "output": [
        {
          "command": "archiveThread",
          "key": "CmdOrCtrl+Shift+A"
        },
        {
          "command": "toggleSidebar",
          "key": "CmdOrCtrl+B"
        }
      ]
    },
    "lenientParse": {
      "emptyFileYieldsNoBindings": {
        "raw": "",
        "bindings": []
      },
      "whitespaceOnlyYieldsNoBindings": {
        "raw": "   \n ",
        "bindings": []
      },
      "malformedJsonYieldsNoBindings": {
        "raw": "[{\"command\":",
        "bindings": []
      },
      "nonArrayYieldsNoBindings": {
        "raw": "{\"command\":\"newChat\"}",
        "bindings": []
      },
      "unknownCommandIsDropped": {
        "raw": "[{\"command\":\"notARealCommand\",\"key\":\"CmdOrCtrl+Q\"}]",
        "bindings": []
      },
      "rowWithoutCommandIsDropped": {
        "raw": "[{\"key\":\"CmdOrCtrl+Q\"}]",
        "bindings": []
      },
      "rowWithNonStringKeyIsDropped": {
        "raw": "[{\"command\":\"newChat\",\"key\":42}]",
        "bindings": []
      },
      "validRowSurvives": {
        "raw": "[{\"command\":\"newChat\",\"key\":\"CmdOrCtrl+Alt+N\"}]",
        "bindings": [
          {
            "command": "newChat",
            "key": "CmdOrCtrl+Alt+N"
          }
        ]
      }
    }
  },
