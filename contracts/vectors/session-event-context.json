{
  "_why": "Full event projection must use the active session binding. A global source change cannot retarget an existing subscription card or change a running session's retry budget. The retired official and on-device sources no longer appear: every remaining bound source gets the re-login card on auth failure. The context-free mapChatEvents contract remains independent.",
  "inputs": {
    "retry": {
      "type": "rawSessionEvent",
      "params": {
        "sessionId": "engine-session",
        "event": {
          "event": {
            "type": "provider.decision",
            "event": {
              "kind": "retry_scheduled",
              "attempt": 1,
              "debug": {
                "errorKind": "rate_limit"
              }
            }
          }
        }
      }
    },
    "rawAuth": {
      "type": "rawSessionEvent",
      "params": {
        "sessionId": "engine-session",
        "event": {
          "event": {
            "type": "turn.completed",
            "stopReason": "auth_failed"
          }
        }
      }
    },
    "typedAuth": {
      "type": "productEvent",
      "method": "turn/failed",
      "params": {
        "sessionId": "engine-session",
        "submissionId": "turn-1",
        "detail": {
          "error": {
            "code": "auth_failed",
            "message": "Session credential expired"
          }
        }
      }
    },
    "retryNetworkWait": {
      "type": "rawSessionEvent",
      "params": {
        "sessionId": "engine-session",
        "event": {
          "event": {
            "type": "provider.decision",
            "event": {
              "kind": "retry_scheduled",
              "attempt": 3,
              "maxAttempts": 3,
              "phase": "networkWait",
              "debug": {
                "errorKind": "network"
              }
            }
          }
        }
      }
    },
    "retryWithBudget": {
      "type": "rawSessionEvent",
      "params": {
        "sessionId": "engine-session",
        "event": {
          "event": {
            "type": "provider.decision",
            "event": {
              "kind": "retry_scheduled",
              "attempt": 1,
              "maxAttempts": 5,
              "phase": "stream",
              "debug": {
                "errorKind": "rate_limit"
              }
            }
          }
        }
      }
    }
  },
