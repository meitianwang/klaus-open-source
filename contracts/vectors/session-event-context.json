  "terminalIdleFrame": {
    "_why": "The renderer's running indicator is derived from the engine turn lifecycle. Every terminal chat frame (interrupted, done, terminal api_error) is followed by an explicit idle session_runtime_status frame carrying the terminal frame's turnId (null when unnamed), so a renderer whose copy of the truth drifted converges without trusting the host registry. Amended 2026-10-06 with the stale-running-state fix.",
    "type": "session_runtime_status",
    "status": "idle",
    "turnId": "the terminal frame's turnId, or null",
    "emittedAfter": [
      "interrupted",
      "done",
      "terminal api_error"
    ]
  },
  "cursorRecoveryCases": [
    {
      "name": "expired access snapshot",
      "reason": "cursor_adopted_credential_needs_reimport",
      "recover": true
    },
    {
      "name": "missing request metadata",
      "reason": "cursor_client_metadata_missing",
      "recover": true
    },
    {
      "name": "endpoint refusal preserves account state",
      "reason": "cursor_inference_not_enabled",
      "recover": false
    },
    {
      "name": "unknown authentication error",
      "reason": "cursor_unknown_auth_error",
      "recover": false
    }
  ]
}
