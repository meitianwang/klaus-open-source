{
  "schemaVersion": 2,
  "reason": "One update lifecycle has two visual surfaces: the persistent sidebar card for available, downloading, and ready offers, and the centered installation overlay once the user starts installing. Available and ready offers stay out of the centered modal area so background checks and downloads never interrupt active work; clicking install raises the centered overlay immediately while verification and installation complete.",
  "dismissTtlMs": 43200000,
  "downloadBarCeiling": 60,
  "surfaceCases": [
    {
      "name": "idle shows nothing",
      "state": "idle",
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "checking shows no transfer surface",
      "state": "checking",
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "an available offer shows only the sidebar card",
      "state": "available",
      "postponed": false,
      "expect": {
        "banner": true,
        "installingOverlay": false
      }
    },
    {
      "name": "postponing an available offer silences the sidebar card",
      "state": "available",
      "postponed": true,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "an available state without a version is not an offer",
      "state": "available",
      "version": null,
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "a running transfer shows only the sidebar card, never a centered modal",
      "state": "downloading",
      "postponed": false,
      "expect": {
        "banner": true,
        "installingOverlay": false
      }
    },
    {
      "name": "a running transfer stays visible in the sidebar card even if an earlier offer was postponed",
      "state": "downloading",
      "postponed": true,
      "expect": {
        "banner": true,
        "installingOverlay": false
      }
    },
    {
      "name": "a finished transfer stays in the sidebar card without raising a modal",
      "state": "downloaded",
      "postponed": false,
      "expect": {
        "banner": true,
        "installingOverlay": false
      }
    },
    {
      "name": "postponing silences a finished offer",
      "state": "downloaded",
      "postponed": true,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "clicking install raises the centered overlay immediately while verification runs",
      "state": "downloaded",
      "postponed": false,
      "installRequested": true,
      "expect": {
        "banner": false,
        "installingOverlay": true
      }
    },
    {
      "name": "installation owns the screen",
      "state": "installing",
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": true
      }
    },
    {
      "name": "installation cannot be postponed away",
      "state": "installing",
      "postponed": true,
      "expect": {
        "banner": false,
        "installingOverlay": true
      }
    },
    {
      "name": "an unsupported installation shows no notice",
      "state": "downloaded",
      "supported": false,
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    },
    {
      "name": "a downloaded state without a version is not an offer",
      "state": "downloaded",
      "version": null,
      "postponed": false,
      "expect": {
        "banner": false,
        "installingOverlay": false
      }
    }
  ],
