      "beforeCompactionRows": 20,
      "afterCompactionRows": 130
    },
    {
      "name": "cold open includes the latest long turn across compaction in legacy history",
      "withTurnIds": false,
      "beforeCompactionRows": 20,
      "afterCompactionRows": 130
    }
  ],
