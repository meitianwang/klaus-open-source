    "startsOnArrival": {
      "_why": "Only a false→true transition starts a walkthrough. This is the rule that keeps two interruptions from happening: a surface already open at boot (restored window state, a deep link) is acknowledged rather than greeted with a modal over the first frame, and a tour deferred because the guide was up does not fire later on some unrelated mutation while the user is still sitting on that page — the guide already told them about it.",
      "_base": {
        "previous": false,
        "now": true,
        "initialSweep": false
      },
      "cases": [
        {
          "_why": "the user just navigated here: this is an arrival",
          "start": true
        },
        {
          "_why": "the first sweep records what is already open without starting anything",
          "initialSweep": true,
          "start": false
        },
        {
          "_why": "still sitting on a page already acknowledged is not a new arrival",
          "previous": true,
          "start": false
        },
        {
          "_why": "leaving a surface starts nothing",
          "now": false,
          "start": false
        },
        {
          "_why": "an entry never evaluated before is treated as the first sweep's job",
          "previous": null,
          "initialSweep": true,
          "start": false
        }
      ]
    }
  },
