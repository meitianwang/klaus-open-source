      {
        "_why": "a concurrent acknowledgement from another window survives our write",
        "base": [
          "a"
        ],
        "other": [
          "b"
        ],
        "result": [
          "a",
          "b"
        ]
      },
      {
        "_why": "base order is preserved and only the new id is appended",
        "base": [
          "a",
          "b"
        ],
        "other": [
          "b",
          "c"
        ],
        "result": [
          "a",
          "b",
          "c"
        ]
      },
      {
        "_why": "an identical ledger is a no-op",
        "base": [
          "a"
        ],
        "other": [
          "a"
        ],
        "result": [
          "a"
        ]
      },
      {
        "_why": "merging with nothing returns the base unchanged",
        "base": [
          "a",
          "b"
        ],
        "other": [],
        "result": [
          "a",
          "b"
        ]
      },
