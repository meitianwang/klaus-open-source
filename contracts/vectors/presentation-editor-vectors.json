{
  "version": 1,
  "reason": "The PPT plugin uses Klaus-owned revisioned documents and native protocol adaptation, without a separate file service process.",
  "exports": [
    {"format": "pptx", "variant": "basic"},
    {"format": "pptx", "variant": "current"},
    {"format": "pptx", "variant": "pictures"},
    {"format": "pdf"},
    {"format": "png"},
    {"format": "html"}
  ],
  "nativeChannels": ["ppt:transport-ready", "ppt:chat-request", "ppt:save-file"],
  "mainChannels": ["ppt:list", "ppt:open", "ppt:open-result", "ppt:panel-show", "ppt:panel-set-bounds", "ppt:panel-hide", "ppt:panel-close", "ppt:chat-result"],
  "ownership": {
    "documents": "chat",
    "requestAcknowledgement": "originating main window",
    "publishFiles": "chat workspace roots",
    "close": "flush editor, wait for saved state, release view and message ports, retain native document revisions"
  },
  "hosting": {"documentStore": "Klaus host", "separateFileServiceProcess": false, "runtimeBridgeVersion": 2, "emptyRevision": "list the served index.html entry; load before first publish and accept live updates", "attribution": "none for local documents", "contentSandbox": {"allow-scripts": true, "allow-same-origin": true, "allow-popups": false}},
  "editing": ["text", "undo", "redo", "speaker notes", "automatic save", "live file updates", "reopen saved content"],
  "excluded": ["comments", "external connectors", "Google Drive"],
  "authoring": {
    "validator": "authoring/validate.cjs",
    "export": "validateFiles",
    "candidate": "complete saved snapshot",
    "validReceipt": {"saved": true, "validated": true},
    "invalidReceipt": {"saved": false, "validated": false, "versionUnchanged": true},
    "diagnostics": ["errors", "warnings", "slides", "contentHash", "files", "assets"]
  },
  "agentTools": ["ppt_open", "ppt_inspect", "ppt_publish", "ppt_import_asset", "ppt_export"],
  "media": {
    "assetUrlPrefix": "/_blob/",
    "assetTypes": ["image/png", "image/jpeg", "image/gif", "image/webp", "image/avif", "image/svg+xml", "video/mp4", "video/webm", "audio/mpeg", "audio/ogg", "audio/wav", "font/woff", "font/woff2", "font/ttf", "font/otf"],
    "contentCsp": "media-src 'self' blob: data:"
  },
  "cancelledSave": {"ok": false, "cancelled": true}
}
