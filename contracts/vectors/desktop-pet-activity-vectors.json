            "requestId": "form",
            "type": "mcp-elicit",
            "serverName": "Calendar",
            "message": "Confirm event",
            "requestedSchema": {
              "type": "object",
              "required": [
                "count"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 2
