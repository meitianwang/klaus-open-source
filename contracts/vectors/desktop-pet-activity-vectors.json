              "status": "active",
              "turnId": "one"
            }
          ]
        },
        {
          "dismiss": "thread"
        },
        {
          "input": "permission:request",
          "value": {
            "sessionId": "thread",
            "requestId": "ask",
            "turnId": "one"
          }
        },
        {
          "chat": [
            {
              "type": "done",
              "sessionId": "thread",
              "turnId": "one"
            }
          ]
        },
        {
          "expected": []
        },
        {
          "chat": [
            {
              "type": "session_runtime_status",
              "sessionId": "thread",
              "status": "active",
              "turnId": "two"
            }
          ]
        },
        {
          "expected": [
            {
              "id": "thread",
              "status": "running",
              "unread": false
            }
          ]
        }
      ]
    },
