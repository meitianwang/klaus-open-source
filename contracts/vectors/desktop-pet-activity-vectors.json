{
  "description": "Desktop activity cards preserve actionable work, stable turn identity, newest-turn ordering and bounded terminal retention. Reading a completed result clears its card; a failed task remains actionable until dismissed or expired. Dismissal suppresses the current turn only. Explicit running summaries become visible only after successful current-turn completion. Waiting cards carry the current typed approval, question or elicitation.",
  "streamProcessing": {
    "reason": "Streaming content and unchanged activity must not rebuild retained task cards or read persistent settings on the host event loop.",
    "retainedTasks": 64,
    "packets": 256,
    "contentMethods": [
      "item/agentMessage/delta",
      "item/reasoning/delta"
    ],
    "contentTypes": [
      "text_delta",
      "thinking_delta"
    ],
    "steadyStateLanguageReads": 0,
    "snapshotLanguageReads": 1
  },
  "cases": [
    {
      "name": "tasks sort by newest turn across waiting, failure, completion and running states",
      "steps": [
        {
          "chat": [
            {
              "type": "session_runtime_status",
              "sessionId": "running",
              "status": "active",
              "turnId": "r"
            }
          ]
        },
        {
          "advance": 1
        },
        {
          "chat": [
            {
              "type": "session_runtime_status",
              "sessionId": "done",
              "status": "active",
              "turnId": "d"
            },
            {
              "type": "done",
              "sessionId": "done",
              "turnId": "d"
            }
          ]
        },
        {
          "advance": 1
        },
        {
          "chat": [
            {
              "type": "session_runtime_status",
              "sessionId": "failed",
              "status": "active",
              "turnId": "f"
            },
            {
              "type": "api_error",
              "sessionId": "failed",
              "turnId": "f",
              "terminal": true
            }
          ]
        },
        {
          "advance": 1
        },
        {
          "input": "permission:request",
          "value": {
            "sessionId": "waiting",
            "requestId": "ask"
          }
        },
        {
          "expected": [
            {
              "id": "waiting",
              "status": "waiting",
              "unread": true
            },
            {
              "id": "failed",
              "status": "failed",
              "unread": true
            },
            {
              "id": "done",
              "status": "completed",
              "unread": true
            },
            {
              "id": "running",
              "status": "running",
              "unread": false
            }
          ]
        }
      ]
    },
    {
