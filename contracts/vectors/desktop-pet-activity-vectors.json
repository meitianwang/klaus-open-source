    {
      "name": "command approval carries its exact operation and review context",
      "steps": [
        {
          "input": "permission:request",
          "value": {
            "sessionId": "thread",
            "requestId": "approve",
            "toolCallId": "tool",
            "toolName": "Bash",
            "message": "Run checks?",
            "toolInput": {
              "command": "npm test\nprintf done",
              "cwd": "/project",
              "privateCredential": "excluded"
            }
          }
        },
        {
          "expected": [
            {
              "id": "thread",
              "status": "waiting",
              "attention": {
                "id": "approve",
                "toolCallId": "tool",
                "message": "Run checks?",
                "kind": "approval",
                "toolName": "Bash",
                "category": "command",
                "command": "npm test\nprintf done",
                "cwd": "/project"
              }
            }
          ]
        }
      ]
