        "sandboxMode": "workspace-write",
        "approvalsReviewer": "user",
        "sandboxNetworkAllowed": false
      },
      "expected": {
        "approval": "never",
        "sandbox": "workspace-write",
        "reviewer": "user"
      }
    },
    {
      "name": "automatic review retains its policy with a custom full filesystem policy",
