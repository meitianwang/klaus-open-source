  "executionPolicyCases": [
    {
      "name": "configured full access skips approval prompts",
      "policy": {
        "approvalPolicy": "never",
        "sandboxMode": "danger-full-access",
        "approvalsReviewer": "user",
        "sandboxNetworkAllowed": true
      },
      "expected": {
        "approval": "never",
        "sandbox": "danger-full-access",
        "reviewer": "user"
      }
    },
    {
      "name": "unrestricted filesystem with approval requests retains approval gates",
      "policy": {
        "approvalPolicy": "on-request",
        "sandboxMode": "danger-full-access",
        "approvalsReviewer": "user",
        "sandboxNetworkAllowed": true
      },
      "expected": {
        "approval": "on-request",
        "sandbox": "danger-full-access",
        "reviewer": "user"
      }
    },
    {
      "name": "disabled prompts within a workspace do not grant unrestricted execution",
