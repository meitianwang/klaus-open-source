          "harnessEnvelope": "subagent-message"
        },
        {
          "type": "text",
          "text": "Continue the scoped review.\nKeep tool results visible.",
          "harnessEnvelope": "subagent-message"
        }
      ],
      "expected": {
        "senderId": "parent-session",
        "text": "Continue the scoped review.\nKeep tool results visible."
      }
    },
    {
