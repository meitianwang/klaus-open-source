{
  "_why": "Conversation identity, transcript availability, and title presentation are independent. An existing session with unresolved history must enter a loading transcript surface immediately; a placeholder or missing title is never evidence that the session is empty. Only an explicit new-chat draft shows the welcome surface; a real conversation whose authoritative history is empty renders its empty transcript surface with the composer, so an admitted-but-empty chat never masquerades as a brand-new draft.",
  "presentation": {
    "_why": "Reopening saved conversations must preserve settled rendering and position the loaded transcript before its first visible frame. Independent change records start alongside history without blocking it.",
    "messageEntranceAnimation": false,
    "reuseSettledMarkdownOnRevisit": true,
    "initialHistoryPosition": "restore-saved-distance-before-paint",
    "unvisitedHistoryPosition": "latest",
    "preserveMeasuredTurnViewport": true,
    "renderedWindowIdentity": "turn-key",
    "initialPositionRespectsUserScrollAndNavigation": true,
    "restorePanelWidthBeforeTranscriptMount": true,
    "changeRecordLoad": "parallel-with-history",
    "scrollPositionBasis": "distance-from-bottom",
    "scrollIntentWindowMs": 1000,
    "bottomFollowTolerancePx": 24,
    "historyBoundaryTolerancePx": 64,
    "virtualTurnOverscan": 2,
    "defaultTurnEstimatePx": 280,
    "historyGapEstimatePx": 144,
    "virtualListHeight": "explicit-total-height",
    "newMessagePlacementMaxDistancePx": 300,
    "responseSpacerFraction": 0.6666666666666666,
    "responseSpacerMinimumClearancePx": 240,
    "loadingIndicatorDelayMs": 400,
    "savedViewportFields": [
      "distanceFromBottomPx",
      "turnHeightsByKey",
      "renderedWindow",
      "latestTurn"
    ]
  },
  "cases": [
    {
      "name": "global new-chat draft",
      "input": { "sessionId": null, "draftOnly": false, "running": false, "liveUnitCount": 0, "history": null },
      "expected": "welcome"
    },
    {
      "name": "promoted attachment-only draft",
      "input": { "sessionId": "draft-session", "draftOnly": true, "running": false, "liveUnitCount": 0, "history": null },
      "expected": "welcome"
    },
    {
      "name": "existing titleless session awaiting history",
      "input": { "sessionId": "legacy-titleless", "draftOnly": false, "running": false, "liveUnitCount": 0, "history": null },
      "expected": "loading"
    },
    {
      "name": "existing placeholder session with content",
      "input": { "sessionId": "legacy-placeholder", "draftOnly": false, "running": false, "liveUnitCount": 0, "history": [{ "role": "user", "text": "Persisted content" }] },
      "expected": "transcript"
    },
    {
      "name": "authoritatively empty persisted shell",
      "input": { "sessionId": "empty-shell", "draftOnly": false, "running": false, "liveUnitCount": 0, "history": [] },
      "expected": "transcript"
    },
    {
      "name": "running session before history",
      "input": { "sessionId": "running-session", "draftOnly": false, "running": true, "liveUnitCount": 0, "history": null },
      "expected": "transcript"
    },
    {
      "name": "live session before history",
      "input": { "sessionId": "live-session", "draftOnly": false, "running": false, "liveUnitCount": 1, "history": null },
      "expected": "transcript"
    }
  ],
  "scrollBehavior": {
    "_why": "The main transcript and both side panes share placement, response spacing and following. Only directional user input changes following. Stable turn identities and bottom-relative geometry preserve the reading position across window changes, prepends and measurements; a sent message near the latest content reserves consumable space for the response rather than leaving the submitted bubble below the viewport.",
    "placementCases": [
      {
        "name": "at latest content",
        "distancePx": 0,
        "spacerPx": 0,
        "expected": true
      },
      {
        "name": "placement boundary",
        "distancePx": 300,
        "spacerPx": 0,
        "expected": true
      },
      {
        "name": "reading older content",
        "distancePx": 301,
        "spacerPx": 0,
        "expected": false
      },
      {
        "name": "existing reserved response space",
        "distancePx": 700,
        "spacerPx": 400,
        "expected": true
      },
      {
        "name": "outside reserved response space",
        "distancePx": 701,
        "spacerPx": 400,
        "expected": false
      }
    ],
    "spacerCases": [
      {
        "name": "normal viewport",
        "heightPx": 900,
        "paddingPx": 0,
        "expectedPx": 600
      },
      {
        "name": "footer reduces available space",
        "heightPx": 900,
        "paddingPx": 90,
        "expectedPx": 540
      },
      {
        "name": "clearance limits shorter viewport",
        "heightPx": 600,
        "paddingPx": 0,
        "expectedPx": 360
      },
      {
        "name": "tiny viewport reserves no space",
        "heightPx": 220,
        "paddingPx": 0,
        "expectedPx": 0
      }
    ],
    "restoreDistanceCases": [
      {
        "name": "visible response space restores latest",
        "distancePx": 1,
        "spacerPx": 400,
        "paddingPx": 32,
        "expectedPx": 0
      },
      {
        "name": "reading position excludes response space",
        "distancePx": 900,
        "spacerPx": 400,
        "paddingPx": 32,
        "expectedPx": 500
      },
      {
        "name": "ordinary reading position",
        "distancePx": 250,
        "spacerPx": 0,
        "paddingPx": 32,
        "expectedPx": 250
      }
    ],
    "followCases": [
      {
        "name": "placed message holds viewport",
        "initial": "user_follow",
        "events": [
          {
            "type": "latest_turn_placed"
          }
        ],
        "expected": "static"
      },
      {
        "name": "work waits until viewport overflow",
        "initial": "static",
        "events": [
          {
            "type": "latest_turn_phase_changed",
            "previousLatestTurnPhase": "idle",
            "latestTurnPhase": "prework"
          },
          {
            "type": "latest_turn_follow_content_changed",
            "followContentOverflowPx": 0,
            "latestTurnPhase": "prework"
          }
        ],
        "expected": "prework_watch"
      },
      {
        "name": "overflowing work begins following",
        "initial": "prework_watch",
        "events": [
          {
            "type": "latest_turn_follow_content_changed",
            "followContentOverflowPx": 1,
            "latestTurnPhase": "prework"
          }
        ],
        "expected": "prework_follow"
      },
      {
        "name": "following work continues into final answer",
        "initial": "prework_follow",
        "events": [
          {
            "type": "latest_turn_phase_changed",
            "previousLatestTurnPhase": "prework",
            "latestTurnPhase": "final_answer"
          }
        ],
        "expected": "user_follow"
      },
      {
        "name": "unfollowed work keeps final answer in place",
        "initial": "prework_watch",
        "events": [
          {
            "type": "latest_turn_phase_changed",
            "previousLatestTurnPhase": "prework",
            "latestTurnPhase": "final_answer"
          }
        ],
        "expected": "static"
      },
      {
        "name": "reading older final output stops following",
        "initial": "user_follow",
        "events": [
          {
            "type": "scroll_distance_changed",
            "distanceFromBottomPx": 25,
            "latestTurnPhase": "final_answer"
          }
        ],
        "expected": "static"
      },
      {
        "name": "reading older work watches for overflow",
        "initial": "prework_follow",
        "events": [
          {
            "type": "scroll_distance_changed",
            "distanceFromBottomPx": 25,
            "latestTurnPhase": "prework"
          }
        ],
        "expected": "prework_watch"
      },
      {
        "name": "latest control explicitly follows",
        "initial": "static",
        "events": [
          {
            "type": "scroll_to_bottom"
          }
        ],
        "expected": "user_follow"
      },
      {
        "name": "navigation preserves viewport",
        "initial": "prework_follow",
        "events": [
          {
            "type": "hold_viewport"
          }
        ],
        "expected": "static"
      }
    ]
  }
}
