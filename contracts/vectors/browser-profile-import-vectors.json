{
  "version": 1,
  "reason": "Profile source discovery, snapshots, decryption and target mutation belong to the native Profile. The host owns job authorization and awaits acknowledged cancellation without receiving cookie or password values. Discover eligible profile directories independently of optional index display metadata; retain index access diagnostics and source directory permission boundaries. Confirm retained history visits individually and select the account password database only when the primary database is absent.",
  "sourceReader": "native-sequenced-worker",
  "discoverySource": "profile-directories",
  "indexRole": "optional-display-metadata",
  "indexFailureBlocksDirectoryImport": false,
  "nonProfileDirectories": ["CertificateRevocation", "GraphiteDawnCache", "Crashpad", "System Profile", "ShaderCache", "GrShaderCache", "Safe Browsing", "Guest Profile", "login-staging-owned"],
  "targetWriter": "native-profile-stores",
  "receiptContainsSecrets": false,
  "confirmedBatchSize": 250,
  "syntheticCounts": {"cookies": 2, "passwords": 1, "history": 601, "extensions": 1},
  "cancelledHistoryPrefix": 250,
  "mockSourceMissingCode": "test_source_required",
  "symlinkSidecarCode": "database_symlink_rejected",
  "snapshotFailureCode": "database_snapshot_failed",
  "unsupportedHistorySchemaCode": "history_schema_unsupported",
  "malformedIndexCode": "local_state_invalid",
  "historyAttribution": "other",
  "historyRetentionPolicy": "native-backend",
  "historyUrlSchemes": ["http", "https"],
  "expiredHistoryRows": "skip-without-blocking-later-rows",
  "historyAcknowledgement": ["processed", "applied", "skippedExpired", "confirmedIndices"],
  "historyProjection": "confirmed-indices-only",
  "historyDuplicateVisits": "idempotent",
  "boundedHistorySelection": "newest-then-chronological",
  "passwordDatabaseSelection": ["Login Data", "Login Data For Account"],
  "passwordAccountFallback": "primary-missing-only",
  "passwordUrlSchemes": ["http", "https"],
  "snapshotIncludes": ["database", "wal", "shm"],
  "snapshotStability": ["existence", "size", "mtime"],
  "requiresExtensionConfirmation": true,
  "realProfileAcceptanceRequiresSystemAccess": true
