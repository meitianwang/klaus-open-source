{
  "reason": "The follow-up queue bar projects the engine-owned durable next-turn queue through the desktop adapter. The host republishes complete engine snapshots after metadata mutations and atomic admission, so the renderer installs each push outright and keeps no parallel list. Three properties are load-bearing and are pinned here: a later revision replaces the cached rows; an out-of-order older push is rejected outright rather than merged, so it cannot resurrect a row the user already deleted or undo a reorder they already made; and a row that lost its identity or payload is dropped instead of being drawn half-empty, because such a row cannot be edited, reordered or sent. Dropped means neither text NOR inline media survived: an image-only message has empty text by construction and is still a complete sendable turn, so requiring text there would silently eat exactly that message. The `interrupted` flag comes from the host rather than being re-derived from a pause-reason string the renderer must not know. Execution claims belong to the conversation: at most one row is dispatching in a conversation, including across store instances, while other conversations can claim independently. A busy manual request succeeds as still queued and returns the authoritative snapshot without issuing another admission RPC or removing the row. Commit or safe release permits the next claim; a released head retains its order. Unknown delivery remains saved and paused and is never retried automatically.",
  "executionClaims": {
    "scope": "conversation",
    "maxDispatchingRowsPerConversation": 1,
    "sharedAcrossStoreInstances": true,
    "otherConversationsBlocked": false,
    "busyManualReply": { "ok": true, "queued": true, "snapshot": "authoritative" },
    "busyManualAdmissionRpcCount": 0,
    "busyManualRemovesRow": false,
    "releaseRetainsHeadOrder": true,
    "automaticallyRetryUnknownDelivery": false
  },
  "vectors": [
    {
      "name": "a queued message arrives as one row with its stored payload",
      "event": {
        "type": "client_queue_snapshot",
        "sessionId": "conversation",
        "revision": 1,
        "interrupted": false,
        "items": [
          {
            "id": "queued-one",
            "createdAt": 1700000000000,
            "item": {
              "id": "queued-one",
              "displayText": "Check the final tool output",
              "finalText": "Check the final tool output",
              "media": [],
              "liveAttachments": []
            }
          }
        ]
      },
      "expect": {
        "revision": 1,
        "interrupted": false,
        "rows": [
          { "id": "queued-one", "pausedReason": null, "dispatching": false, "createdAt": 1700000000000, "preview": "Check the final tool output" }
        ]
      }
    },
    {
