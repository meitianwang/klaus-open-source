+ElectronMetricsServicesManagerClient::GetURLLoaderFactory() {
+  return g_browser_process->shared_url_loader_factory();
+}
+
+const metrics::EnabledStateProvider&
+ElectronMetricsServicesManagerClient::GetEnabledStateProvider() {
+  return *this;
+}
+
+bool ElectronMetricsServicesManagerClient::IsOffTheRecordSessionActive() {
+  for (auto* context : ElectronBrowserContext::BrowserContexts()) {
+    if (context->IsOffTheRecord())
+      return true;
+  }
+  if (auto* manager = g_browser_process->profile_manager()) {
+    for (auto* profile : manager->GetLoadedProfiles()) {
+      if (profile->IsOffTheRecord() || profile->HasAnyOffTheRecordProfile())
+        return true;
+    }
+  }
+  return false;
+}
+
+bool ElectronMetricsServicesManagerClient::IsConsentGiven() const {
+  // Preserve the existing embedder consent policy for both UMA and UKM.
   return false;
 }
 
