+// static
+bool ChromeDownloadManagerDelegate::SetTargetAuthorizer(
+    Profile* profile,
+    TargetAuthorizer* authorizer) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!profile || !authorizer)
+    return false;
+  auto [found, inserted] = GetTargetAuthorizers().try_emplace(profile, authorizer);
+  if (!inserted && found->second != authorizer)
+    return false;
+  found->second = authorizer;
+  return true;
+}
+
+// static
+void ChromeDownloadManagerDelegate::ClearTargetAuthorizer(
+    Profile* profile,
+    TargetAuthorizer* authorizer) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto found = GetTargetAuthorizers().find(profile);
+  if (found != GetTargetAuthorizers().end() && found->second == authorizer)
+    GetTargetAuthorizers().erase(found);
+}
+
+// static
+ChromeDownloadManagerDelegate::TargetAuthorizer*
+ChromeDownloadManagerDelegate::GetTargetAuthorizer(Profile* profile) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto found = GetTargetAuthorizers().find(profile);
+  return found == GetTargetAuthorizers().end() ? nullptr : found->second;
+}
