+void ChromeDownloadManagerDelegate::ContinueDownloadTargetDetermination(
+    uint32_t download_id,
+    const base::FilePath& fallback_path,
+    DownloadPathReservationTracker::FilenameConflictAction action,
+    base::OnceCallback<void(download::DownloadTargetInfo target_info,
+                            safe_browsing::DownloadFileType::DangerLevel
+                                danger_level)> callback,
+    TargetAuthorizer::Decision decision) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  DownloadItem* download =
+      download_manager_ ? download_manager_->GetDownload(download_id) : nullptr;
+
+  // A host-approved download must carry an absolute, non-empty target. Do not
+  // silently fall back to a default path: that would let bytes land somewhere
+  // the host did not authorize.
+  if (!download || !decision.allow || decision.path.empty() ||
+      !decision.path.IsAbsolute()) {
+    auto info = download::DownloadTargetInfo();
+    info.interrupt_reason = download::DOWNLOAD_INTERRUPT_REASON_USER_CANCELED;
+    std::move(callback).Run(std::move(info),
+                            safe_browsing::DownloadFileType::NOT_DANGEROUS);
+    return;
+  }
+
+  const base::FilePath path = decision.path;
+  host_target_paths_[download_id] = path;
+  DownloadTargetDeterminer::Start(download, path, action, download_prefs_.get(),
+                                  this, std::move(callback));
+}
