+      result.Set("path", target.AsUTF8Unsafe());
+    result.Set("state", StateString(item->GetState(), item->IsPaused()));
+    result.Set("receivedBytes", static_cast<double>(item->GetReceivedBytes()));
+    result.Set("totalBytes", static_cast<double>(item->GetTotalBytes()));
+    result.Set("startedAt", static_cast<double>(
+                                item->GetStartTime().InMillisecondsSinceUnixEpoch()));
+    result.Set("canPause", item->GetState() ==
+                                download::DownloadItem::IN_PROGRESS &&
+                                !item->IsPaused());
+    result.Set("canResume", item->CanResume());
+    result.Set("canCancel",
+               item->GetState() == download::DownloadItem::IN_PROGRESS ||
+                   item->GetState() == download::DownloadItem::INTERRUPTED);
+    ApplyMetadata(&result, item->GetGuid());
+    return result;
