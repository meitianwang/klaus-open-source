+    if (found == pending_targets_.end())
+      return;
+    auto callback = std::move(found->second.callback);
+    pending_targets_.erase(found);
+    TargetAuthorizer::Decision decision;
+    decision.allow = allow;
+    decision.path = path;
+    std::move(callback).Run(std::move(decision));
+  }
