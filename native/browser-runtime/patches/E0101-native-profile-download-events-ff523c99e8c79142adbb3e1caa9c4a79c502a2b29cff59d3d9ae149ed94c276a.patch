+#include "shell/browser/api/native_browser_download_metadata.h"
+
+#include <memory>
+
+#include "content/public/browser/web_contents.h"
+
+namespace electron::api {
+
+const char NativePageDownloadMetadata::kUserDataKey[] =
+    "NativePageDownloadMetadata";
+
+void SetNativePageDownloadMetadata(
+    content::WebContents* contents,
+    const NativePageDownloadMetadata& metadata) {
+  if (!contents)
+    return;
+  contents->SetUserData(
+      NativePageDownloadMetadata::kUserDataKey,
+      std::make_unique<NativePageDownloadMetadata>(metadata));
+}
+
+NativePageDownloadMetadata* GetNativePageDownloadMetadata(
+    content::WebContents* contents) {
+  if (!contents)
+    return nullptr;
+  return static_cast<NativePageDownloadMetadata*>(
+      contents->GetUserData(NativePageDownloadMetadata::kUserDataKey));
+}
+
+}  // namespace electron::api
