+  void ResolvePendingTarget(const std::string& guid, bool allow) {
+    std::vector<PendingTarget> matched;
+    for (auto it = pending_targets_.begin(); it != pending_targets_.end();) {
+      if (it->second.guid == guid) {
+        matched.push_back(std::move(it->second));
+        it = pending_targets_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    if (!matched.empty()) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+              [](std::vector<PendingTarget> matched, bool allow) {
+                for (auto& pending : matched) {
+                  TargetAuthorizer::Decision decision;
+                  decision.allow = allow;
+                  std::move(pending.callback).Run(std::move(decision));
+                }
