+    base::ListValue chain;
+    for (const auto& url : item->GetUrlChain())
+      chain.Append(url.spec());
+    result.Set("urlChain", std::move(chain));
+    result.Set("filename", DownloadName(item));
+    result.Set("suggestedPath", suggested_path.AsUTF8Unsafe());
+    ApplyMetadata(&result, item->GetGuid());
+    return result;
+  }
