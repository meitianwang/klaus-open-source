+struct NativePageDownloadMetadata : public base::SupportsUserData::Data {
+  static const char kUserDataKey[];
+
+  std::string session_id;
+  std::string page_id;
+  bool is_actor_visit = false;
+  bool requires_authorization = false;
+};
+
+void SetNativePageDownloadMetadata(
+    content::WebContents* contents,
+    const NativePageDownloadMetadata& metadata);
+NativePageDownloadMetadata* GetNativePageDownloadMetadata(
+    content::WebContents* contents);
