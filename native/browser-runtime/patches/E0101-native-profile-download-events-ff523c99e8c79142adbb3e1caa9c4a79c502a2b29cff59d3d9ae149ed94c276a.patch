+    if (paused && state == download::DownloadItem::IN_PROGRESS)
+      return "paused";
+    switch (state) {
+      case download::DownloadItem::IN_PROGRESS:
+        return "in_progress";
+      case download::DownloadItem::COMPLETE:
+        return "completed";
+      case download::DownloadItem::CANCELLED:
+        return "canceled";
+      case download::DownloadItem::INTERRUPTED:
+        return "failed";
+      default:
+        return "failed";
+    }
+  }
