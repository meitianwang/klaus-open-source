+scoped_refptr<ContentRulesRegistry>
+ElectronExtensionsAPIClient::CreateContentRulesRegistry(
+    content::BrowserContext* browser_context,
+    RulesCacheDelegate* cache_delegate) const {
+  if (browser_context && browser_context->IsBrowserProfile()) {
+    return ChromeExtensionsAPIClient::CreateProfileContentRulesRegistry(
+        browser_context, cache_delegate);
+  }
+  return ExtensionsAPIClient::CreateContentRulesRegistry(browser_context,
+                                                        cache_delegate);
