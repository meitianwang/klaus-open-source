+std::string NativeManagementUrl(const std::string& surface,
+                                gin::Arguments* args) {
+  if (surface == "passwords")
+    return "chrome://password-manager/passwords";
+  if (surface == "autofill") {
+    return base::FeatureList::IsEnabled(
+               autofill::features::kYourSavedInfoSettingsPage)
+               ? "chrome://settings/contactInfo"
+               : "chrome://settings/addresses";
+  }
+  if (surface == "extensions")
+    return "chrome://extensions/";
+  if (surface == "siteSettings")
+    return "chrome://settings/content";
+  args->ThrowTypeError("Unknown native browser management surface");
+  return {};
+}
