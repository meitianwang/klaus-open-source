+void ElectronBrowserClient::InitializeProfileBrowserClient() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (chrome_profile_client_)
+    return;
+  chrome_profile_client_ = std::make_unique<ChromeContentBrowserClient>();
+  chrome_profile_client_->InitializeForEmbedding();
+}
+
+ChromeContentBrowserClient* ElectronBrowserClient::GetProfileBrowserClient(
+    content::BrowserContext* browser_context) const {
+  if (!browser_context || !browser_context->IsBrowserProfile())
+    return nullptr;
+  CHECK(chrome_profile_client_);
+  return chrome_profile_client_.get();
+}
