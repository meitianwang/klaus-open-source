+// Copyright (c) 2026 Electron contributors.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/navigator/native_popup_source.h"
+
+#include <utility>
+
+#include "content/public/browser/web_contents.h"
+
+namespace chrome {
+
+NativePopupSource::NativePopupSource(content::WebContents& source)
+    : content::WebContentsUserData<NativePopupSource>(source) {}
+
+// static
+void NativePopupSource::Set(content::WebContents* source, Callback callback) {
+  if (!source)
+    return;
+  if (auto* existing = FromWebContents(source)) {
+    existing->callback_ = std::move(callback);
+    return;
+  }
+  if (!callback)
+    return;
+  CreateForWebContents(source);
+  if (auto* created = FromWebContents(source))
+    created->callback_ = std::move(callback);
+}
+
+// static
+void NativePopupSource::MaybeNotify(content::WebContents* source,
+                                    content::WebContents* child,
+                                    const GURL& url,
+                                    WindowOpenDisposition disposition) {
+  if (!source || !child || source == child)
+    return;
+  auto* tracker = FromWebContents(source);
+  if (tracker && tracker->callback_)
+    tracker->callback_.Run(child, url, disposition);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NativePopupSource)
+
+}  // namespace chrome
