diff --git a/shell/app/electron_main_delegate.cc b/shell/app/electron_main_delegate.cc
--- a/shell/app/electron_main_delegate.cc
+++ b/shell/app/electron_main_delegate.cc
@@ -181,6 +181,19 @@
 std::optional<int> ElectronMainDelegate::BasicStartupComplete() {
   auto* command_line = base::CommandLine::ForCurrentProcess();

+  if (command_line->HasSwitch("native-profile-probe") &&
+      (!command_line->HasSwitch("use-mock-keychain") ||
+       !command_line->GetSwitchValuePath(::switches::kUserDataDir)
+            .IsAbsolute() ||
+       !command_line->GetSwitchValuePath("native-profile-probe-data-dir")
+            .IsAbsolute() ||
+       !command_line->GetSwitchValuePath("native-profile-probe-output")
+            .IsAbsolute())) {
+    LOG(ERROR) << "Native profile probe requires mock Keychain and absolute "
+                  "application, profile and output paths.";
+    return 2;
+  }
+
 #if BUILDFLAG(IS_WIN)
   v8_crashpad_support::SetUp();

