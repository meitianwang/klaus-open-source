+base::FilePath ResolvePasswordDatabase(const base::FilePath& profile) {
+  const base::FilePath primary = profile.Append(FILE_PATH_LITERAL("Login Data"));
+  if (base::IsLink(primary))
+    return primary;
+  base::File::Info info;
+  if (base::GetFileInfo(primary, &info) ||
+      base::File::GetLastFileError() != base::File::FILE_ERROR_NOT_FOUND) {
+    return primary;
+  }
+  return profile.Append(FILE_PATH_LITERAL("Login Data For Account"));
+}
