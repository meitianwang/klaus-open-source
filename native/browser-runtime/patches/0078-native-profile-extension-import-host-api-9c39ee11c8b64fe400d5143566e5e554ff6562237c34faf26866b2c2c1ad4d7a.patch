+  v8::Local<v8::Promise> LoadExtension(v8::Isolate* isolate,
+                                      const base::FilePath& directory) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    if (IsClosed()) {
+      promise.RejectWithErrorMessage("Native browser has been closed");
+      return handle;
+    }
+    if (!directory.IsAbsolute() || directory.ReferencesParent()) {
+      promise.RejectWithErrorMessage(
+          "A selected absolute extension directory is required");
+      return handle;
+    }
+    Profile* profile = browser_->GetProfile();
+    if (supervised_user::AreExtensionsPermissionsEnabled(profile)) {
+      promise.RejectWithErrorMessage(
+          "Child account users cannot load unpacked extensions");
+      return handle;
+    }
+    if (!profile->GetPrefs()->GetBoolean(prefs::kExtensionsUIDeveloperMode)) {
+      promise.RejectWithErrorMessage(
+          "Developer mode must be enabled to load unpacked extensions");
+      return handle;
+    }
+    if (extensions::ExtensionManagementFactory::GetForBrowserContext(profile)
+            ->BlocklistedByDefault()) {
+      promise.RejectWithErrorMessage(
+          "Extension installation is blocked by policy");
+      return handle;
+    }
+
+    // This main-process entry consumes a directory selected by the host import
+    // flow. Native installer policy, manifest validation, registration and
+    // worker startup remain authoritative; no page bridge is exposed.
+    auto installer = extensions::UnpackedInstaller::Create(profile);
+    installer->set_be_noisy_on_failure(false);
+    installer->set_completion_callback(base::BindOnce(
+        [](gin_helper::Promise<base::DictValue> promise,
+           const extensions::Extension* extension, const base::FilePath& path,
+           const std::u16string& error) {
+          if (!extension) {
+            promise.RejectWithErrorMessage(base::UTF16ToUTF8(error));
+            return;
+          }
+          base::DictValue result;
+          result.Set("id", extension->id());
+          result.Set("name", extension->name());
+          result.Set("version", extension->version().GetString());
+          result.Set("path", path.AsUTF8Unsafe());
+          promise.Resolve(result);
+        },
+        std::move(promise)));
+    installer->Load(directory);
+    return handle;
+  }
