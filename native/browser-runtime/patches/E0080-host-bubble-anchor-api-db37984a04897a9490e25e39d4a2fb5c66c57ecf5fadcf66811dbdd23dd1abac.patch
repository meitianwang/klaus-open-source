+  void SetBubbleAnchor(const gfx::Rect& bounds, gin::Arguments* args) {
+    if (IsClosed()) {
+      gin_helper::ErrorThrower(args->isolate()).ThrowError(
+          "Native browser has been closed");
+      return;
+    }
+    if (bounds.IsEmpty()) {
+      args->ThrowTypeError("anchor must have a positive size");
+      return;
+    }
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    gfx::Rect anchor = HostBoundsToScreen(parent_, bounds);
+    views::View::ConvertRectFromScreen(view, &anchor);
+    view->SetHostContentAnchorRect(anchor);
+  }
+  gfx::Rect GetBubbleAnchor() const {
+    if (IsClosed())
+      return gfx::Rect();
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    auto* anchor_view = view->host_content_anchor_view();
+    if (!anchor_view)
+      return gfx::Rect();
+    gfx::Rect anchor = anchor_view->GetAnchorBoundsInScreen();
+    views::View::ConvertRectFromScreen(parent_->GetContentsView(), &anchor);
+    return anchor;
+  }
