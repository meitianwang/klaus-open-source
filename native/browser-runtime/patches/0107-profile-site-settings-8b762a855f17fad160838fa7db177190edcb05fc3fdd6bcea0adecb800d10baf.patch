diff --git a/shell/browser/api/native_browser_site_settings.cc b/shell/browser/api/native_browser_site_settings.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e589002ccb03a63f0f3126d02274c2036ea16b3e
--- /dev/null
+++ b/shell/browser/api/native_browser_site_settings.cc
@@ -0,0 +1,161 @@
+// Copyright (c) 2026 Electron contributors.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#include "shell/browser/api/native_browser_site_settings.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "components/content_settings/core/browser/content_settings_info.h"
+#include "components/content_settings/core/browser/content_settings_registry.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "gin/converter.h"
+#include "services/network/public/cpp/is_potentially_trustworthy.h"
+#include "shell/common/gin_converters/value_converter.h"
+#include "shell/common/gin_helper/error_thrower.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+namespace electron::api {
+namespace {
+
+constexpr std::string_view kUnsupported =
+    " has no persistent Chromium site-permission mapping";
+
+std::optional<ContentSettingsType> ContentTypeForName(std::string_view name) {
+  if (name == "geolocation")
+    return ContentSettingsType::GEOLOCATION;
+  if (name == "notifications")
+    return ContentSettingsType::NOTIFICATIONS;
+  if ((name == "camera" || name == "videoCapture"))
+    return ContentSettingsType::MEDIASTREAM_CAMERA;
+  if ((name == "microphone" || name == "audioCapture"))
+    return ContentSettingsType::MEDIASTREAM_MIC;
+  if (name == "clipboard-read")
+    return ContentSettingsType::CLIPBOARD_READ_WRITE;
+  if (name == "pointerLock")
+    return ContentSettingsType::POINTER_LOCK;
+  // fullscreen, clipboard-write, midi and screen-wake-lock have no equivalent
+  // persistent user ContentSetting in this Chrome level.
+  return std::nullopt;
+}
+
+std::optional<GURL> ParseOrigin(std::string_view text) {
+  GURL url(text);
+  url::Origin origin = url::Origin::Create(url);
+  if (origin.opaque() || !origin.GetURL().SchemeIsHTTPOrHTTPS())
+    return std::nullopt;
+  return origin.GetURL();
+}
+
+const char* NameForSetting(ContentSetting setting) {
+  if (setting == CONTENT_SETTING_ALLOW)
+    return "granted";
+  if (setting == CONTENT_SETTING_BLOCK)
+    return "denied";
+  return "prompt";
+}
+
+}  // namespace
+NativeBrowserSiteSettings::NativeBrowserSiteSettings(Profile* profile)
+    : profile_(profile) {}
+NativeBrowserSiteSettings::~NativeBrowserSiteSettings() = default;
+v8::Local<v8::Value> NativeBrowserSiteSettings::Set(
+    v8::Isolate* isolate,
+    const std::string& origin,
+    const std::string& name,
+    const std::string& setting) const {
+  gin_helper::ErrorThrower thrower(isolate);
+  auto content_type = ContentTypeForName(name);
+  if (!content_type) {
+    thrower.ThrowError("Site permission " + name + std::string(kUnsupported));
+    return v8::Undefined(isolate);
+  }
+  auto origin_url = ParseOrigin(origin);
+  if (!origin_url) {
+    thrower.ThrowTypeError("Site permission origin must be an HTTP(S) origin");
+    return v8::Undefined(isolate);
+  }
+  ContentSetting value = CONTENT_SETTING_DEFAULT;
+  if (setting == "granted") {
+    value = CONTENT_SETTING_ALLOW;
+  } else if (setting == "denied") {
+    value = CONTENT_SETTING_BLOCK;
+  } else if (setting != "prompt") {
+    thrower.ThrowTypeError(
+        "Site permission setting must be granted, denied or prompt");
+    return v8::Undefined(isolate);
+  }
+
+  auto* info = content_settings::ContentSettingsRegistry::GetInstance()->Get(
+      *content_type);
+  if (!info) {
+    thrower.ThrowError("Site permission " + name + std::string(kUnsupported));
+    return v8::Undefined(isolate);
+  }
+  if (value != CONTENT_SETTING_DEFAULT && !info->IsSettingValid(value)) {
+    thrower.ThrowError("Site permission setting is invalid for " + name);
+    return v8::Undefined(isolate);
+  }
+  if (info->permission_settings_info()->origin_restriction() ==
+          content_settings::PermissionSettingsInfo::OriginRestriction::
+              EXCEPTIONS_ON_SECURE_ORIGINS_ONLY &&
+      value == CONTENT_SETTING_ALLOW &&
+      !network::IsUrlPotentiallyTrustworthy(*origin_url)) {
+    thrower.ThrowError("Site permission " + name +
+                       " requires a secure origin");
+    return v8::Undefined(isolate);
+  }
+
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile_);
+  if (!map) {
+    thrower.ThrowError("The native Profile has no content settings map");
+    return v8::Undefined(isolate);
+  }
+  // CONTENT_SETTING_DEFAULT removes the origin exception. The provider chain
+  // keeps managed policy authoritative; the map's observers refresh permission
+  // subscriptions without a task-scoped override.
+  map->SetContentSettingDefaultScope(*origin_url, *origin_url, *content_type,
+                                     value);
+  base::DictValue result;
+  result.Set("ok", true);
+  return gin::ConvertToV8(isolate, result);
+}
+
+v8::Local<v8::Value> NativeBrowserSiteSettings::Get(
+    v8::Isolate* isolate,
+    const std::string& origin,
+    const std::string& name) const {
+  gin_helper::ErrorThrower thrower(isolate);
+  auto content_type = ContentTypeForName(name);
+  if (!content_type ||
+      !content_settings::ContentSettingsRegistry::GetInstance()->Get(
+          *content_type)) {
+    thrower.ThrowError("Site permission " + name + std::string(kUnsupported));
+    return v8::Undefined(isolate);
+  }
+  auto origin_url = ParseOrigin(origin);
+  if (!origin_url) {
+    thrower.ThrowTypeError("Site permission origin must be an HTTP(S) origin");
+    return v8::Undefined(isolate);
+  }
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile_);
+  if (!map) {
+    thrower.ThrowError("The native Profile has no content settings map");
+    return v8::Undefined(isolate);
+  }
+  base::DictValue result;
+  result.Set("origin", origin_url->spec());
+  result.Set("permission", name);
+  result.Set("setting", NameForSetting(map->GetContentSetting(
+                             *origin_url, *origin_url, *content_type)));
+  return gin::ConvertToV8(isolate, result);
+}
+
+}  // namespace electron::api
