+#ifndef ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SITE_SETTINGS_H_
+#define ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SITE_SETTINGS_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "v8/include/v8.h"
+
+class Profile;
+namespace electron::api {
+
+// Persists supported site permissions in the Profile's one content-settings ledger.
+class NativeBrowserSiteSettings final {
+ public:
+  explicit NativeBrowserSiteSettings(Profile* profile);
+  ~NativeBrowserSiteSettings();
+
+  NativeBrowserSiteSettings(const NativeBrowserSiteSettings&) = delete;
+  NativeBrowserSiteSettings& operator=(const NativeBrowserSiteSettings&) =
+      delete;
+
+  v8::Local<v8::Value> Set(v8::Isolate* isolate,
+                           const std::string& origin,
+                           const std::string& name,
+                           const std::string& setting) const;
+  v8::Local<v8::Value> Get(v8::Isolate* isolate,
+                           const std::string& origin,
+                           const std::string& name) const;
+
+ private:
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace electron::api
+
+#endif  // ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SITE_SETTINGS_H_
