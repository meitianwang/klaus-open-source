+// V8 finalizers must not execute JavaScript. Move pending work to a normal UI
+// task so its callers still receive a terminal rejection after wrapper GC.
+void DeferNativeRejections(
+    std::unique_ptr<gin_helper::Promise<base::DictValue>> first,
+    std::unique_ptr<gin_helper::Promise<base::DictValue>> second,
+    std::map<std::string, std::unique_ptr<NativeProfileRequest>> requests) {
+  if (!first && !second && requests.empty())
+    return;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](std::unique_ptr<gin_helper::Promise<base::DictValue>> first,
+             std::unique_ptr<gin_helper::Promise<base::DictValue>> second,
+             std::map<std::string, std::unique_ptr<NativeProfileRequest>> requests) {
+            if (first)
+              first->RejectWithErrorMessage("The native browser wrapper was released");
+            if (second)
+              second->RejectWithErrorMessage("The native browser wrapper was released");
+            for (auto& [id, request] : requests)
+              request->Cancel();
+          }, std::move(first), std::move(second), std::move(requests)));
+}
