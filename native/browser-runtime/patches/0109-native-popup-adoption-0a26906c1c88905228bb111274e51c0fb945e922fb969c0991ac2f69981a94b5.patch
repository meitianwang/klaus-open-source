+  void OnPopupCreated(base::WeakPtr<NativePopupGate> gate) {
+    if (!gate || gate->cancelled() || !gate->contents() || !gate->Claim())
+      return;
+    content::WebContents* child_contents = gate->contents();
+    auto* old_browser =
+        GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+            child_contents);
+    if (!old_browser) {
+      gate->Cancel();
+      return;
+    }
+    auto* old_tabs = old_browser->GetTabStripModel();
+    const int index = old_tabs->GetIndexOfWebContents(child_contents);
+    if (index == TabStripModel::kNoTab) {
+      gate->Cancel();
+      return;
+    }
+    std::unique_ptr<content::WebContents> adopted =
+        old_tabs->DetachWebContentsAtForInsertion(index);
+    if (!adopted) {
+      gate->Cancel();
+      return;
+    }
+    if (old_browser != browser_ && old_tabs->count() == 0)
+      old_browser->GetWindow()->Close();
+    if (!parent_ || parent_->IsClosed()) {
+      gate->Cancel();
+      return;
