new file mode 100644
index 0000000000000000000000000000000000000000..495ee2134172c09064d27523632d8d11d36e7c0e
--- /dev/null
+++ b/shell/browser/api/native_popup_gate.cc
@@ -0,0 +1,145 @@
+#include "shell/browser/api/native_popup_gate.h"
+
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace electron::api {
+namespace {
+constexpr auto kPopupGateTimeout = base::Seconds(15);
+}
+
+NativePopupNavigationThrottle::NativePopupNavigationThrottle(
+    content::NavigationThrottleRegistry& registry,
+    base::WeakPtr<NativePopupGate> gate)
+    : content::NavigationThrottle(registry), gate_(std::move(gate)) {}
+
+NativePopupNavigationThrottle::~NativePopupNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+NativePopupNavigationThrottle::WillStartRequest() {
+  auto gate = gate_;
+  if (!gate || gate->cancelled())
+    return CANCEL;
+  if (!gate->pending())
+    return PROCEED;
+  deferred_ = true;
+  gate->SetThrottle(weak_factory_.GetWeakPtr());
+  return DEFER;
+}
+
+const char* NativePopupNavigationThrottle::GetNameForLogging() {
+  return "NativePopupNavigationThrottle";
+}
+
+void NativePopupNavigationThrottle::ResumeNavigation() {
+  if (!deferred_)
+    return;
+  deferred_ = false;
+  Resume();
+}
+
+void NativePopupNavigationThrottle::CancelNavigation() {
+  if (!deferred_)
+    return;
+  deferred_ = false;
+  CancelDeferredNavigation(CANCEL);
+}
+
+NativePopupGate::NativePopupGate(content::WebContents& contents,
+                                 NativePopupInfo info)
+    : content::WebContentsUserData<NativePopupGate>(contents),
+      contents_(&contents),
+      info_(std::move(info)) {
+  StartDeadline();
+}
+
+NativePopupGate::~NativePopupGate() {
+  deadline_.Stop();
+}
+
+NativePopupGate* NativePopupGate::CreateForWebContents(
+    content::WebContents* contents,
+    NativePopupInfo info) {
+  if (!contents)
+    return nullptr;
+  if (auto* existing = FromWebContents(contents))
+    return existing;
+  contents->SetUserData(
+      UserDataKey(),
+      base::WrapUnique(new NativePopupGate(*contents, std::move(info))));
+  return FromWebContents(contents);
+}
+
+NativePopupGate* NativePopupGate::FromWebContents(
+    content::WebContents* contents) {
+  return contents ? content::WebContentsUserData<NativePopupGate>::FromWebContents(contents)
+                  : nullptr;
+}
+
+void NativePopupGate::AddThrottleIfPending(
+    content::NavigationThrottleRegistry& registry) {
+  auto* contents = registry.GetNavigationHandle().GetWebContents();
+  auto* gate = FromWebContents(contents);
+  if (!gate || !gate->pending())
+    return;
+  registry.AddThrottle(std::make_unique<NativePopupNavigationThrottle>(
+      registry, gate->GetWeakPtr()));
+}
+
+void NativePopupGate::SetThrottle(
+    base::WeakPtr<NativePopupNavigationThrottle> throttle) {
+  throttle_ = std::move(throttle);
+}
+
+void NativePopupGate::SetCancelledCallback(base::OnceClosure callback) {
+  cancelled_callback_ = std::move(callback);
+}
+
+bool NativePopupGate::Claim() {
+  if (claimed_)
+    return false;
+  claimed_ = true;
+  return true;
+}
+
+void NativePopupGate::Resume() {
+  if (state_ != State::kPending)
+    return;
+  state_ = State::kAllowed;
+  deadline_.Stop();
+  auto throttle = std::move(throttle_);
+  if (throttle)
+    throttle->ResumeNavigation();
+}
+
+void NativePopupGate::Cancel() {
+  if (state_ != State::kPending)
+    return;
+  state_ = State::kCancelled;
+  deadline_.Stop();
+  auto throttle = std::move(throttle_);
+  auto callback = std::move(cancelled_callback_);
+  auto* contents = contents_;
+  if (callback) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(callback));
+  }
+  if (throttle)
+    throttle->CancelNavigation();
+  else if (contents && !contents->IsBeingDestroyed())
+    contents->Stop();
+}
+
+void NativePopupGate::StartDeadline() {
+  deadline_.Start(FROM_HERE, kPopupGateTimeout,
+                  base::BindOnce(&NativePopupGate::Cancel, GetWeakPtr()));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NativePopupGate)
+
+}  // namespace electron::api
