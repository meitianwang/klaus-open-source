+    NativePopupInfo info;
+    info.url = url;
+    info.disposition = disposition;
+    if (auto* metadata = GetNativePageDownloadMetadata(web_contents())) {
+      info.session_id = metadata->session_id;
+      info.page_id = metadata->page_id;
+      info.is_actor_visit = metadata->is_actor_visit;
+      info.requires_authorization = metadata->requires_authorization;
+      SetNativePageDownloadMetadata(child, *metadata);
+    }
+    auto* gate =
+        NativePopupGate::CreateForWebContents(child, std::move(info));
+    if (!gate)
+      return;
+    popup_gates_.push_back(gate->GetWeakPtr());
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&NativeBrowser::OnPopupCreated,
+                                  weak_factory_.GetWeakPtr(),
+                                  gate->GetWeakPtr()));
+  }
