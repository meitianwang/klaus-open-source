+#ifndef SHELL_BROWSER_API_NATIVE_POPUP_GATE_H_
+#define SHELL_BROWSER_API_NATIVE_POPUP_GATE_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+class WebContents;
+}
+
+namespace electron::api {
+
+struct NativePopupInfo {
+  GURL url;
+  WindowOpenDisposition disposition = WindowOpenDisposition::UNKNOWN;
+  std::string session_id;
+  std::string page_id;
+  bool is_actor_visit = false;
+  bool requires_authorization = false;
+};
+
+class NativePopupGate;
+
+class NativePopupNavigationThrottle final
+    : public content::NavigationThrottle {
+ public:
+  NativePopupNavigationThrottle(content::NavigationThrottleRegistry& registry,
+                                base::WeakPtr<NativePopupGate> gate);
+  ~NativePopupNavigationThrottle() override;
+
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+
+  void ResumeNavigation();
+  void CancelNavigation();
+
+ private:
+  base::WeakPtr<NativePopupGate> gate_;
+  bool deferred_ = false;
+  base::WeakPtrFactory<NativePopupNavigationThrottle> weak_factory_{this};
+};
+
+class NativePopupGate final
+    : public content::WebContentsUserData<NativePopupGate> {
+ public:
+  static NativePopupGate* CreateForWebContents(content::WebContents* contents,
+                                               NativePopupInfo info);
+  static NativePopupGate* FromWebContents(content::WebContents* contents);
+  static void AddThrottleIfPending(
+      content::NavigationThrottleRegistry& registry);
+
+  void SetThrottle(base::WeakPtr<NativePopupNavigationThrottle> throttle);
+  void SetCancelledCallback(base::OnceClosure callback);
+  bool Claim();
+
+  void Resume();
+  void Cancel();
+
+  bool pending() const { return state_ == State::kPending; }
+  bool cancelled() const { return state_ == State::kCancelled; }
+  const NativePopupInfo& info() const { return info_; }
+  content::WebContents* contents() const { return contents_; }
+  base::WeakPtr<NativePopupGate> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  enum class State { kPending, kAllowed, kCancelled };
+  NativePopupGate(content::WebContents& contents, NativePopupInfo info);
+  ~NativePopupGate() override;
+
+  void StartDeadline();
+
+  raw_ptr<content::WebContents> contents_;
+  NativePopupInfo info_;
+  State state_ = State::kPending;
+  bool claimed_ = false;
+  base::WeakPtr<NativePopupNavigationThrottle> throttle_;
+  base::OnceClosure cancelled_callback_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<NativePopupGate> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace electron::api
+
+#endif  // SHELL_BROWSER_API_NATIVE_POPUP_GATE_H_
