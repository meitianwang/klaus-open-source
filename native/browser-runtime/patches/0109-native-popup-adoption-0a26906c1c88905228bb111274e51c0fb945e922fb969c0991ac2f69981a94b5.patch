+    info.Set("pageId", gate->info().page_id);
+    info.Set("isActorVisit", gate->info().is_actor_visit);
+    info.Set("requiresAuthorization", gate->info().requires_authorization);
+    Emit("popup-created", child->GetWrapper(), std::move(info));
+  }
