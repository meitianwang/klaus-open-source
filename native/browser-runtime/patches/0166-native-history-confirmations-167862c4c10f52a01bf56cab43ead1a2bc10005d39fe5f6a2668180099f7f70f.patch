+bool FindImportedHistoryVisit(history::HistoryDatabase* db,
+                              const history::URLRow& row,
+                              bool* found) {
+  *found = false;
+  history::URLRow stored;
+  const history::URLID url_id = db->GetRowForURL(row.url(), &stored);
+  if (!url_id)
+    return true;
+  history::VisitVector visits;
+  const base::Time times[] = {row.last_visit()};
+  if (!db->GetVisitsForTimes(times, &visits))
+    return false;
+  for (const history::VisitRow& visit : visits) {
+    if (visit.url_id == url_id && visit.visit_time == row.last_visit() &&
+        db->GetVisitSource(visit.visit_id) ==
+            history::SOURCE_OS_MIGRATION_IMPORTED) {
+      *found = true;
+      break;
+    }
+  }
+  return true;
+}
