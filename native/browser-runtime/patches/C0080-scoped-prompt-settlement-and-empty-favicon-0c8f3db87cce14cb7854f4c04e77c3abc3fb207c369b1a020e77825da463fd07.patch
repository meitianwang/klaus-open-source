+std::unique_ptr<permissions::PermissionRequest>
+PermissionRequestQueue::Extract(PermissionRequest* request) {
+  for (auto& request_list : queued_requests_) {
+    auto it = std::ranges::find_if(
+        request_list, [request](const auto& element) {
+          return element.get() == request;
+        });
+    if (it == request_list.end())
+      continue;
+    std::unique_ptr<permissions::PermissionRequest> result =
+        std::move(*it);
+    request_list.erase(it);
+    --size_;
+    return result;
+  }
+  return nullptr;
+}
