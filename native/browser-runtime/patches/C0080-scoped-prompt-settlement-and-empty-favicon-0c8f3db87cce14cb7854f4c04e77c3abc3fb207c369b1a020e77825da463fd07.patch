+bool PermissionRequestManager::SettleHostScopedRequest(
+    content::WebContents* web_contents,
+    const url::Origin& requesting_origin,
+    const url::Origin& embedding_origin,
+    ContentSettingsType type) {
+  if (!web_contents)
+    return false;
+
+  auto* scope = HostPermissionScope::FromWebContents(web_contents);
+  if (!scope)
+    return false;
+
+  const std::optional<HostPermissionScope::Setting> host_setting =
+      scope->Get(requesting_origin, embedding_origin, type);
+  if (!host_setting)
+    return false;
+
+  const bool allow = *host_setting == HostPermissionScope::Setting::kAllow;
+  const auto normalized_type = [](ContentSettingsType candidate) {
+    return candidate == ContentSettingsType::GEOLOCATION_WITH_OPTIONS
+               ? ContentSettingsType::GEOLOCATION
+               : candidate;
+  };
+
+  auto matches = [&](PermissionRequest* request) {
+    if (!request || normalized_type(request->GetContentSettingsType()) !=
+                       normalized_type(type)) {
+      return false;
+    }
+    if (request->requesting_origin() != requesting_origin.GetURL() ||
+        request->embedding_origin() != embedding_origin.GetURL()) {
+      return false;
+    }
+    const auto source =
+        request_sources_map_.find(base::raw_ref(*request));
+    if (source == request_sources_map_.end())
+      return false;
+    content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(
+        source->second.requesting_frame_id);
+    return rfh && content::WebContents::FromRenderFrameHost(rfh) == web_contents;
+  };
+
+  // IsDuplicateOf() only compares request type and requesting origin. Do not
+  // treat a duplicate from another embedding origin or source frame as the
+  // same task request. If a duplicate list contains such an entry, leave the
+  // whole settlement for native handling rather than settling a mixed list.
+  auto duplicates_match = [&](PermissionRequest* request) {
+    const auto duplicate_list = FindDuplicateRequestList(request);
+    if (duplicate_list == duplicate_requests_.end())
+      return true;
+    for (const auto& duplicate : *duplicate_list) {
+      if (!duplicate->IsDuplicateOf(request) ||
+          duplicate->embedding_origin() != request->embedding_origin() ||
+          duplicate->get_requesting_frame_id() !=
+              request->get_requesting_frame_id()) {
+        return false;
+      }
+    }
+    return true;
+  };
+
+  auto settle_one = [&](PermissionRequest* request) {
+    if (allow)
+      request->PermissionGrantedForHostScope();
+    else
+      request->PermissionDeniedForHostScope();
+
+    VisitDuplicateRequests(
+        base::BindRepeating(
+            [allow](const std::unique_ptr<PermissionRequest>& duplicate) {
+              if (allow)
+                duplicate->PermissionGrantedForHostScope();
+              else
+                duplicate->PermissionDeniedForHostScope();
+            }),
+        request);
+  };
+
+  std::vector<PermissionRequest*> active_matches;
+  for (const auto& request : requests_) {
+    if (matches(request.get()))
+      active_matches.push_back(request.get());
+  }
+
+  if (!active_matches.empty()) {
+    for (PermissionRequest* request : active_matches) {
+      if (!duplicates_match(request))
+        return false;
+    }
+
+    for (PermissionRequest* request : active_matches)
+      settle_one(request);
+
+    if (active_matches.size() == requests_.size()) {
+      // Use the established finalization path. It resets view state, stops the
+      // preignore timer, removes source/duplicate bookkeeping, clears the
+      // requests, notifies OnRequestsFinalized, and schedules the next dequeue.
+      // The settled callbacks are not invoked again by finalization.
+      FinalizeCurrentRequests();
+    } else {
+      // Preserve every non-matching request and its native prompt. Remove only
+      // the settled entries and rebuild the prompt for the remaining group.
+      for (PermissionRequest* request : active_matches) {
+        FinishRequestIncludingDuplicates(request);
+        request_sources_map_.erase(base::raw_ref(*request));
+        std::erase(validated_requests_, *request);
+      }
+      std::erase_if(requests_, [&](const std::unique_ptr<PermissionRequest>& request) {
+        return std::ranges::find(active_matches, request.get()) !=
+               active_matches.end();
+      });
+      RecreateView();
+    }
+    return true;
+  }
+
+  // Collect matching queued requests first so a duplicate mismatch cannot cause
+  // a partial settlement of a queue that should remain native-owned.
+  std::vector<PermissionRequest*> pending_matches;
+  for (const auto& queue : pending_permission_requests_) {
+    for (const auto& request : queue) {
+      if (matches(request.get()))
+        pending_matches.push_back(request.get());
+    }
+  }
+  if (pending_matches.empty())
+    return false;
+
+  for (PermissionRequest* request : pending_matches) {
+    if (!duplicates_match(request))
+      return false;
+  }
+
+  bool settled = false;
+  for (PermissionRequest* request : pending_matches) {
+    settle_one(request);
+    FinishRequestIncludingDuplicates(request);
+    std::unique_ptr<PermissionRequest> owned =
+        pending_permission_requests_.Extract(request);
+    if (!owned)
+      continue;
+
+    request_sources_map_.erase(base::raw_ref(*request));
+    std::erase(validated_requests_, *request);
+    owned.reset();
+    settled = true;
+  }
+
+  if (settled && requests_.empty())
+    DequeueRequestIfNeeded();
+  return settled;
+}
