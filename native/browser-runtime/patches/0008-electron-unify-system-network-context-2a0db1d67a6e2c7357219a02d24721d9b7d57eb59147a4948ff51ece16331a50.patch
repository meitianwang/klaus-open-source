+// static
+void ElectronBrowserProcessImpl::ApplyAuthPrefsFromCommandLine(
+    ValueMapPrefStore* pref_store) {
+  if (!pref_store)
+    return;
+
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+
+  // The legacy Electron SystemNetworkContextManager read these four switches
+  // directly. The real Chrome manager reads Local State prefs. Translate the
+  // legacy switches into transient command-line prefs so existing command lines
+  // keep the same auth behavior without persistently rewriting Local State.
+  if (command_line->HasSwitch(electron::switches::kAuthServerWhitelist)) {
+    pref_store->SetValue(
+        prefs::kAuthServerAllowlist,
+        base::Value(command_line->GetSwitchValueASCII(
+            electron::switches::kAuthServerWhitelist)),
+        WriteablePrefStore::DEFAULT_PREF_WRITE_FLAGS);
+  }
+
+  if (command_line->HasSwitch(
+          electron::switches::kAuthNegotiateDelegateWhitelist)) {
+    pref_store->SetValue(
+        prefs::kAuthNegotiateDelegateAllowlist,
+        base::Value(command_line->GetSwitchValueASCII(
+            electron::switches::kAuthNegotiateDelegateWhitelist)),
+        WriteablePrefStore::DEFAULT_PREF_WRITE_FLAGS);
+  }
+
+  if (command_line->HasSwitch(electron::switches::kEnableAuthNegotiatePort)) {
+    pref_store->SetValue(prefs::kEnableAuthNegotiatePort, base::Value(true),
+                         WriteablePrefStore::DEFAULT_PREF_WRITE_FLAGS);
+  }
+
+  if (command_line->HasSwitch(electron::switches::kDisableNTLMv2)) {
+    pref_store->SetValue(prefs::kNtlmV2Enabled, base::Value(false),
+                         WriteablePrefStore::DEFAULT_PREF_WRITE_FLAGS);
+  }
+}
