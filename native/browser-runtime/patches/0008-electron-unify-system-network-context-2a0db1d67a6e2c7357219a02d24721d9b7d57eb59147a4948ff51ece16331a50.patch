+void ElectronBrowserProcessImpl::CreateNetworkTimeTracker() {
+  if (network_time_tracker_)
+    return;
+
+  // Created early with no PrefService; InitializeNetworkTimeTracker() will
+  // start actual network-time queries after Local State and the system network
+  // context are available.
+  network_time_tracker_ = std::make_unique<network_time::NetworkTimeTracker>(
+      std::make_unique<base::DefaultClock>(),
+      std::make_unique<base::DefaultTickClock>(), nullptr, nullptr,
+      std::nullopt);
+}
+
+void ElectronBrowserProcessImpl::InitializeNetworkTimeTracker() {
+  if (!network_time_tracker_ || network_time_tracker_->is_initialized())
+    return;
+
+  // Defer actual network queries until Local State and the system network
+  // context are fully initialized.
+  network_time_tracker_->Initialize(
+      local_state_.get(),
+      system_network_context_manager()->GetSharedURLLoaderFactory());
+}
