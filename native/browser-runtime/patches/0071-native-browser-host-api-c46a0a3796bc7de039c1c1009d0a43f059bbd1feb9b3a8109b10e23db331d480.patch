+namespace {
+void Initialize(v8::Local<v8::Object> exports,
+                v8::Local<v8::Value> unused,
+                v8::Local<v8::Context> context,
+                void* priv) {
+  gin_helper::Dictionary dict(context->GetIsolate(), exports);
+  dict.SetMethod("create", &electron::api::CreateNativeBrowser);
+  dict.Set("NativeBrowser", electron::api::NativeBrowser::GetConstructor(
+                                context->GetIsolate())
+                                ->GetFunction(context)
+                                .ToLocalChecked());
+}
+}  // namespace
