+namespace electron::api {
+namespace {
+
+// The native browser owns its BrowserView, tab helpers and Profile services.
+// This wrapper only exposes host operations; it never creates an Electron
+// WebContents or Session for the native Profile.
+class NativeBrowser final : public gin_helper::TrackableObject<NativeBrowser>,
+                            private content::WebContentsObserver,
+                            private NativeWindowObserver {
+ public:
+  NativeBrowser(v8::Isolate* isolate,
+                Profile* profile,
+                NativeWindow* parent,
+                const gfx::Rect& bounds,
+                const GURL& url)
+      : parent_(parent), bounds_(bounds) {
+    ::Browser::CreateParams params(profile, true);
+    params.embedding_parent = parent->GetNativeView();
+    params.initial_bounds = bounds;
+    params.omit_from_session_restore = true;
+    params.should_trigger_session_restore = false;
+    browser_ = ::Browser::Create(params);
+    chrome::AddTabAt(browser_, url, -1, true);
+    Observe(browser_->tab_strip_model()->GetActiveWebContents());
+    parent_->AddObserver(this);
+    Init(isolate);
+    auto* debugger = Debugger::Create(isolate, web_contents());
+    debugger_.Reset(isolate, debugger->GetWrapper(isolate).ToLocalChecked());
+    auto* process =
+        static_cast<ElectronBrowserProcessImpl*>(g_browser_process);
+    process->NotifyNativeBrowserStarted();
+    SetVisible(true);
+  }
+
+  ~NativeBrowser() override {
+    if (parent_)
+      parent_->RemoveObserver(this);
+    if (browser_)
+      browser_->GetWindow()->Close();
+  }
+
+  static void BuildPrototype(v8::Isolate* isolate,
+                             v8::Local<v8::FunctionTemplate> prototype) {
+    prototype->SetClassName(gin::StringToV8(isolate, "NativeBrowser"));
+    gin_helper::ObjectTemplateBuilder(isolate, prototype->PrototypeTemplate())
+        .SetMethod("isDestroyed", &NativeBrowser::IsClosed)
+        .SetMethod("close", &NativeBrowser::Close)
+        .SetMethod("getURL", &NativeBrowser::GetURL)
+        .SetMethod("getTitle", &NativeBrowser::GetTitle)
+        .SetMethod("loadURL", &NativeBrowser::LoadURL)
+        .SetMethod("setBounds", &NativeBrowser::SetBounds)
+        .SetMethod("getBounds", &NativeBrowser::GetBounds)
+        .SetMethod("setVisible", &NativeBrowser::SetVisible)
+        .SetMethod("focus", &NativeBrowser::Focus)
+        .SetProperty("debugger", &NativeBrowser::GetDebugger);
+  }
+
+  bool IsClosed() const { return !browser_ || !web_contents(); }
+  void Close() {
+    if (browser_)
+      browser_->GetWindow()->Close();
+  }
+  std::string GetURL() const {
+    return web_contents() ? web_contents()->GetVisibleURL().spec() : "";
+  }
+  std::string GetTitle() const {
+    return web_contents() ? base::UTF16ToUTF8(web_contents()->GetTitle()) : "";
+  }
+  void LoadURL(const GURL& url, gin::Arguments* args) {
+    if (IsClosed()) {
+      args->ThrowError("Native browser has been closed");
+      return;
+    }
+    if (!url.is_valid()) {
+      args->ThrowTypeError("url must be valid");
+      return;
+    }
+    web_contents()->GetController().LoadURL(
+        url, content::Referrer(), ui::PAGE_TRANSITION_TYPED, std::string());
+  }
+  void SetBounds(const gfx::Rect& bounds, gin::Arguments* args) {
+    if (bounds.width() <= 0 || bounds.height() <= 0) {
+      args->ThrowTypeError("bounds must have a positive size");
+      return;
+    }
+    bounds_ = bounds;
+    if (browser_)
+      browser_->GetWindow()->SetBounds(bounds_);
+  }
+  gfx::Rect GetBounds() const { return bounds_; }
+  void SetVisible(bool visible) {
+    visible_ = visible;
+    if (!browser_)
+      return;
+    if (visible_ && parent_ && parent_->IsVisible())
+      browser_->GetWindow()->ShowInactive();
+    else
+      browser_->GetWindow()->Hide();
+  }
+  void Focus() {
+    if (web_contents())
+      web_contents()->Focus();
+  }
+  v8::Local<v8::Value> GetDebugger(v8::Isolate* isolate) {
+    if (debugger_.IsEmpty())
+      return v8::Null(isolate);
+    return v8::Local<v8::Value>::New(isolate, debugger_);
+  }
+
+ private:
+  void WebContentsDestroyed() override {
+    browser_ = nullptr;
+    debugger_.Reset();
+    Emit("destroyed");
+  }
+  void DidStopLoading() override { Emit("did-stop-loading"); }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->HasCommitted() && handle->IsInPrimaryMainFrame())
+      Emit("did-navigate", handle->GetURL().spec());
+  }
+  void OnWindowClosed() override {
+    parent_->RemoveObserver(this);
+    parent_ = nullptr;
+    Close();
+  }
+  void OnWindowHide() override {
+    if (browser_)
+      browser_->GetWindow()->Hide();
+  }
+  void OnWindowShow() override { SetVisible(visible_); }
+
+  raw_ptr<::Browser> browser_ = nullptr;
+  raw_ptr<NativeWindow> parent_;
+  gfx::Rect bounds_;
+  bool visible_ = false;
+  v8::Global<v8::Value> debugger_;
+};
+
+NativeBrowser* CreateNativeBrowser(gin::Arguments* args) {
+  if (!electron::Browser::Get()->is_ready()) {
+    args->ThrowError("Native browsers can only be created after app readiness");
+    return nullptr;
+  }
+  auto* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    args->ThrowError("Native browser runtime is not enabled");
+    return nullptr;
+  }
+  gin_helper::Dictionary options;
+  gin_helper::Handle<BaseWindow> parent;
+  gfx::Rect bounds;
+  GURL url("about:blank");
+  if (!args->GetNext(&options) || !options.Get("parent", &parent) ||
+      parent.IsEmpty() || parent->window()->IsClosed() ||
+      !options.Get("bounds", &bounds) || bounds.width() <= 0 ||
+      bounds.height() <= 0) {
+    args->ThrowTypeError("A live parent window and positive bounds are required");
+    return nullptr;
+  }
+  if (options.Has("url") &&
+      (!options.Get("url", &url) || !url.is_valid())) {
+    args->ThrowTypeError("url must be valid");
+    return nullptr;
+  }
+  Profile* profile = manager->GetProfile(
+      manager->user_data_dir().Append(FILE_PATH_LITERAL("Default")));
+  if (!profile) {
+    args->ThrowError("Native browser Profile could not be initialized");
+    return nullptr;
+  }
+  return new NativeBrowser(args->isolate(), profile, parent->window(), bounds,
+                           url);
+}
