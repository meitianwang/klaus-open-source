+  void SetParent(gin_helper::Handle<BaseWindow> parent, gin::Arguments* args) {
+    if (IsClosed() || parent.IsEmpty() || parent->window()->IsClosed()) {
+      gin_helper::ErrorThrower(args->isolate()).ThrowError(
+          "A live native browser and parent window are required");
+      return;
+    }
+    NativeWindow* next = parent->window();
+    if (parent_ == next)
+      return;
+    if (!views::Widget::GetWidgetForNativeView(next->GetNativeView())) {
+      gin_helper::ErrorThrower(args->isolate()).ThrowError(
+          "The parent window has no native widget");
+      return;
+    }
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    // Reparent the same native widget. Its top-level ownership, focus manager,
+    // input method and Profile-owned WebContents are retained.
+    views::Widget::ReparentNativeView(view->GetWidget()->GetNativeView(),
+                                     next->GetNativeView());
+    if (!browser_)
+      return;
+    parent_->RemoveObserver(this);
+    parent_ = next;
+    parent_->AddObserver(this);
+    browser_->GetWindow()->SetBounds(HostBoundsToScreen(parent_, bounds_));
+    SetVisible(visible_);
+  }
