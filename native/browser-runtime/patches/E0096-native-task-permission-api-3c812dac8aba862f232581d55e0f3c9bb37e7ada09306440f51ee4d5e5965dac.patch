+  void SetPermission(const GURL& origin_url, const std::string& name,
+                     const std::string& setting, gin::Arguments* args) {
+    if (IsClosed() || !origin_url.SchemeIsHTTPOrHTTPS()) {
+      args->ThrowTypeError("A live native page and HTTP origin are required");
+      return;
+    }
+    std::optional<ContentSettingsType> type;
+    if (name == "geolocation")
+      type = ContentSettingsType::GEOLOCATION;
+    else if (name == "notifications")
+      type = ContentSettingsType::NOTIFICATIONS;
+    else if (name == "camera" || name == "videoCapture")
+      type = ContentSettingsType::MEDIASTREAM_CAMERA;
+    else if (name == "microphone" || name == "audioCapture")
+      type = ContentSettingsType::MEDIASTREAM_MIC;
+    if (!type || (setting != "granted" && setting != "denied" &&
+                  setting != "prompt")) {
+      args->ThrowTypeError("The native task permission or setting is unsupported");
+      return;
+    }
+    Profile* profile = browser_->GetProfile();
+    auto* scope = permissions::HostPermissionScope::GetOrCreateForWebContents(
+        web_contents(), base::BindRepeating(
+            [](Profile* profile, const url::Origin& requesting,
+               const url::Origin& embedding, ContentSettingsType type) {
+              auto* manager = PermissionManagerFactory::GetForProfile(profile);
+              if (!manager)
+                return;
+              manager->NotifyHostPermissionScopeChanged(requesting, embedding,
+                                                       type);
+              if (type == ContentSettingsType::GEOLOCATION)
+                manager->NotifyHostPermissionScopeChanged(
+                    requesting, embedding,
+                    ContentSettingsType::GEOLOCATION_WITH_OPTIONS);
+            }, profile));
+    const auto origin = url::Origin::Create(origin_url);
+    if (setting == "prompt") {
+      scope->Reset(origin, origin, *type);
+    } else if (!scope->Set(origin, origin, *type,
+                 setting == "granted"
+                     ? permissions::HostPermissionScope::Setting::kAllow
+                     : permissions::HostPermissionScope::Setting::kDeny)) {
+      args->ThrowTypeError("The native task permission is unsupported");
+    }
+  }
+  void ResetPermissions() {
+    if (!web_contents())
+      return;
+    if (auto* scope = permissions::HostPermissionScope::FromWebContents(
+            web_contents()))
+      scope->Reset(std::nullopt, std::nullopt, std::nullopt);
+  }
