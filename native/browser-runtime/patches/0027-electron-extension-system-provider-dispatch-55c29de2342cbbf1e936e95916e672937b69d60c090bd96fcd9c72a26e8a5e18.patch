 ExtensionSystem* ElectronExtensionSystemFactory::GetForBrowserContext(
     BrowserContext* context) {
+  if (context && context->IsBrowserProfile()) {
+    return ChromeExtensionSystemFactory::GetInstance()->GetForBrowserContext(
