+                     local_app_data.Append("Google/Chrome/User Data")});
+    roots.push_back({"chromium", "Chromium", "chromium",
+                     local_app_data.Append("Chromium/User Data")});
+    roots.push_back({"edge", "Microsoft Edge", "edge",
