+#ifndef ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_READER_H_
+#define ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_READER_H_
+
+#include <atomic>
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+namespace electron::api {
+
+// Worker-only reader for Chromium-family browser source data.
+//
+// All public methods must be called on the same ThreadPool sequenced worker
+// task runner. Construction and destruction also happen on that runner. The
+// reader only copies data into app-owned staging directories; it never writes
+// to the source profile and never exposes decrypted values through diagnostic
+// output.
+class NativeBrowserSourceReader final {
+ public:
+  NativeBrowserSourceReader(base::FilePath target_profile_path,
+                            base::FilePath test_source_root,
+                            bool mock_keychain,
+                            std::shared_ptr<std::atomic_bool> cancelled,
+                            std::string request_id);
+  ~NativeBrowserSourceReader();
+
+  NativeBrowserSourceReader(const NativeBrowserSourceReader&) = delete;
+  NativeBrowserSourceReader& operator=(const NativeBrowserSourceReader&) = delete;
+
+  // Enumerate profiles from the default platform roots (or the single synthetic
+  // Chrome root in test mode). Returns a dict with {profiles, errors}.
+  base::DictValue ListProfiles();
+
+  // Validate and record the user's selection. Request fields: sourceId,
+  // profileId, categories, cookieHostnameAllowlist, allowUnverifiedExtensions.
+  // Returns {ok:true} or {ok:false, error:{category, code, message}}.
+  base::DictValue Prepare(const base::DictValue& request);
+
+  // Read one selected category. Returns {rows:baseList,
+  // errors:[{category,code,message,count?}]}. Row values are meant for the
+  // native target writer, never for direct JavaScript consumption.
+  base::DictValue ReadCategory(const std::string& category);
+
+  // Thread-safe cancellation entry point for the UI thread. It immediately
+  // sets the shared cancellation flag and invalidates a Keychain authorization
+  // that is currently waiting for user interaction. It performs no file IO and
+  // never starts a new key lookup.
+  void Cancel();
+
+  // Mark a staged extension directory as successfully installed so Cleanup()
+  // leaves it on disk.
+  void RetainExtension(const base::FilePath& path);
+
+  // Remove private SQLite snapshots, delete staged extensions that were not
+  // retained, and zeroize any cached source key material.
+  void Cleanup();
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace electron::api
+
+#endif  // ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_READER_H_
