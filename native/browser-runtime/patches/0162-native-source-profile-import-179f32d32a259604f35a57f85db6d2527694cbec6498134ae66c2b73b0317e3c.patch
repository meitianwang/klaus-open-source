+  base::DictValue ReadExtensions() {
+    base::ListValue rows;
+    base::ListValue errors;
+
+    base::FilePath extensions_dir = selected_profile_path_.Append(
+        FILE_PATH_LITERAL("Extensions"));
+    base::File::Info info;
+    if (!base::GetFileInfo(extensions_dir, &info) || !info.is_directory ||
+        info.is_symbolic_link) {
+      AddImportError(&errors, "extensions", "extensions_unavailable",
+                     "The profile has no readable extension directory.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    base::FilePath extensions_real = RealPathChecked(extensions_dir);
+    if (!IsWithinRoot(selected_profile_path_, extensions_real)) {
+      AddImportError(&errors, "extensions", "extension_escape_rejected",
+                     "The extensions directory resolves outside the profile.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    base::FileEnumerator enumerator(
+        extensions_real, false,
+        base::FileEnumerator::DIRECTORIES | base::FileEnumerator::SHOW_SYM_LINKS);
+    std::vector<std::string> ids;
+    for (base::FilePath id_path = enumerator.Next(); !id_path.empty();
+         id_path = enumerator.Next()) {
+      if (cancelled_->load() || ids.size() > kMaxExtensions) break;
+      if (base::IsLink(id_path))
+        continue;
+      std::string id = id_path.BaseName().AsUTF8Unsafe();
+      if (crx_file::id_util::IdIsValid(id))
+        ids.push_back(id);
+    }
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+
+    if (static_cast<int>(ids.size()) > kMaxExtensions) {
+      AddImportError(&errors, "extensions", "extension_row_limit",
+                     "The profile exceeds the configured extension limit.",
+                     static_cast<int>(ids.size()) - kMaxExtensions);
+      ids.resize(kMaxExtensions);
+    }
+
+    EnsureJobNonce();
+    for (const std::string& id : ids) {
+      if (cancelled_->load()) {
+        AddImportError(&errors, "extensions", "cancelled",
+                       "The browser import was cancelled.");
+        break;
+      }
+      base::FilePath id_dir = extensions_real.Append(id);
+      base::FilePath id_real = RealPathChecked(id_dir);
+      if (!IsWithinRoot(extensions_real, id_real)) {
+        AddImportError(&errors, "extensions", "extension_escape_rejected",
+                       "An extension directory resolves outside the extensions root.");
+        continue;
+      }
+
+      base::FileEnumerator versions(
+          id_real, false,
+          base::FileEnumerator::DIRECTORIES |
+              base::FileEnumerator::SHOW_SYM_LINKS);
+      std::string best_version;
+      base::FilePath best_version_path;
+      size_t versions_seen = 0;
+      for (base::FilePath version_path = versions.Next(); !version_path.empty();
+           version_path = versions.Next()) {
+        if (cancelled_->load() || ++versions_seen > 256) break;
+        if (base::IsLink(version_path))
+          continue;
+        std::string version = version_path.BaseName().AsUTF8Unsafe();
+        const size_t suffix = version.rfind('_');
+        if (suffix != std::string::npos) {
+          const std::string instance = version.substr(suffix + 1);
+          if (instance.empty() ||
+              !std::all_of(instance.begin(), instance.end(), [](char ch) { return ch >= '0' && ch <= '9'; }))
+            continue;
+          version.resize(suffix);
+        }
+        if (!IsValidExtensionVersion(version))
+          continue;
+        if (best_version.empty() || CompareExtensionVersion(version, best_version) > 0) {
+          best_version = version;
+          best_version_path = version_path;
+        }
+      }
+      if (best_version.empty()) {
+        AddImportError(&errors, "extensions", "extension_version_invalid",
+                       "An extension has no supported version directory.");
+        continue;
+      }
+
+      base::FilePath manifest_path = best_version_path.Append(
+          FILE_PATH_LITERAL("manifest.json"));
+      base::File::Info manifest_info;
+      if (base::IsLink(manifest_path) ||
+          !base::GetFileInfo(manifest_path, &manifest_info) ||
+          manifest_info.is_directory || manifest_info.is_symbolic_link ||
+          manifest_info.size == 0 ||
+          manifest_info.size < 0 || static_cast<uint64_t>(manifest_info.size) > kMaxExtensionManifestBytes) {
+        AddImportError(&errors, "extensions", "extension_manifest_invalid",
+                       "An extension manifest is missing or unsupported.");
+        continue;
+      }
+      base::FilePath manifest_real = RealPathChecked(manifest_path);
+      if (!IsWithinRoot(best_version_path, manifest_real)) {
+        AddImportError(&errors, "extensions", "extension_escape_rejected",
+                       "An extension manifest resolves outside its package.");
+        continue;
+      }
+      std::string manifest_raw;
+      if (!base::ReadFileToStringWithMaxSize(manifest_real, &manifest_raw, kMaxExtensionManifestBytes)) {
+        AddImportError(&errors, "extensions", "extension_manifest_invalid",
+                       "An extension manifest could not be read.");
+        continue;
+      }
+      std::optional<base::Value> manifest_parsed = base::JSONReader::Read(
+          manifest_raw, base::JSON_ALLOW_TRAILING_COMMAS);
+      if (!manifest_parsed || !manifest_parsed->is_dict()) {
+        AddImportError(&errors, "extensions", "extension_manifest_invalid",
+                       "An extension manifest is not valid JSON.");
+        continue;
+      }
+      const base::DictValue* manifest = manifest_parsed->GetIfDict();
+      const std::string* version_value = manifest->FindString("version");
+      if (!version_value || *version_value != best_version) {
+        AddImportError(&errors, "extensions", "extension_version_mismatch",
+                       "An extension manifest version does not match its directory.");
+        continue;
+      }
+      bool id_verified = false;
+      const std::string* key_value = manifest->FindString("key");
+      if (key_value && !key_value->empty()) {
+        std::string decoded_key;
+        if (base::Base64Decode(*key_value, &decoded_key)) {
+          std::string derived_id =
+              crx_file::id_util::GenerateId(decoded_key);
+          if (derived_id == id) {
+            id_verified = true;
+          } else {
+            AddImportError(&errors, "extensions", "extension_id_mismatch",
+                           "An extension public key does not match its folder id.");
+            continue;
+          }
+        } else {
+          AddImportError(&errors, "extensions", "extension_key_invalid",
+                         "An extension public key is not valid base64.");
+          continue;
+        }
+      }
+
+      base::FilePath stage_dir = extensions_staging_root_.Append(id).Append(
+          base::FilePath::FromUTF8Unsafe(job_nonce_));
+      if (base::PathExists(stage_dir))
+        base::DeletePathRecursively(stage_dir);
+      if (!base::CreateDirectory(stage_dir)) {
+        AddImportError(&errors, "extensions", "extension_target_unavailable",
+                       "Could not create an extension staging directory.");
+        continue;
+      }
+
+      int files = 0;
+      size_t bytes = 0;
+      std::string copy_code, copy_message;
+      bool copied = CopyExtensionTree(best_version_path, stage_dir,
+                                      best_version_path, &files, &bytes,
+                                      &copy_code, &copy_message);
+      if (!copied) {
+        base::DeletePathRecursively(stage_dir);
+        AddImportError(&errors, "extensions", copy_code, copy_message);
+        continue;
+      }
+
+      staged_extensions_.insert(stage_dir);
+      base::DictValue row;
+      row.Set("id", id);
+      row.Set("path", stage_dir.AsUTF8Unsafe());
+      row.Set("idVerified", id_verified);
+      rows.Append(std::move(row));
+    }
+
+    return CategoryResult(std::move(rows), std::move(errors));
+  }
+
+  bool CopyExtensionTree(const base::FilePath& source,
+                         const base::FilePath& target,
+                         const base::FilePath& source_root,
+                         int* files,
+                         size_t* bytes,
+                         std::string* error_code,
+                         std::string* error_message) {
+    if (cancelled_->load()) {
+      *error_code = "cancelled";
+      *error_message = "The browser import was cancelled.";
+      return false;
+    }
+    if (!base::CreateDirectory(target)) {
+      *error_code = "extension_target_unavailable";
+      *error_message = "Could not create an extension staging directory.";
+      return false;
+    }
+    base::FileEnumerator enumerator(
+        source, false,
+        base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES |
+            base::FileEnumerator::SHOW_SYM_LINKS);
+    std::vector<base::FilePath> entries;
+    for (base::FilePath entry = enumerator.Next(); !entry.empty();
+         entry = enumerator.Next()) {
+      if (cancelled_->load() || entries.size() >= kMaxExtensionFiles) {
+        *error_code = "extension_file_limit";
+        *error_message = "The extension package exceeds the entry limit or was cancelled.";
+        return false;
+      }
+      entries.push_back(entry);
+    }
+    std::sort(entries.begin(), entries.end(),
+              [](const base::FilePath& a, const base::FilePath& b) {
+                return a.value() < b.value();
+              });
+
+    for (const base::FilePath& entry : entries) {
+      if (base::IsLink(entry)) {
+        *error_code = "extension_symlink_rejected";
+        *error_message = "The extension package contains a symbolic link.";
+        return false;
+      }
+      base::FilePath real = RealPathChecked(entry);
+      if (!IsWithinRoot(source_root, real)) {
+        *error_code = "extension_escape_rejected";
+        *error_message = "The extension package escapes its directory.";
+        return false;
+      }
+      base::FilePath relative;
+      source.AppendRelativePath(entry, &relative);
+      base::FilePath target_entry = target.Append(relative);
+      base::File::Info info;
+      if (!base::GetFileInfo(entry, &info)) {
+        *error_code = "extension_source_unreadable";
+        *error_message = "An extension file could not be inspected.";
+        return false;
+      }
+      if (info.is_directory) {
+        if (!CopyExtensionTree(entry, target_entry, source_root, files, bytes,
+                               error_code, error_message))
+          return false;
+      } else {
+        ++(*files);
+        *bytes += info.size;
+        if (*files > kMaxExtensionFiles) {
+          *error_code = "extension_file_limit";
+          *error_message = "The extension exceeds the file-count limit.";
+          return false;
+        }
+        if (*bytes > kMaxExtensionBytes) {
+          *error_code = "extension_size_limit";
+          *error_message = "The extension exceeds the total-size limit.";
+          return false;
+        }
+        if (!base::CopyFile(entry, target_entry)) {
+          *error_code = "extension_copy_failed";
+          *error_message = "An extension file could not be copied.";
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  static std::string SameSiteString(int value) {
+    switch (value) {
+      case 0:
+        return "no_restriction";
+      case 1:
+        return "lax";
+      case 2:
+        return "strict";
+      default:
+        return "unspecified";
+    }
+  }
