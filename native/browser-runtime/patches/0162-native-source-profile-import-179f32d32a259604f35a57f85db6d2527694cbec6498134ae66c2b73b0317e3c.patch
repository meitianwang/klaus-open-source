+class NativeBrowserSourceReader::Impl {
+ public:
+  Impl(base::FilePath target_profile_path,
+       base::FilePath test_source_root,
+       bool mock_keychain,
+       std::shared_ptr<std::atomic_bool> cancelled,
+       std::string request_id)
+      : target_profile_path_(std::move(target_profile_path)),
+        test_source_root_(std::move(test_source_root)),
+        mock_keychain_(mock_keychain),
+        cancelled_(std::move(cancelled)),
+        request_id_(std::move(request_id)) {
+    DCHECK(cancelled_);
+    if (request_id_.size() > kMaxRequestIdLength)
+      request_id_.resize(kMaxRequestIdLength);
+#if BUILDFLAG(IS_MAC)
+    keychain_cancel_ =
+        std::make_unique<klaus::browser_source::KeychainCancellation>();
+#endif
+    InitializeTestMode();
+  }
+
+  ~Impl() { Cleanup(); }
+
+  base::DictValue ListProfiles() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::vector<base::DictValue> profile_rows;
+    base::ListValue errors;
+
+    std::string code, message;
+    if (HasTestError(&code, &message)) {
+      AddDiscoveryError(&errors, std::string(), code, message);
+      base::DictValue result;
+      result.Set("profiles", base::ListValue());
+      result.Set("errors", std::move(errors));
+      return result;
+    }
+
+    std::vector<SourceRoot> roots = BuildSourceRoots();
+    for (const SourceRoot& root : roots) {
+      if (cancelled_->load())
+        break;
+      if (base::IsLink(root.user_data_dir)) {
+        AddDiscoveryError(&errors, root.id, "source_symlink_rejected",
+                          "The source root is a symbolic link.");
+        continue;
+      }
+      base::File::Info info;
+      if (!base::GetFileInfo(root.user_data_dir, &info) ||
+          !info.is_directory) {
+        if (errno == EACCES || errno == EPERM ||
+            base::PathExists(root.user_data_dir)) {
+          AddDiscoveryError(&errors, root.id, "source_permission_denied",
+                            "The browser data directory could not be inspected.");
+        }
+        continue;
+      }
+      base::FilePath root_real = RealPathChecked(root.user_data_dir);
+      std::string ls_code, ls_message;
+      base::DictValue profile_state =
+          ReadLocalState(root_real, &ls_code, &ls_message);
+      if (!ls_code.empty()) {
+        AddDiscoveryError(&errors, root.id, ls_code, ls_message);
+        continue;
+      }
+      const base::Value* last_used_value = profile_state.Find("last_used");
+      const std::string* last_used =
+          last_used_value ? last_used_value->GetIfString() : nullptr;
+      const base::DictValue* info_cache = profile_state.FindDict("info_cache");
+      if (!info_cache || info_cache->empty()) {
+        AddDiscoveryError(&errors, root.id, "profile_cache_empty",
+                          "The browser profile index contains no profiles.");
+        continue;
+      }
+      for (const auto item : *info_cache) {
+        if (cancelled_->load())
+          break;
+        const std::string& profile_id = item.first;
+        if (!IsValidProfileId(profile_id)) {
+          AddDiscoveryError(&errors, root.id, "profile_id_rejected",
+                            "A profile directory name is not supported.");
+          continue;
+        }
+        base::FilePath profile_dir = root_real.Append(profile_id);
+        base::File::Info profile_info;
+        if (!base::GetFileInfo(profile_dir, &profile_info) ||
+            !profile_info.is_directory) {
+          if (base::PathExists(profile_dir)) {
+            AddDiscoveryError(&errors, root.id, "profile_unreadable",
+                              "A browser profile directory could not be inspected.");
+          }
+          continue;
+        }
+        if (profile_info.is_symbolic_link ||
+            base::IsLink(profile_dir)) {
+          AddDiscoveryError(&errors, root.id, "profile_symlink_rejected",
+                            "A profile directory is a symbolic link.");
+          continue;
+        }
+        base::FilePath profile_real = RealPathChecked(profile_dir);
+        if (!IsWithinRoot(root_real, profile_real)) {
+          AddDiscoveryError(&errors, root.id, "profile_escape_rejected",
+                            "A profile directory resolves outside the source root.");
+          continue;
+        }
+        bool has_cookies = false;
+        bool has_passwords = false;
+        bool has_history = false;
+        bool has_extensions = false;
+        std::string unused_code, unused_message;
+        CookieDatabaseResolution cookie_res =
+            ResolveCookieDatabase(profile_real, &unused_code, &unused_message);
+        has_cookies = !cookie_res.path.empty();
+        has_passwords = base::PathExists(profile_real.Append(
+                            FILE_PATH_LITERAL("Login Data"))) &&
+                        !base::IsLink(profile_real.Append(
+                            FILE_PATH_LITERAL("Login Data")));
+        has_history = base::PathExists(profile_real.Append(
+                          FILE_PATH_LITERAL("History"))) &&
+                      !base::IsLink(profile_real.Append(
+                          FILE_PATH_LITERAL("History")));
+        base::FilePath ext_dir = profile_real.Append(
+            FILE_PATH_LITERAL("Extensions"));
+        base::File::Info ext_info;
+        has_extensions = base::GetFileInfo(ext_dir, &ext_info) &&
+                         ext_info.is_directory && !ext_info.is_symbolic_link;
+
+        base::DictValue candidate;
+        candidate.Set("sourceId", root.id);
+        candidate.Set("sourceLabel", root.label);
+        candidate.Set("profileId", profile_id);
+        candidate.Set("displayName",
+                      SafeDisplayName(&item.second, profile_id));
+        candidate.Set("lastUsed", last_used && *last_used == profile_id);
+        candidate.Set("cookies", has_cookies);
+        candidate.Set("passwords", has_passwords);
+        candidate.Set("history", has_history);
+        candidate.Set("extensions", has_extensions);
+        profile_rows.push_back(std::move(candidate));
+      }
+    }
+
+    std::sort(profile_rows.begin(), profile_rows.end(),
+              [](const base::DictValue& a, const base::DictValue& b) {
+                bool la = a.FindBool("lastUsed").value_or(false);
+                bool lb = b.FindBool("lastUsed").value_or(false);
+                if (la != lb)
+                  return la;
+                const std::string* psa = a.FindString("sourceLabel");
+                const std::string* psb = b.FindString("sourceLabel");
+                if (psa && psb && *psa != *psb)
+                  return *psa < *psb;
+                const std::string* pna = a.FindString("displayName");
+                const std::string* pnb = b.FindString("displayName");
+                if (pna && pnb && *pna != *pnb)
+                  return *pna < *pnb;
+                const std::string* pida = a.FindString("profileId");
+                const std::string* pidb = b.FindString("profileId");
+                return (pida ? *pida : "") < (pidb ? *pidb : "");
+              });
+    base::ListValue profiles;
+    for (auto& row : profile_rows)
+      profiles.Append(std::move(row));
+
+    base::DictValue result;
+    result.Set("profiles", std::move(profiles));
+    result.Set("errors", std::move(errors));
+    return result;
+  }
+
+  base::DictValue Prepare(const base::DictValue& request) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::string code, message;
+    if (HasTestError(&code, &message))
+      return FailureDict(code, message);
+
+    const std::string* source_id = request.FindString("sourceId");
+    const std::string* profile_id = request.FindString("profileId");
+    if (!source_id || source_id->empty() || source_id->size() > 128) {
+      return FailureDict("invalid_request",
+                         "A source identifier is required.");
+    }
+    if (!profile_id || profile_id->empty() ||
+        profile_id->size() > kMaxProfileIdLength ||
+        !IsValidProfileId(*profile_id)) {
+      return FailureDict("invalid_request",
+                         "A supported profile identifier is required.");
+    }
+
+    const base::DictValue* categories = request.FindDict("categories");
+    struct Cat { bool cookies = true; bool passwords = true; bool history = false; bool extensions = false; } cat;
+    if (categories) {
+      std::optional<bool> v;
+      v = categories->FindBool("cookies");
+      if (v.has_value()) cat.cookies = *v;
+      v = categories->FindBool("passwords");
+      if (v.has_value()) cat.passwords = *v;
+      v = categories->FindBool("history");
+      if (v.has_value()) cat.history = *v;
+      v = categories->FindBool("extensions");
+      if (v.has_value()) cat.extensions = *v;
+    }
+
+    std::optional<bool> allow_ext = request.FindBool("allowUnverifiedExtensions");
+    bool allow_unverified = allow_ext.value_or(false);
+    if (cat.extensions && !allow_unverified) {
+      return FailureDict("extensions_not_confirmed",
+                         "Extension import requires explicit confirmation.");
+    }
+
+    std::vector<std::string> allowlist;
+    const base::ListValue* list = request.FindList("cookieHostnameAllowlist");
+    if (list) {
+      if (list->size() > kMaxAllowlistEntries) {
+        return FailureDict("invalid_request",
+                           "The cookie hostname allowlist is too large.");
+      }
+      for (const base::Value& item : *list) {
+        const std::string* host = item.GetIfString();
+        if (!host || !IsValidAllowlistHost(*host)) {
+          return FailureDict("invalid_request",
+                             "A cookie hostname in the allowlist is invalid.");
+        }
+        std::string normalized = base::ToLowerASCII(
+            base::CollapseWhitespaceASCII(*host, true));
+        if (!normalized.empty() && normalized.front() == '.')
+          normalized.erase(normalized.begin());
+        bool wildcard = base::StartsWith(normalized, "*.",
+                                         base::CompareCase::SENSITIVE);
+        std::string host_part = wildcard ? normalized.substr(2) : normalized;
+        allowlist.push_back((wildcard ? "*." : "") + host_part);
+      }
+    }
+
+    selected_source_id_ = *source_id;
+    selected_profile_id_ = *profile_id;
+    categories_.cookies = cat.cookies;
+    categories_.passwords = cat.passwords;
+    categories_.history = cat.history;
+    categories_.extensions = cat.extensions;
+    allowlist_ = std::move(allowlist);
+    allow_unverified_extensions_ = allow_unverified;
+
+    if (!ResolveSelectedProfile(&code, &message))
+      return FailureDict(code, message);
+
+    prepared_ = true;
+    base::DictValue result;
+    result.Set("ok", true);
+    return result;
+  }
+
+  base::DictValue ReadCategory(const std::string& category) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    base::ListValue rows;
+    base::ListValue errors;
+    std::string code, message;
+    if (HasTestError(&code, &message)) {
+      AddImportError(&errors, category, code, message);
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    if (!prepared_ || selected_profile_path_.empty()) {
+      AddImportError(&errors, category, "not_prepared",
+                     "A profile must be selected first.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    if (cancelled_->load()) {
+      AddImportError(&errors, category, "cancelled",
+                     "The browser import was cancelled.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    if (category == "cookies" && categories_.cookies)
+      return ReadCookies();
+    if (category == "passwords" && categories_.passwords)
+      return ReadPasswords();
+    if (category == "history" && categories_.history)
+      return ReadHistory();
+    if (category == "extensions" && categories_.extensions)
+      return ReadExtensions();
+
+    return CategoryResult(std::move(rows), std::move(errors));
+  }
+
+  // This method is intentionally callable from a different thread. It only
+  // touches the shared atomic flag and the short-lived keychain publication
+  // guarded by the crypto module's mutex. It must not do file IO.
+  void Cancel() {
+    if (cancelled_)
+      cancelled_->store(true);
+#if BUILDFLAG(IS_MAC)
+    klaus::browser_source::InvalidatePendingKeychainAuthorization(
+        keychain_cancel_.get());
+#endif
+  }
+
+  void RetainExtension(const base::FilePath& path) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (path.empty())
+      return;
+    if (!extensions_staging_root_.empty() &&
+        IsWithinRoot(extensions_staging_root_, path)) {
+      retained_extensions_.insert(path);
+    }
+  }
+
+  void Cleanup() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (cleaned_up_)
+      return;
+    cleaned_up_ = true;
+
+    if (!import_staging_dir_.empty())
+      base::DeletePathRecursively(import_staging_dir_);
+
+    for (const base::FilePath& staged : staged_extensions_) {
+      if (!retained_extensions_.contains(staged))
+        base::DeletePathRecursively(staged);
+    }
+    staged_extensions_.clear();
+    retained_extensions_.clear();
+
+#if BUILDFLAG(IS_MAC)
+    klaus::browser_source::Zeroize(key_state_.key, sizeof(key_state_.key));
+#endif
+    key_state_.ready = false;
+    key_state_.failed = false;
+    key_state_.failure_code.clear();
+    key_state_.failure_message.clear();
+  }
+
+ private:
+  void InitializeTestMode() {
+    if (test_source_root_.empty()) {
+      if (mock_keychain_) {
+        test_error_ = Impl::TestError::kRequired;
+      }
+      return;
+    }
+    if (!test_source_root_.IsAbsolute() || test_source_root_.ReferencesParent() ||
+        base::IsLink(test_source_root_) || !base::PathExists(test_source_root_)) {
+      test_error_ = Impl::TestError::kInvalidPath;
+      return;
+    }
+    base::FilePath target_parent = target_profile_path_.DirName();
+    base::FilePath parent_real = RealPathChecked(target_parent);
+    base::FilePath test_real = RealPathChecked(test_source_root_);
+    if (parent_real.empty() || test_real.empty() ||
+        (!parent_real.IsParent(test_real) && parent_real != test_real)) {
+      test_error_ = Impl::TestError::kOutsideTarget;
+      return;
+    }
+    if (!mock_keychain_) {
+      test_error_ = Impl::TestError::kMockRequired;
+      return;
+    }
+    is_test_mode_ = true;
+  }
+
+  bool HasTestError(std::string* code, std::string* message) const {
+    switch (test_error_) {
+      case Impl::TestError::kRequired:
+        *code = "test_source_required";
+        *message = "A synthetic test source root is required in mock-keychain mode.";
+        return true;
+      case Impl::TestError::kOutsideTarget:
+        *code = "test_source_outside_target";
+        *message = "The test source root is outside the target profile directory.";
+        return true;
+      case Impl::TestError::kMockRequired:
+        *code = "test_source_requires_mock_keychain";
+        *message = "A test source root requires mock-keychain mode.";
+        return true;
+      case Impl::TestError::kInvalidPath:
+        *code = "test_source_invalid";
+        *message = "The test source root path is not usable.";
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  std::vector<SourceRoot> BuildSourceRoots() const {
+    if (is_test_mode_) {
+      return {SourceRoot{"chrome", "Google Chrome", "chrome",
+                         test_source_root_}};
+    }
+    return DefaultSourceRoots();
+  }
+
+  bool SourceRootForId(const std::string& id, SourceRoot* out) const {
+    std::vector<SourceRoot> roots = BuildSourceRoots();
+    for (const SourceRoot& root : roots) {
+      if (root.id == id) {
+        *out = root;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool ResolveSelectedProfile(std::string* error_code,
+                              std::string* error_message) {
+    SourceRoot root;
+    if (!SourceRootForId(selected_source_id_, &root)) {
+      *error_code = "profile_not_found";
+      *error_message = "The selected browser source is no longer available.";
+      return false;
+    }
+    if (base::IsLink(root.user_data_dir)) {
+      *error_code = "source_symlink_rejected";
+      *error_message = "The selected source root is a symbolic link.";
+      return false;
+    }
+    base::FilePath root_real = RealPathChecked(root.user_data_dir);
+    base::File::Info info;
+    if (!base::GetFileInfo(root_real, &info) || !info.is_directory) {
+      *error_code = "source_permission_denied";
+      *error_message = "The selected browser data directory could not be inspected.";
+      return false;
+    }
+    std::string ls_code, ls_message;
+    base::DictValue local_state = ReadLocalState(root_real, &ls_code, &ls_message);
+    if (!ls_code.empty()) {
+      *error_code = ls_code;
+      *error_message = ls_message;
+      return false;
+    }
+    const base::DictValue* info_cache = local_state.FindDict("info_cache");
+    if (!info_cache || !info_cache->Find(selected_profile_id_)) {
+      *error_code = "profile_not_found";
+      *error_message = "The selected browser profile is no longer available.";
+      return false;
+    }
+    base::FilePath profile_dir = root_real.Append(selected_profile_id_);
+    base::File::Info profile_info;
+    if (!base::GetFileInfo(profile_dir, &profile_info) ||
+        !profile_info.is_directory || profile_info.is_symbolic_link ||
+        base::IsLink(profile_dir)) {
+      *error_code = "profile_unavailable";
+      *error_message = "The selected browser profile can no longer be read.";
+      return false;
+    }
+    base::FilePath profile_real = RealPathChecked(profile_dir);
+    if (!IsWithinRoot(root_real, profile_real)) {
+      *error_code = "profile_escape_rejected";
+      *error_message = "The selected profile resolves outside the source root.";
+      return false;
+    }
+    selected_profile_path_ = profile_real;
+    selected_family_ = root.family;
+    return true;
+  }
+
+  void EnsureJobNonce() {
+    if (!job_nonce_.empty())
+      return;
+    job_nonce_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    base::FilePath nonce_path = base::FilePath::FromUTF8Unsafe(job_nonce_);
+    import_staging_dir_ =
+        target_profile_path_.Append(FILE_PATH_LITERAL("ImportStaging"))
+            .Append(nonce_path);
+    extensions_staging_root_ =
+        target_profile_path_.Append(FILE_PATH_LITERAL("ImportedExtensions"));
+  }
+
+  bool SnapshotDatabase(const base::FilePath& source_db,
+                        base::FilePath* snapshot_db,
+                        std::string* error_code,
+                        std::string* error_message) {
+    EnsureJobNonce();
+    std::string snapshot_nonce =
+        base::Uuid::GenerateRandomV4().AsLowercaseString();
+    base::FilePath snapshot_dir = import_staging_dir_.Append(
+        base::FilePath::FromUTF8Unsafe("snap-" + snapshot_nonce));
+    if (!base::CreateDirectory(snapshot_dir)) {
+      *error_code = "staging_directory_failed";
+      *error_message = "Could not create a private database staging directory.";
+      return false;
+    }
+
+    base::FilePath target = snapshot_dir.Append(source_db.BaseName());
+    const std::vector<base::FilePath::StringType> suffixes = {
+        FILE_PATH_LITERAL(""), FILE_PATH_LITERAL("-wal"), FILE_PATH_LITERAL("-shm")};
+    struct SnapshotFile {
+      bool exists = false;
+      base::File::Info info;
+    };
+    auto inspect = [&](std::vector<SnapshotFile>* files) -> bool {
+      files->clear();
+      int64_t total = 0;
+      for (const auto& suffix : suffixes) {
+        const auto candidate = WithSuffix(source_db, suffix);
+        SnapshotFile file;
+        if (base::IsLink(candidate)) {
+          *error_code = "database_symlink_rejected";
+          *error_message = "A browser database or sidecar is a symbolic link.";
+          return false;
+        }
+        errno = 0;
+        file.exists = base::GetFileInfo(candidate, &file.info);
+        if (!file.exists && (suffix.empty() || errno != ENOENT)) {
+          *error_code = errno == EPERM || errno == EACCES
+              ? "source_permission_denied" : "database_unavailable";
+          *error_message = "A browser database or sidecar could not be inspected.";
+          return false;
+        }
+        if (file.exists) {
+          if (file.info.is_directory || file.info.is_symbolic_link ||
+              file.info.size < 0 ||
+              !IsWithinRoot(selected_profile_path_, RealPathChecked(candidate))) {
+            *error_code = "database_path_rejected";
+            *error_message = "A browser database or sidecar is outside the selected profile.";
+            return false;
+          }
+          if (file.info.size > static_cast<int64_t>(kMaxDatabaseBytes) - total) {
+            *error_code = "database_too_large";
+            *error_message = "The browser database exceeds the configured size limit.";
+            return false;
+          }
+          total += file.info.size;
+        }
+        files->push_back(file);
+      }
+      return true;
+    };
+    for (size_t attempt = 0; attempt < kMaxSnapshotAttempts; ++attempt) {
+      if (cancelled_->load())
+        break;
+      std::vector<SnapshotFile> before;
+      if (!inspect(&before))
+        return false;
+      for (size_t index = 0; index < suffixes.size(); ++index) {
+        const auto& suffix = suffixes[index];
+        base::FilePath extra = WithSuffix(source_db, suffix);
+        if (before[index].exists) {
+          base::FilePath extra_target = WithSuffix(target, suffix);
+          if (!base::CopyFile(extra, extra_target)) {
+            *error_code = "source_permission_denied";
+            *error_message = "A browser database or sidecar could not be copied.";
+            return false;
+          }
+        } else {
+          base::DeleteFile(WithSuffix(target, suffix));
+        }
+      }
+      std::vector<SnapshotFile> after;
+      if (!inspect(&after))
+        return false;
+      bool stable = true;
+      for (size_t index = 0; index < suffixes.size(); ++index) {
+        if (before[index].exists != after[index].exists ||
+            (before[index].exists &&
+             (before[index].info.size != after[index].info.size ||
+              before[index].info.last_modified != after[index].info.last_modified))) {
+          stable = false;
+          break;
+        }
+      }
+      if (stable) {
+        *snapshot_db = target;
+        return true;
+      }
+      for (const auto& suffix : suffixes)
+        base::DeleteFile(WithSuffix(target, suffix));
+    }
+    *error_code = "snapshot_unstable";
+    *error_message = "The database changed while it was being copied.";
+    return false;
+  }
+
+  bool GetOrDeriveSourceKey(std::string* code, std::string* message) {
+    if (cancelled_->load()) {
+      *code = "cancelled";
+      *message = "The browser import was cancelled.";
+      return false;
+    }
+    if (key_state_.ready)
+      return true;
+    if (key_state_.failed) {
+      *code = key_state_.failure_code;
+      *message = key_state_.failure_message;
+      return false;
+    }
+    std::string password;
+    if (mock_keychain_) {
+      password = kMockKeychainPassword;
+    } else {
+#if BUILDFLAG(IS_MAC)
+      if (!SourceRootSupportsEncryption(selected_family_)) {
+        *code = "unsupported_source";
+        *message = "The selected browser source is not supported.";
+        key_state_.failed = true;
+        key_state_.failure_code = *code;
+        key_state_.failure_message = *message;
+        return false;
+      }
+      if (!klaus::browser_source::GetSourceKeyPassword(
+              selected_family_, keychain_cancel_.get(), &password, code,
+              message)) {
+        if (cancelled_->load()) {
+          *code = "cancelled";
+          *message = "The browser import was cancelled.";
+          return false;
+        }
+        key_state_.failed = true;
+        key_state_.failure_code = *code;
+        key_state_.failure_message = *message;
+        return false;
+      }
+#else
+      key_state_.failed = true;
+      key_state_.failure_code = "encryption_unsupported_on_platform";
+      key_state_.failure_message =
+          "Encrypted browser values are not supported on this platform.";
+      *code = key_state_.failure_code;
+      *message = key_state_.failure_message;
+      return false;
+#endif
+    }
+    if (cancelled_->load()) {
+      std::fill(password.begin(), password.end(), '\0');
+      password.clear();
+      *code = "cancelled";
+      *message = "The browser import was cancelled.";
+      return false;
+    }
+    if (password.empty()) {
+      key_state_.failed = true;
+      key_state_.failure_code = "key_unavailable";
+      key_state_.failure_message = "The browser Safe Storage key is empty.";
+      *code = key_state_.failure_code;
+      *message = key_state_.failure_message;
+      return false;
+    }
+#if BUILDFLAG(IS_MAC)
+    const bool derived = klaus::browser_source::DeriveKey(password, key_state_.key);
+    klaus::browser_source::Zeroize(password.data(), password.size());
+    password.clear();
+    if (!derived) {
+      klaus::browser_source::Zeroize(key_state_.key, sizeof(key_state_.key));
+      key_state_.failed = true;
+      key_state_.failure_code = "key_derivation_failed";
+      key_state_.failure_message = "The browser Safe Storage key could not be derived.";
+      *code = key_state_.failure_code;
+      *message = key_state_.failure_message;
+      return false;
+    }
+#else
+    key_state_.failed = true;
+    key_state_.failure_code = "encryption_unsupported_on_platform";
+    key_state_.failure_message =
+        "Encrypted browser values are not supported on this platform.";
+    *code = key_state_.failure_code;
+    *message = key_state_.failure_message;
+    return false;
+#endif
+    key_state_.ready = true;
+    return true;
+  }
+
+  bool DecryptSecret(const std::string& ciphertext,
+                     const std::string& host,
+                     bool is_cookie,
+                     int meta_version,
+                     std::string* plaintext,
+                     std::string* code,
+                     std::string* message) {
+    if (cancelled_->load()) {
+      *code = "cancelled";
+      *message = "The browser import was cancelled.";
+      return false;
+    }
+    if (!ciphertext.starts_with("v10") || ciphertext.size() > kMaxStringValueLength + 64) {
+      *code = "unsupported_encryption";
+      *message = "The encrypted browser value has an unsupported format or size.";
+      return false;
+    }
+    if (!GetOrDeriveSourceKey(code, message))
+      return false;
+
+#if BUILDFLAG(IS_MAC)
+    klaus::browser_source::DecryptResult result =
+        klaus::browser_source::DecryptV10(ciphertext, key_state_.key);
+    if (!result.ok) {
+      *code = result.code;
+      *message = result.message;
+      return false;
+    }
+    if (is_cookie && meta_version >= 24) {
+      if (host.empty()) {
+        klaus::browser_source::Zeroize(result.plaintext.data(),
+                                       result.plaintext.size());
+        *code = "host_required";
+        *message = "A partitioned cookie check requires the host key.";
+        return false;
+      }
+      const std::string expected = klaus::browser_source::Sha256(host);
+      if (result.plaintext.size() < expected.size() ||
+          result.plaintext.compare(0, expected.size(), expected) != 0) {
+        klaus::browser_source::Zeroize(result.plaintext.data(),
+                                       result.plaintext.size());
+        *code = "host_hash_mismatch";
+        *message = "The encrypted cookie host hash does not match.";
+        return false;
+      }
+      result.plaintext.erase(0, expected.size());
+    }
+    if (result.plaintext.size() > kMaxStringValueLength) {
+      klaus::browser_source::Zeroize(result.plaintext.data(),
+                                     result.plaintext.size());
+      *code = "plaintext_too_large";
+      *message = "The decrypted value exceeds the supported size.";
+      return false;
+    }
+    *plaintext = std::move(result.plaintext);
+    return true;
+#else
+    *code = "encryption_unsupported_on_platform";
+    *message = "Encrypted browser values are not supported on this platform.";
+    return false;
+#endif
+  }
+
+  base::DictValue ReadCookies() {
+    base::ListValue rows;
+    base::ListValue errors;
+
+    std::string error_code, error_message;
+    CookieDatabaseResolution resolution = ResolveCookieDatabase(
+        selected_profile_path_, &error_code, &error_message);
+    if (resolution.path.empty()) {
+      if (!error_code.empty())
+        AddImportError(&errors, "cookies", error_code, error_message);
+      else
+        AddImportError(&errors, "cookies", "cookies_unavailable",
+                       "The profile has no readable cookie database.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    base::FilePath snapshot;
+    if (!SnapshotDatabase(resolution.path, &snapshot, &error_code,
+                          &error_message)) {
+      AddImportError(&errors, "cookies", error_code, error_message);
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    sql::Database db(
+        sql::DatabaseOptions{}
+            .set_read_only(true)
+            .set_exclusive_locking(false)
+            .set_mmap_enabled(false),
+        sql::Database::Tag("Cookie"));
+    if (!db.Open(snapshot)) {
+      AddImportError(&errors, "cookies", "snapshot_corrupted",
+                     "The cookie database snapshot could not be opened.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    (void)db.Execute("PRAGMA query_only = ON");
+    {
+      bool ok = false;
+      sql::Statement check(db.GetUniqueStatement("PRAGMA quick_check"));
+      while (check.is_valid() && !cancelled_->load() && check.Step()) {
+        ok = check.ColumnString(0) == "ok";
+        if (!ok) break;
+      }
+      if (!ok || !check.Succeeded()) {
+        AddImportError(&errors, "cookies", "snapshot_corrupted",
+                       "The cookie database snapshot failed its integrity check.");
+        return CategoryResult(std::move(rows), std::move(errors));
+      }
+    }
+
+    bool has_top_frame = false;
+    bool has_cross_site = false;
+    {
+      sql::Statement col(db.GetUniqueStatement(
+          "PRAGMA table_info(cookies)"));
+      while (col.is_valid() && col.Step()) {
+        std::string name = col.ColumnString(1);
+        if (name == "top_frame_site_key")
+          has_top_frame = true;
+        else if (name == "has_cross_site_ancestor")
+          has_cross_site = true;
+      }
+    }
+
+    std::string extras;
+    if (has_top_frame)
+      extras += ", top_frame_site_key";
+    else
+      extras += ", NULL AS top_frame_site_key";
+    if (has_cross_site)
+      extras += ", has_cross_site_ancestor";
+    else
+      extras += ", NULL AS has_cross_site_ancestor";
+
+    std::string sql = base::StringPrintf(
+        "SELECT host_key, name, value, encrypted_value, path, expires_utc, "
+        "has_expires, is_secure, is_httponly, samesite%s "
+        "FROM cookies LIMIT ?",
+        extras.c_str());
+    sql::Statement stmt(db.GetUniqueStatement(sql));
+    if (!stmt.is_valid()) {
+      AddImportError(&errors, "cookies", "cookie_schema_unsupported", "The cookie database schema is not supported.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    stmt.BindInt64(0, static_cast<int64_t>(kMaxCookieRows) + 1);
+
+    int meta_version = 0;
+    {
+      if (db.DoesTableExist("meta")) {
+        sql::Statement meta(db.GetUniqueStatement(
+            "SELECT value FROM meta WHERE key = 'version' LIMIT 1"));
+        if (meta.is_valid() && meta.Step())
+          meta_version = meta.ColumnInt(0);
+      }
+    }
+
+    int row_count = 0;
+    int decryption_failures = 0;
+    int value_too_long = 0;
+    size_t memory_used = 0;
+    while (stmt.Step()) {
+      if (cancelled_->load()) {
+        AddImportError(&errors, "cookies", "cancelled",
+                       "The browser import was cancelled.");
+        break;
+      }
+      if (row_count >= kMaxCookieRows) {
+        int omitted = 1;
+        while (stmt.Step())
+          ++omitted;
+        AddImportError(&errors, "cookies", "cookie_row_limit",
+                       "The cookie database exceeds the configured row limit.",
+                       omitted);
+        break;
+      }
+      bool oversized = false;
+      for (int column : {0, 1, 2, 3, 4, 10})
+        oversized |= stmt.ColumnBlob(column).size() > kMaxStringValueLength + 64;
+      if (oversized) { ++value_too_long; continue; }
+      std::string domain = stmt.ColumnString(0);
+      std::string name = stmt.ColumnString(1);
+      std::string plain_value = stmt.ColumnString(2);
+      std::string encrypted_value = stmt.ColumnString(3);
+      std::string path_value = stmt.ColumnString(4);
+      int64_t expires_utc = stmt.ColumnInt64(5);
+      int has_expires_col = stmt.ColumnInt(6);
+      bool is_secure = stmt.ColumnBool(7);
+      bool is_httponly = stmt.ColumnBool(8);
+      int samesite = stmt.ColumnInt(9);
+      std::string top_frame;
+      bool has_top = false;
+      if (has_top_frame &&
+          stmt.GetColumnType(10) != sql::ColumnType::kNull) {
+        top_frame = stmt.ColumnString(10);
+        has_top = true;
+      }
+      bool has_cross = false;
+      bool cross_value = false;
+      if (has_cross_site &&
+          stmt.GetColumnType(11) != sql::ColumnType::kNull) {
+        cross_value = stmt.ColumnBool(11);
+        has_cross = true;
+      }
+
+      if (domain.empty() || !HostnameAllowed(domain, allowlist_))
+        continue;
+      if (name.empty())
+        continue;
+      if (path_value.empty())
+        path_value = "/";
+
+      if (!plain_value.empty()) {
+        // Plaintext value; no decryption needed.
+      } else if (!encrypted_value.empty()) {
+        std::string decrypted;
+        std::string code, message;
+        if (!DecryptSecret(encrypted_value, domain, true, meta_version,
+                           &decrypted, &code, &message)) {
+          if (code == "cancelled") {
+            AddImportError(&errors, "cookies", code, message);
+            break;
+          }
+          ++decryption_failures;
+          continue;
+        }
+        plain_value = std::move(decrypted);
+      } else {
+        continue;
+      }
+
+      if (plain_value.size() > kMaxStringValueLength) {
+        ++value_too_long;
+        continue;
+      }
+
+      base::DictValue cookie;
+      cookie.Set("domain", domain);
+      cookie.Set("path", path_value);
+      cookie.Set("name", name);
+      cookie.Set("value", plain_value);
+      cookie.Set("httpOnly", is_httponly);
+      cookie.Set("secure", is_secure);
+      cookie.Set("sameSite", SameSiteString(samesite));
+      if (has_expires_col != 0) {
+        std::optional<int64_t> exp = ChromeTimeToUnixMillis(expires_utc);
+        if (exp.has_value())
+          cookie.Set("expiresAt", static_cast<double>(*exp));
+      }
+      if (has_top && !top_frame.empty())
+        cookie.Set("topFrameSiteKey", top_frame);
+      if (has_cross)
+        cookie.Set("hasCrossSiteAncestor", cross_value);
+
+      memory_used += domain.size() + path_value.size() + name.size() +
+                     plain_value.size() + top_frame.size();
+      if (memory_used > kMaxCategoryMemoryBytes) {
+        AddImportError(&errors, "cookies", "cookie_memory_limit",
+                       "The cookie rows exceed the memory limit.");
+        break;
+      }
+      rows.Append(std::move(cookie));
+      ++row_count;
+    }
+
+    if (decryption_failures > 0) {
+      AddImportError(&errors, "cookies", "cookie_decryption_failed",
+                     "Some cookies could not be decrypted and were skipped.",
+                     decryption_failures);
+    }
+    if (value_too_long > 0) {
+      AddImportError(&errors, "cookies", "cookie_value_too_large",
+                     "Some cookie values exceeded the supported length.",
+                     value_too_long);
+    }
+    return CategoryResult(std::move(rows), std::move(errors));
+  }
+
+  base::DictValue ReadPasswords() {
+    base::ListValue rows;
+    base::ListValue errors;
+
+    base::FilePath login_db = selected_profile_path_.Append(
+        FILE_PATH_LITERAL("Login Data"));
+    if (!base::PathExists(login_db) || base::IsLink(login_db)) {
+      AddImportError(&errors, "passwords", "passwords_unavailable",
+                     "The profile has no readable login database.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    std::string error_code, error_message;
+    base::FilePath snapshot;
+    if (!SnapshotDatabase(login_db, &snapshot, &error_code, &error_message)) {
+      AddImportError(&errors, "passwords", error_code, error_message);
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    sql::Database db(
+        sql::DatabaseOptions{}
+            .set_read_only(true)
+            .set_exclusive_locking(false)
+            .set_mmap_enabled(false),
+        sql::Database::Tag("Passwords"));
+    if (!db.Open(snapshot)) {
+      AddImportError(&errors, "passwords", "snapshot_corrupted",
+                     "The login database snapshot could not be opened.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    (void)db.Execute("PRAGMA query_only = ON");
+    {
+      bool ok = false;
+      sql::Statement check(db.GetUniqueStatement("PRAGMA quick_check"));
+      while (check.is_valid() && !cancelled_->load() && check.Step()) {
+        ok = check.ColumnString(0) == "ok";
+        if (!ok) break;
+      }
+      if (!ok || !check.Succeeded()) {
+        AddImportError(&errors, "passwords", "snapshot_corrupted",
+                       "The login database snapshot failed its integrity check.");
+        return CategoryResult(std::move(rows), std::move(errors));
+      }
+    }
+
+    std::string blocked_filter;
+    {
+      sql::Statement col(db.GetUniqueStatement(
+          "PRAGMA table_info(logins)"));
+      while (col.is_valid() && col.Step()) {
+        std::string name = col.ColumnString(1);
+        if (name == "blocked_by_user" || name == "blacklisted_by_user")
+          blocked_filter = name + " = 0 AND ";
+      }
+    }
+
+    std::string sql = base::StringPrintf(
+        "SELECT origin_url, username_value, password_value FROM logins "
+        "WHERE %slength(password_value) > 0 LIMIT ?",
+        blocked_filter.c_str());
+    sql::Statement stmt(db.GetUniqueStatement(sql));
+    if (!stmt.is_valid()) {
+      AddImportError(&errors, "passwords", "login_schema_unsupported", "The login database schema is not supported.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    stmt.BindInt64(0, static_cast<int64_t>(kMaxLoginRows) + 1);
+
+    int row_count = 0;
+    int decryption_failures = 0;
+    int value_too_long = 0;
+    size_t memory_used = 0;
+    while (stmt.Step()) {
+      if (cancelled_->load()) {
+        AddImportError(&errors, "passwords", "cancelled",
+                       "The browser import was cancelled.");
+        break;
+      }
+      if (row_count >= kMaxLoginRows) {
+        int omitted = 1;
+        while (stmt.Step())
+          ++omitted;
+        AddImportError(&errors, "passwords", "login_row_limit",
+                       "The login database exceeds the configured row limit.",
+                       omitted);
+        break;
+      }
+      if (stmt.ColumnBlob(0).size() > kMaxStringValueLength ||
+          stmt.ColumnBlob(1).size() > kMaxStringValueLength ||
+          stmt.ColumnBlob(2).size() > kMaxStringValueLength + 64) {
+        ++value_too_long; continue;
+      }
+      std::string origin_url = stmt.ColumnString(0);
+      std::string username = stmt.ColumnString(1);
+      std::string encrypted = stmt.ColumnString(2);
+      if (origin_url.empty() || encrypted.empty())
+        continue;
+
+      std::string password;
+      std::string code, message;
+      if (!DecryptSecret(encrypted, std::string(), false, 0, &password, &code,
+                         &message)) {
+        if (code == "cancelled") {
+          AddImportError(&errors, "passwords", code, message);
+          break;
+        }
+        ++decryption_failures;
+        continue;
+      }
+      if (password.size() > kMaxStringValueLength) {
+        ++value_too_long;
+        continue;
+      }
+
+      base::DictValue row;
+      row.Set("originUrl", origin_url);
+      row.Set("username", username);
+      row.Set("password", password);
+      memory_used += origin_url.size() + username.size() + password.size();
+      if (memory_used > kMaxCategoryMemoryBytes) {
+        AddImportError(&errors, "passwords", "password_memory_limit",
+                       "The password rows exceed the memory limit.");
+        break;
+      }
+      rows.Append(std::move(row));
+      ++row_count;
+    }
+
+    if (decryption_failures > 0) {
+      AddImportError(&errors, "passwords", "password_decryption_failed",
+                     "Some saved passwords could not be decrypted and were skipped.",
+                     decryption_failures);
+    }
+    if (value_too_long > 0) {
+      AddImportError(&errors, "passwords", "password_value_too_large",
+                     "Some password values exceeded the supported length.",
+                     value_too_long);
+    }
+    return CategoryResult(std::move(rows), std::move(errors));
+  }
+
+  base::DictValue ReadHistory() {
+    base::ListValue rows;
+    base::ListValue errors;
+
+    base::FilePath history_db = selected_profile_path_.Append(
+        FILE_PATH_LITERAL("History"));
+    if (!base::PathExists(history_db) || base::IsLink(history_db)) {
+      AddImportError(&errors, "history", "history_unavailable",
+                     "The profile has no readable history database.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    std::string error_code, error_message;
+    base::FilePath snapshot;
+    if (!SnapshotDatabase(history_db, &snapshot, &error_code, &error_message)) {
+      AddImportError(&errors, "history", error_code, error_message);
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+
+    sql::Database db(
+        sql::DatabaseOptions{}
+            .set_read_only(true)
+            .set_exclusive_locking(false)
+            .set_mmap_enabled(false),
+        sql::Database::Tag("History"));
+    if (!db.Open(snapshot)) {
+      AddImportError(&errors, "history", "snapshot_corrupted",
+                     "The history database snapshot could not be opened.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    (void)db.Execute("PRAGMA query_only = ON");
+    {
+      bool ok = false;
+      sql::Statement check(db.GetUniqueStatement("PRAGMA quick_check"));
+      while (check.is_valid() && !cancelled_->load() && check.Step()) {
+        ok = check.ColumnString(0) == "ok";
+        if (!ok) break;
+      }
+      if (!ok || !check.Succeeded()) {
+        AddImportError(&errors, "history", "snapshot_corrupted",
+                       "The history database snapshot failed its integrity check.");
+        return CategoryResult(std::move(rows), std::move(errors));
+      }
+    }
+
+    sql::Statement stmt(db.GetUniqueStatement(
+        "SELECT u.url AS url, u.title AS title, v.visit_time AS visit_time "
+        "FROM visits v JOIN urls u ON u.id = v.url "
+        "ORDER BY v.visit_time ASC LIMIT ?"));
+    if (!stmt.is_valid()) {
+      AddImportError(&errors, "history", "history_schema_unsupported", "The history database schema is not supported.");
+      return CategoryResult(std::move(rows), std::move(errors));
+    }
+    stmt.BindInt64(0, static_cast<int64_t>(kMaxHistoryRows) + 1);
+
+    int row_count = 0;
+    int skipped = 0;
+    size_t memory_used = 0;
+    while (stmt.Step()) {
+      if (cancelled_->load()) {
+        AddImportError(&errors, "history", "cancelled",
+                       "The browser import was cancelled.");
+        break;
+      }
+      if (row_count >= kMaxHistoryRows) {
+        int omitted = 1;
+        while (stmt.Step())
+          ++omitted;
+        AddImportError(&errors, "history", "history_row_limit",
+                       "The history database exceeds the configured row limit.",
+                       omitted);
+        break;
+      }
+      if (stmt.ColumnBlob(0).size() > kMaxStringValueLength ||
+          stmt.ColumnBlob(1).size() > kMaxStringValueLength) {
+        ++skipped; continue;
+      }
+      std::string url = stmt.ColumnString(0);
+      std::string title = stmt.ColumnString(1);
+      int64_t visit_time = stmt.ColumnInt64(2);
+      std::optional<int64_t> visited_at = ChromeTimeToUnixMillis(visit_time);
+      if (url.empty() || !visited_at.has_value()) {
+        ++skipped;
+        continue;
+      }
+      if (title.empty())
+        title = url;
+      if (title.size() > 2048)
+        title.resize(2048);
+
+      base::DictValue row;
+      row.Set("url", url);
+      row.Set("title", title);
+      row.Set("visitedAt", static_cast<double>(*visited_at));
+      row.Set("source", "other");
+      memory_used += url.size() + title.size();
+      if (memory_used > kMaxCategoryMemoryBytes) {
+        AddImportError(&errors, "history", "history_memory_limit",
+                       "The history rows exceed the memory limit.");
+        break;
+      }
+      rows.Append(std::move(row));
+      ++row_count;
+    }
+
+    if (skipped > 0) {
+      AddImportError(&errors, "history", "history_rows_skipped",
+                     "Some history rows had no usable URL or timestamp.",
+                     skipped);
+    }
+    return CategoryResult(std::move(rows), std::move(errors));
+  }
