+    bool cookies = true;
+    bool passwords = true;
+    bool history = false;
+    bool extensions = false;
+  };
+
+  enum class TestError {
+    kNone,
+    kRequired,
+    kOutsideTarget,
+    kMockRequired,
+    kInvalidPath
+  };
+
+  TestError test_error_ = TestError::kNone;
+  base::FilePath target_profile_path_;
+  base::FilePath test_source_root_;
+  bool mock_keychain_ = false;
+  std::shared_ptr<std::atomic_bool> cancelled_;
+  std::string request_id_;
+  bool is_test_mode_ = false;
+
+  std::string selected_source_id_;
+  std::string selected_profile_id_;
+  base::FilePath selected_profile_path_;
+  std::string selected_family_;
+  bool prepared_ = false;
+  CategorySelection categories_;
+  std::vector<std::string> allowlist_;
+  bool allow_unverified_extensions_ = false;
+
+  SourceKeyState key_state_;
+
+#if BUILDFLAG(IS_MAC)
+  std::unique_ptr<klaus::browser_source::KeychainCancellation> keychain_cancel_;
+#endif
+
+  std::string job_nonce_;
+  base::FilePath import_staging_dir_;
+  base::FilePath extensions_staging_root_;
+  std::set<base::FilePath> staged_extensions_;
+  std::set<base::FilePath> retained_extensions_;
+  bool cleaned_up_ = false;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
