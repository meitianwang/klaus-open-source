+bool SourceRootSupportsEncryption(const std::string& family) {
+  return family == "chrome" || family == "chromium" || family == "edge";
+}
+
+bool IsValidProfileId(const std::string& id) {
+  if (id.empty() || id.size() > kMaxProfileIdLength)
+    return false;
+  if (id == "." || id == "..")
+    return false;
+  if (id.front() == '.')
+    return false;
+  for (char c : id) {
+    if (base::IsAsciiAlpha(c) || base::IsAsciiDigit(c))
+      continue;
+    if (c == ' ' || c == '.' || c == '_' || c == '-')
+      continue;
+    return false;
+  }
+  return true;
+}
+
+bool IsValidExtensionVersion(const std::string& version) {
+  if (version.empty() || version.size() > 64)
+    return false;
+  std::vector<std::string_view> parts = base::SplitStringPiece(
+      version, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.empty() || parts.size() > 8)
+    return false;
+  for (const auto& part : parts) {
+    if (part.empty())
+      return false;
+    for (char c : part) {
+      if (!base::IsAsciiDigit(c))
+        return false;
+    }
+    uint64_t unused = 0;
+    if (!base::StringToUint64(part, &unused))
+      return false;
+  }
+  return true;
+}
+
+int CompareExtensionVersion(const std::string& a, const std::string& b) {
+  std::vector<std::string_view> ap = base::SplitStringPiece(
+      a, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::vector<std::string_view> bp = base::SplitStringPiece(
+      b, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  size_t n = std::max(ap.size(), bp.size());
+  for (size_t i = 0; i < n; ++i) {
+    uint64_t av = 0;
+    uint64_t bv = 0;
+    if (i < ap.size())
+      base::StringToUint64(ap[i], &av);
+    if (i < bp.size())
+      base::StringToUint64(bp[i], &bv);
+    if (av != bv)
+      return av < bv ? -1 : 1;
+  }
+  return 0;
+}
+
+bool IsWithinRoot(const base::FilePath& root, const base::FilePath& candidate) {
+  return root == candidate || root.IsParent(candidate);
+}
+
+base::FilePath RealPathChecked(const base::FilePath& path) {
+  base::FilePath real = base::MakeAbsoluteFilePath(path);
+  if (real.empty())
+    return path;
+  return real;
+}
+
+base::FilePath WithSuffix(const base::FilePath& path,
+                          base::FilePath::StringType suffix) {
+  return base::FilePath(path.value() + suffix);
+}
+
+std::string SafeDisplayName(const base::Value* record, const std::string& fallback) {
+  if (!record)
+    return fallback;
+  const base::DictValue* dict = record->GetIfDict();
+  if (!dict)
+    return fallback;
+  for (const char* key : {"name", "gaia_name", "user_name"}) {
+    const std::string* value = dict->FindString(key);
+    if (value && !value->empty()) {
+      std::string trimmed = base::CollapseWhitespaceASCII(*value, true);
+      if (trimmed.size() > kMaxDisplayNameLength)
+        trimmed.resize(kMaxDisplayNameLength);
+      return trimmed;
+    }
+  }
+  return fallback;
+}
+
+base::DictValue ReadLocalState(const base::FilePath& root_real,
+                               std::string* error_code,
+                               std::string* error_message) {
+  base::FilePath path = root_real.Append(FILE_PATH_LITERAL("Local State"));
+  if (base::IsLink(path)) {
+    *error_code = "local_state_symlink_rejected";
+    *error_message = "The browser profile index is a symbolic link.";
+    return base::DictValue();
+  }
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info)) {
+    if (errno == EACCES || errno == EPERM) {
+      *error_code = "source_permission_denied";
+      *error_message = "The browser profile index could not be read.";
+    } else {
+      *error_code = "local_state_missing";
+      *error_message = "The browser profile index is missing or unreadable.";
+    }
+    return base::DictValue();
+  }
+  if (info.size <= 0 || static_cast<uint64_t>(info.size) > kMaxLocalStateBytes) {
+    *error_code = "local_state_too_large";
+    *error_message = "The browser profile index exceeds the supported size.";
+    return base::DictValue();
+  }
+  base::FilePath real = RealPathChecked(path);
+  if (!IsWithinRoot(root_real, real)) {
+    *error_code = "local_state_escape";
+    *error_message = "The browser profile index resolves outside the source root.";
+    return base::DictValue();
+  }
+  std::string raw;
+  errno = 0;
+  if (!base::ReadFileToStringWithMaxSize(real, &raw, kMaxLocalStateBytes)) {
+    *error_code = errno == EACCES || errno == EPERM
+        ? "source_permission_denied" : "local_state_unreadable";
+    *error_message = "The browser profile index could not be read.";
+    return base::DictValue();
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(raw, base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!parsed || !parsed->is_dict()) {
+    *error_code = "local_state_invalid";
+    *error_message = "The browser profile index is not valid JSON.";
+    return base::DictValue();
+  }
+  const base::DictValue* root_dict = parsed->GetIfDict();
+  const base::DictValue* profile_dict = root_dict->FindDict("profile");
+  return profile_dict ? profile_dict->Clone() : base::DictValue();
+}
+
+CookieDatabaseResolution ResolveCookieDatabase(
+    const base::FilePath& profile_real,
+    std::string* error_code,
+    std::string* error_message) {
+  base::FilePath network_dir = profile_real.Append(FILE_PATH_LITERAL("Network"));
+  if (base::PathExists(network_dir)) {
+    if (base::IsLink(network_dir)) {
+      *error_code = "cookie_database_symlink_rejected";
+      *error_message = "The Network cookie directory is a symbolic link.";
+      return {};
+    }
+    base::FilePath network_real = RealPathChecked(network_dir);
+    if (!IsWithinRoot(profile_real, network_real)) {
+      *error_code = "cookie_database_escape_rejected";
+      *error_message = "The Network cookie directory resolves outside the profile.";
+      return {};
+    }
+    base::FilePath db = network_real.Append(FILE_PATH_LITERAL("Cookies"));
+    if (base::PathExists(db)) {
+      if (base::IsLink(db)) {
+        *error_code = "cookie_database_symlink_rejected";
+        *error_message = "The Network cookie database is a symbolic link.";
+        return {};
+      }
+      base::FilePath db_real = RealPathChecked(db);
+      if (!IsWithinRoot(network_real, db_real)) {
+        *error_code = "cookie_database_escape_rejected";
+        *error_message = "The Network cookie database resolves outside the profile.";
+        return {};
+      }
+      return {db_real, true};
+    }
+  }
+  base::FilePath legacy = profile_real.Append(FILE_PATH_LITERAL("Cookies"));
+  if (base::PathExists(legacy)) {
+    if (base::IsLink(legacy)) {
+      *error_code = "cookie_database_symlink_rejected";
+      *error_message = "The legacy cookie database is a symbolic link.";
+      return {};
+    }
+    base::FilePath legacy_real = RealPathChecked(legacy);
+    if (!IsWithinRoot(profile_real, legacy_real)) {
+      *error_code = "cookie_database_escape_rejected";
+      *error_message = "The legacy cookie database resolves outside the profile.";
+      return {};
+    }
+    return {legacy_real, false};
+  }
+  return {};
+}
+
+std::optional<int64_t> ChromeTimeToUnixMillis(int64_t chrome_micros) {
+  if (chrome_micros <= kChromeEpochOffsetUs)
+    return std::nullopt;
+  int64_t ms = (chrome_micros - kChromeEpochOffsetUs) / 1000;
+  if (ms < 0 || ms > std::numeric_limits<int64_t>::max() / 2)
+    return std::nullopt;
+  return ms;
+}
+
+bool IsValidAllowlistHost(const std::string& raw) {
+  std::string entry = base::ToLowerASCII(base::CollapseWhitespaceASCII(raw, true));
+  if (entry.empty() || entry.size() > kMaxAllowlistHostLength)
+    return false;
+  bool wildcard = base::StartsWith(entry, "*.", base::CompareCase::SENSITIVE);
+  std::string host = wildcard ? entry.substr(2) : entry;
+  if (!host.empty() && host.front() == '.')
+    host = host.substr(1);
+  if (host.empty())
+    return false;
+  std::vector<std::string_view> labels = base::SplitStringPiece(
+      host, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (labels.empty())
+    return false;
+  for (const auto& label : labels) {
+    if (label.empty())
+      return false;
+    for (char c : label) {
+      if (!base::IsAsciiDigit(c) && !base::IsAsciiAlpha(c) && c != '-')
+        return false;
+    }
+  }
+  return true;
+}
+
+bool HostnameAllowed(const std::string& hostname,
+                     const std::vector<std::string>& allowlist) {
+  if (allowlist.empty())
+    return true;
+  std::string host = base::ToLowerASCII(hostname);
+  if (!host.empty() && host.front() == '.')
+    host.erase(host.begin());
+  if (host.empty())
+    return false;
+  for (const std::string& entry : allowlist) {
+    if (base::StartsWith(entry, "*.", base::CompareCase::SENSITIVE)) {
+      std::string base = entry.substr(2);
+      if (host == base || base::EndsWith(host, "." + base, base::CompareCase::SENSITIVE))
+        return true;
+    } else if (host == entry) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void AddDiscoveryError(base::ListValue* errors,
+                       const std::string& source_id,
+                       const std::string& code,
+                       const std::string& message) {
+  base::DictValue issue;
+  if (!source_id.empty())
+    issue.Set("sourceId", source_id);
+  else
+    issue.Set("sourceId", base::Value());
+  issue.Set("code", code);
+  issue.Set("message", message);
+  errors->Append(std::move(issue));
+}
+
+void AddImportError(base::ListValue* errors,
+                    const std::string& category,
+                    const std::string& code,
+                    const std::string& message,
+                    int count = 1) {
+  base::DictValue issue;
+  issue.Set("category", category);
+  issue.Set("code", code);
+  issue.Set("message", message);
+  if (count > 1)
+    issue.Set("count", count);
+  errors->Append(std::move(issue));
+}
+
+base::DictValue ErrorDict(const std::string& code,
+                          const std::string& message) {
+  base::DictValue error;
+  error.Set("category", "profile");
+  error.Set("code", code);
+  error.Set("message", message);
+  return error;
+}
+
+base::DictValue FailureDict(const std::string& code,
+                            const std::string& message) {
+  base::DictValue result;
+  result.Set("ok", false);
+  result.Set("error", ErrorDict(code, message));
+  return result;
+}
+
+base::DictValue CategoryResult(base::ListValue rows,
+                               base::ListValue errors) {
+  base::DictValue result;
+  result.Set("rows", std::move(rows));
+  result.Set("errors", std::move(errors));
+  return result;
+}
