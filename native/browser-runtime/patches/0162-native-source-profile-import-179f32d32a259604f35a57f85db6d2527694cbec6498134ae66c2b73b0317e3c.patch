+struct SourceKeyState {
+  bool ready = false;
+  bool failed = false;
+  unsigned char key[16] = {};
+  std::string failure_code;
+  std::string failure_message;
+};
+
+struct CookieDatabaseResolution {
+  base::FilePath path;
+  bool network = false;
+};
