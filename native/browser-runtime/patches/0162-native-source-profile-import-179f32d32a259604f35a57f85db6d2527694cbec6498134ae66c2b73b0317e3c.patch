+// Copyright (c) 2026 Electron contributors.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#ifndef ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_CRYPTO_MAC_H_
+#define ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_CRYPTO_MAC_H_
+
+#include <cstddef>
+#include <memory>
+#include <string>
+
+namespace klaus::browser_source {
+
+struct DecryptResult {
+  bool ok = false;
+  std::string code;
+  std::string message;
+  std::string plaintext;
+};
+
+// Owns the short-lived publication of the LAContext used by one reader's
+// keychain lookup. Cancel() may call InvalidatePendingKeychainAuthorization()
+// from another thread without holding the lock while SecItemCopyMatching runs.
+class KeychainCancellation {
+ public:
+  KeychainCancellation();
+  ~KeychainCancellation();
+
+  KeychainCancellation(const KeychainCancellation&) = delete;
+  KeychainCancellation& operator=(const KeychainCancellation&) = delete;
+
+ private:
+  struct State;
+  std::shared_ptr<State> state_;
+
+  friend bool GetSourceKeyPassword(const std::string& family,
+                                   KeychainCancellation* cancellation,
+                                   std::string* password,
+                                   std::string* code,
+                                   std::string* message);
+  friend void InvalidatePendingKeychainAuthorization(
+      KeychainCancellation* cancellation);
+};
+
+// Read the existing browser Safe Storage secret. This function never creates,
+// migrates, or rewrites a keychain item.
+bool GetSourceKeyPassword(const std::string& family,
+                          KeychainCancellation* cancellation,
+                          std::string* password,
+                          std::string* code,
+                          std::string* message);
+
+// Invalidate the keychain context currently published by this cancellation
+// object, if any. The call only touches the short-lived context publication.
+void InvalidatePendingKeychainAuthorization(
+    KeychainCancellation* cancellation);
+
+bool DeriveKey(const std::string& password, unsigned char key[16]);
+std::string Sha256(const std::string& value);
+DecryptResult DecryptV10(const std::string& ciphertext,
+                         const unsigned char key[16]);
+void Zeroize(void* data, std::size_t size);
+
+}  // namespace klaus::browser_source
+
+#endif  // ELECTRON_SHELL_BROWSER_API_NATIVE_BROWSER_SOURCE_CRYPTO_MAC_H_
diff --git a/shell/browser/api/native_browser_source_crypto_mac.mm b/shell/browser/api/native_browser_source_crypto_mac.mm
new file mode 100644
index 0000000000000000000000000000000000000000..8cbcc3b40f8b0078b64a9ece5667b0e5bc663080
--- /dev/null
+++ b/shell/browser/api/native_browser_source_crypto_mac.mm
@@ -0,0 +1,241 @@
+// Copyright (c) 2026 Electron contributors.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#include "shell/browser/api/native_browser_source_crypto_mac.h"
+
+#import <Foundation/Foundation.h>
+#import <LocalAuthentication/LocalAuthentication.h>
+#import <Security/Security.h>
+
+#include <CommonCrypto/CommonCrypto.h>
+#include <CommonCrypto/CommonKeyDerivation.h>
+
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string_view>
+#include <utility>
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace klaus::browser_source {
+namespace {
+
+constexpr unsigned char kSalt[] = {'s', 'a', 'l', 't', 'y', 's', 'a', 'l', 't'};
+constexpr std::uint32_t kIterations = 1003;
+constexpr std::size_t kKeyLength = kCCKeySizeAES128;
+constexpr char kV10Prefix[] = "v10";
+
+const std::array<unsigned char, kCCBlockSizeAES128> kIv = {
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+    ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ',
+};
+
+bool SourceCredentials(const std::string& family,
+                       std::string* service,
+                       std::string* account) {
+  if (family == "chrome") {
+    *service = "Chrome Safe Storage";
+    *account = "Chrome";
+    return true;
+  }
+  if (family == "chromium") {
+    *service = "Chromium Safe Storage";
+    *account = "Chromium";
+    return true;
+  }
+  if (family == "edge") {
+    *service = "Microsoft Edge Safe Storage";
+    *account = "Microsoft Edge";
+    return true;
+  }
+  return false;
+}
+
+DecryptResult Failure(const char* code, const char* message) {
+  DecryptResult result;
+  result.code = code;
+  result.message = message;
+  return result;
+}
+
+}  // namespace
+
+struct KeychainCancellation::State {
+  std::mutex mutex;
+  std::atomic_bool cancelled{false};
+  LAContext* __strong context = nil;
+};
+
+KeychainCancellation::KeychainCancellation()
+    : state_(std::make_shared<State>()) {}
+
+KeychainCancellation::~KeychainCancellation() {
+  InvalidatePendingKeychainAuthorization(this);
+}
+
+bool GetSourceKeyPassword(const std::string& family,
+                          KeychainCancellation* cancellation,
+                          std::string* password,
+                          std::string* code,
+                          std::string* message) {
+  std::string service;
+  std::string account;
+  if (!SourceCredentials(family, &service, &account)) {
+    *code = "unsupported_source";
+    *message = "The selected browser source is not supported.";
+    return false;
+  }
+
+  LAContext* authentication = [[LAContext alloc] init];
+  authentication.localizedReason =
+      @"Klaus needs the browser Safe Storage key to import the selected profile.";
+
+  if (cancellation && cancellation->state_) {
+    std::lock_guard<std::mutex> lock(cancellation->state_->mutex);
+    if (cancellation->state_->cancelled.load()) {
+      *code = "keychain_auth_cancelled";
+      *message = "The Keychain authorization was cancelled.";
+      return false;
+    }
+    cancellation->state_->context = authentication;
+  }
+
+  NSDictionary* query = @{
+    (__bridge id)kSecClass : (__bridge id)kSecClassGenericPassword,
+    (__bridge id)kSecAttrService :
+        [NSString stringWithUTF8String:service.c_str()],
+    (__bridge id)kSecAttrAccount :
+        [NSString stringWithUTF8String:account.c_str()],
+    (__bridge id)kSecReturnData : @YES,
+    (__bridge id)kSecMatchLimit : (__bridge id)kSecMatchLimitOne,
+    (__bridge id)kSecUseAuthenticationContext : authentication,
+  };
+
+  CFTypeRef result = nullptr;
+  const OSStatus status =
+      SecItemCopyMatching((__bridge CFDictionaryRef)query, &result);
+
+  // The context is published only while SecItemCopyMatching is running. The
+  // lock is never held across the blocking call itself.
+  if (cancellation && cancellation->state_) {
+    std::lock_guard<std::mutex> lock(cancellation->state_->mutex);
+    if (cancellation->state_->context == authentication)
+      cancellation->state_->context = nil;
+  }
+
+  if (status == errSecItemNotFound) {
+    *code = "keychain_item_not_found";
+    *message = "The browser Safe Storage key was not found.";
+    return false;
+  }
+  if (status == errSecUserCanceled) {
+    *code = "keychain_auth_cancelled";
+    *message = "The Keychain authorization was cancelled.";
+    return false;
+  }
+  if (status == errSecAuthFailed) {
+    *code = "keychain_auth_failed";
+    *message = "The Keychain authorization failed.";
+    return false;
+  }
+  if (status == errSecInteractionNotAllowed) {
+    *code = "keychain_interaction_not_allowed";
+    *message = "The Keychain requires user interaction that is not available.";
+    return false;
+  }
+  if (status != errSecSuccess || result == nullptr) {
+    *code = "keychain_error";
+    *message = "The browser Safe Storage key could not be read.";
+    if (result != nullptr)
+      CFRelease(result);
+    return false;
+  }
+
+  if (CFGetTypeID(result) != CFDataGetTypeID()) {
+    CFRelease(result);
+    *code = "keychain_item_invalid";
+    *message = "The browser Safe Storage item has an unsupported shape.";
+    return false;
+  }
+  NSData* data = (__bridge_transfer NSData*)result;
+  if (![data isKindOfClass:[NSData class]] || data.length == 0 ||
+      data.length > 256) {
+    *code = "keychain_item_invalid";
+    *message = "The browser Safe Storage item has an unsupported shape.";
+    return false;
+  }
+  password->assign(static_cast<const char*>(data.bytes), data.length);
+  return true;
+}
+
+void InvalidatePendingKeychainAuthorization(
+    KeychainCancellation* cancellation) {
+  if (!cancellation || !cancellation->state_)
+    return;
+  std::lock_guard<std::mutex> lock(cancellation->state_->mutex);
+  cancellation->state_->cancelled.store(true);
+  LAContext* context = cancellation->state_->context;
+  if (context)
+    [context invalidate];
+}
+
+bool DeriveKey(const std::string& password, unsigned char key[16]) {
+  if (password.empty() || password.size() > 256)
+    return false;
+  return CCKeyDerivationPBKDF(kCCPBKDF2, password.data(), password.size(),
+                              kSalt, sizeof(kSalt), kCCPRFHmacAlgSHA1,
+                              kIterations, key, kKeyLength) == kCCSuccess;
+}
+
+std::string Sha256(const std::string& value) {
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(value.data(), static_cast<CC_LONG>(value.size()), digest);
+  std::string encoded(reinterpret_cast<const char*>(digest), sizeof(digest));
+  Zeroize(digest, sizeof(digest));
+  return encoded;
+}
+
+DecryptResult DecryptV10(const std::string& ciphertext,
+                         const unsigned char key[16]) {
+  const std::size_t prefix_length = std::strlen(kV10Prefix);
+  if (ciphertext.size() < prefix_length ||
+      ciphertext.compare(0, prefix_length, kV10Prefix) != 0) {
+    return Failure("unsupported_encryption",
+                   "Only Chromium v10 encryption is supported on macOS.");
+  }
+  const std::size_t encrypted_length = ciphertext.size() - prefix_length;
+  if (encrypted_length == 0) {
+    DecryptResult result;
+    result.ok = true;
+    return result;
+  }
+  if (encrypted_length % kCCBlockSizeAES128 != 0)
+    return Failure("invalid_ciphertext", "The encrypted value has an invalid length.");
+
+  std::string plaintext(encrypted_length + kCCBlockSizeAES128, '\0');
+  std::size_t plaintext_length = 0;
+  const CCCryptorStatus status = CCCrypt(
+      kCCDecrypt, kCCAlgorithmAES128, kCCOptionPKCS7Padding, key, kKeyLength,
+      kIv.data(), std::string_view(ciphertext).substr(prefix_length).data(), encrypted_length,
+      plaintext.data(), plaintext.size(), &plaintext_length);
+  if (status != kCCSuccess) {
+    Zeroize(plaintext.data(), plaintext.size());
+    return Failure("decryption_failed",
+                   "The encrypted value could not be decrypted.");
+  }
+  plaintext.resize(plaintext_length);
+  DecryptResult result;
+  result.ok = true;
+  result.plaintext = std::move(plaintext);
+  return result;
+}
+
+void Zeroize(void* data, std::size_t size) {
+  if (!data || size == 0)
+    return;
+  OPENSSL_cleanse(data, size);
+}
+
+}  // namespace klaus::browser_source
