+
+base::DictValue EmptyCounts() {
+  base::DictValue counts;
+  for (const auto* category : {"cookies", "passwords", "history", "extensions"})
+    counts.Set(category, 0);
+  return counts;
+}
+
+base::DictValue Issue(const std::string& category, const std::string& code,
+                      const std::string& message, int count = 0) {
+  base::DictValue issue;
+  issue.Set("category", category);
+  issue.Set("code", code);
+  issue.Set("message", message.substr(0, 1024));
+  if (count > 0) issue.Set("count", count);
+  return issue;
+}
+
+class SourceWork final : public base::RefCountedThreadSafe<SourceWork> {
+ public:
+  SourceWork(base::FilePath profile, base::FilePath test_root, bool mock,
+             std::string request_id)
+      : cancelled(std::make_shared<std::atomic_bool>(false)),
+        profile_(std::move(profile)), test_root_(std::move(test_root)), mock_(mock),
+        request_id_(std::move(request_id)) {}
+
+  base::DictValue List() { auto result = Reader()->ListProfiles(); Close(); return result; }
+  base::DictValue Prepare(base::DictValue request) { return Reader()->Prepare(request); }
+  base::DictValue Read(std::string category) { return Reader()->ReadCategory(category); }
+  void Retain(base::FilePath path) { Reader()->RetainExtension(path); }
+  void Cancel() {
+    cancelled->store(true);
+    std::lock_guard<std::mutex> lock(reader_mutex_);
+    if (reader_) reader_->Cancel();
+  }
+  void Close() {
+    std::unique_ptr<NativeBrowserSourceReader> reader;
+    { std::lock_guard<std::mutex> lock(reader_mutex_); reader = std::move(reader_); }
+    if (reader) reader->Cleanup();
+  }
+  std::shared_ptr<std::atomic_bool> cancelled;
+
+ private:
+  friend class base::RefCountedThreadSafe<SourceWork>;
+  ~SourceWork() = default;
+  NativeBrowserSourceReader* Reader() {
+    std::lock_guard<std::mutex> lock(reader_mutex_);
+    if (!reader_) reader_ = std::make_unique<NativeBrowserSourceReader>(
+        profile_, test_root_, mock_, cancelled, request_id_);
+    return reader_.get();
+  }
+  base::FilePath profile_;
+  base::FilePath test_root_;
+  bool mock_;
+  std::string request_id_;
+  std::mutex reader_mutex_;
+  std::unique_ptr<NativeBrowserSourceReader> reader_;
+};
+
+class SourceJob final : public base::RefCountedThreadSafe<SourceJob> {
+ public:
+  SourceJob(std::string id, gin_helper::Promise<base::DictValue> promise,
+            scoped_refptr<SourceWork> work)
+      : id(std::move(id)), promise(std::make_unique<gin_helper::Promise<base::DictValue>>(std::move(promise))),
+        work(std::move(work)), counts(EmptyCounts()) {}
+  std::string id;
+  std::unique_ptr<gin_helper::Promise<base::DictValue>> promise;
+  scoped_refptr<SourceWork> work;
+  base::DictValue request;
+  base::DictValue counts;
+  base::ListValue errors;
+  std::vector<std::string> categories;
+  size_t category = 0;
+  size_t offset = 0;
+  base::ListValue rows;
+  base::ListValue batch;
+  std::string child_id;
+  bool closing = false;
+ private:
+  friend class base::RefCountedThreadSafe<SourceJob>;
+  ~SourceJob() = default;
+};
+}  // namespace
+
+class NativeBrowserSourceImporter::Impl final : public base::RefCounted<Impl> {
+ public:
+  Impl(Profile* profile, NativeBrowserImport* writer, HistoryApplied history)
+      : writer_(writer), history_(std::move(history)), profile_path_(profile->GetPath()),
+        keep_alive_(ScopedProfileKeepAlive::TryAcquire(profile, ProfileKeepAliveOrigin::kEmbedderService)),
+        io_(base::ThreadPool::CreateSequencedTaskRunner(
+            {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+             base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})) {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    mock_ = command->HasSwitch("use-mock-keychain");
+    test_root_ = command->GetSwitchValuePath("native-browser-import-test-root");
+    if (!keep_alive_) closed_ = true;
+    if (!test_root_.empty() && (!mock_ || !test_root_.IsAbsolute() ||
+        test_root_.ReferencesParent() || !profile_path_.DirName().IsParent(test_root_)))
+      test_root_rejected_ = true;
+  }
+
+  v8::Local<v8::Promise> List(v8::Isolate* isolate, const std::string& id) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    auto job = Create(id, std::move(promise));
+    if (!job) return handle;
+    auto done = base::BindOnce(&Impl::OnListed, base::RetainedRef(this), job);
+    io_->PostTaskAndReplyWithResult(FROM_HERE,
+        base::BindOnce(&SourceWork::List, job->work), std::move(done));
+    return handle;
+  }
+
+  v8::Local<v8::Promise> Import(v8::Isolate* isolate, const std::string& id,
+                                const base::DictValue& request) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    if (!active_import_.empty()) {
+      promise.RejectWithErrorMessage("A browser source import is already active");
+      return handle;
+    }
+    auto job = Create(id, std::move(promise));
+    if (!job) return handle;
+    job->request = request.Clone();
+    if (request.Find("categories") && !request.FindDict("categories")) {
+      job->errors.Append(Issue("profile", "invalid_request", "Import categories must be an object"));
+      Complete(job); return handle;
+    }
+    const auto* selection = request.FindDict("categories");
+    for (const auto* category : {"cookies", "passwords", "history", "extensions"}) {
+      const bool default_value = std::string(category) == "cookies" || std::string(category) == "passwords";
+      const base::Value* value = selection ? selection->Find(category) : nullptr;
+      if (value && !value->is_bool()) {
+        job->errors.Append(Issue("profile", "invalid_request", "Import categories must be boolean"));
+        Complete(job); return handle;
+      }
+      if (value ? value->GetBool() : default_value) job->categories.emplace_back(category);
+    }
+    if (job->categories.empty()) {
+      job->errors.Append(Issue("profile", "invalid_request", "Select at least one import category"));
+      Complete(job); return handle;
+    }
+    active_import_ = id;
+    io_->PostTaskAndReplyWithResult(FROM_HERE,
+        base::BindOnce(&SourceWork::Prepare, job->work, request.Clone()),
+        base::BindOnce(&Impl::OnPrepared, base::RetainedRef(this), job));
+    return handle;
+  }
+
+  void Cancel(const std::string& id) {
+    auto found = jobs_.find(id);
+    if (found == jobs_.end()) return;
+    auto job = found->second;
+    job->work->Cancel();
+    if (writer_ && !job->child_id.empty()) writer_->Cancel(job->child_id);
+  }
+
+  void Dispose() {
+    if (closed_) return;
+    closed_ = true;
+    for (const auto& [id, job] : jobs_) {
+      job->work->Cancel();
+      if (writer_ && !job->child_id.empty()) writer_->Cancel(job->child_id);
+    }
+    writer_ = nullptr;
+    if (jobs_.empty()) keep_alive_.reset();
+  }
+
+ private:
+  scoped_refptr<SourceJob> Create(const std::string& id,
+                                  gin_helper::Promise<base::DictValue> promise) {
+    if (closed_ || test_root_rejected_ || id.empty() || id.size() > 128 ||
+        jobs_.contains(id) || jobs_.size() >= 16) {
+      promise.RejectWithErrorMessage(test_root_rejected_
+          ? "The synthetic browser source must belong to the mock native Profile"
+          : "A live native Profile and unique bounded import request are required");
+      return nullptr;
+    }
+    auto work = base::MakeRefCounted<SourceWork>(profile_path_, test_root_, mock_, id);
+    auto job = base::MakeRefCounted<SourceJob>(id, std::move(promise), std::move(work));
+    jobs_.emplace(id, job);
+    return job;
+  }
+
+  void OnListed(scoped_refptr<SourceJob> job, base::DictValue result) {
+    jobs_.erase(job->id);
+    if (job->promise) job->promise->Resolve(result);
+    job->promise.reset();
+    if (closed_ && jobs_.empty()) keep_alive_.reset();
+  }
+
+  void OnPrepared(scoped_refptr<SourceJob> job, base::DictValue result) {
+    if (!result.FindBool("ok").value_or(false)) {
+      if (auto* error = result.FindDict("error")) job->errors.Append(error->Clone());
+      else job->errors.Append(Issue("profile", "source_unavailable", "The selected browser profile is unavailable"));
+      Complete(job); return;
+    }
+    ReadNext(job);
+  }
+
+  void ReadNext(scoped_refptr<SourceJob> job) {
+    if (closed_ || job->work->cancelled->load() || job->category >= job->categories.size()) {
+      Complete(job); return;
+    }
+    io_->PostTaskAndReplyWithResult(FROM_HERE,
+        base::BindOnce(&SourceWork::Read, job->work, job->categories[job->category]),
+        base::BindOnce(&Impl::OnRows, base::RetainedRef(this), job));
+  }
+
+  void OnRows(scoped_refptr<SourceJob> job, base::DictValue result) {
+    if (auto* errors = result.FindList("errors")) {
+      for (auto& error : *errors) if (job->errors.size() < 128) job->errors.Append(std::move(error));
+    }
+    job->rows = base::ListValue();
+    if (auto* rows = result.FindList("rows")) job->rows = std::move(*rows);
+    job->offset = 0;
+    WriteNext(job);
+  }
+
+  void WriteNext(scoped_refptr<SourceJob> job) {
+    if (closed_ || job->work->cancelled->load()) { Complete(job); return; }
+    if (job->offset >= job->rows.size()) {
+      job->rows.clear(); job->batch.clear(); ++job->category; ReadNext(job); return;
+    }
+    const std::string category = job->categories[job->category];
+    if (category == "extensions") { WriteExtension(job); return; }
+    job->batch.clear();
+    const size_t end = std::min(job->offset + 250, job->rows.size());
+    for (size_t index = job->offset; index < end; ++index) job->batch.Append(job->rows[index].Clone());
+    job->child_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    writer_->ApplyRows(category, job->child_id, job->batch,
+        base::BindOnce(&Impl::OnApplied, base::RetainedRef(this), job));
+  }
+
+  void OnApplied(scoped_refptr<SourceJob> job, base::DictValue result) {
+    job->child_id.clear();
+    const std::string category = job->categories[job->category];
+    const int applied = result.FindInt("applied").value_or(-1);
+    if (applied < 0 || static_cast<size_t>(applied) > job->batch.size()) {
+      job->errors.Append(Issue(category, "invalid_target_result", "The native store returned an invalid import receipt"));
+      Complete(job); return;
+    }
+    job->counts.Set(category, job->counts.FindInt(category).value_or(0) + applied);
+    if (category == "history" && applied > 0 && history_) {
+      base::ListValue confirmed;
+      for (int index = 0; index < applied; ++index) confirmed.Append(job->batch[index].Clone());
+      history_.Run(job->id, confirmed);
+    }
+    if (result.FindBool("cancelled").value_or(false)) {
+      job->work->Cancel();
+      Complete(job);
+      return;
+    }
+    const std::string* error = result.FindString("error");
+    const bool partial = static_cast<size_t>(applied) != job->batch.size();
+    if (partial || error) {
+      job->errors.Append(Issue(category, "apply_" + category + "_partial",
+          error ? *error : "Some rows were not confirmed by the native store",
+          static_cast<int>(job->rows.size() - job->offset - applied)));
+      job->offset = job->rows.size();
+    } else job->offset += job->batch.size();
+    job->batch.clear();
+    WriteNext(job);
+  }
+
+  void WriteExtension(scoped_refptr<SourceJob> job) {
+    const auto* row = job->rows[job->offset].GetIfDict();
+    const std::string* path_text = row ? row->FindString("path") : nullptr;
+    const auto path = path_text ? base::FilePath::FromUTF8Unsafe(*path_text) : base::FilePath();
+    if (path.empty() || !path.IsAbsolute() || path.ReferencesParent() ||
+        !profile_path_.AppendASCII("ImportedExtensions").IsParent(path)) {
+      job->errors.Append(Issue("extensions", "extension_path_rejected", "The extension staging path is outside the native Profile"));
+      ++job->offset; WriteNext(job); return;
+    }
+    writer_->InstallExtension(path, base::BindOnce(&Impl::OnExtension,
+        base::RetainedRef(this), job, path));
+  }
+
+  void OnExtension(scoped_refptr<SourceJob> job, base::FilePath path,
+                    base::DictValue result) {
+    const std::string* installed = result.FindString("id");
+    if (installed && installed->size() == 32 &&
+        std::ranges::all_of(*installed, [](char ch) { return ch >= 'a' && ch <= 'p'; })) {
+      job->counts.Set("extensions", job->counts.FindInt("extensions").value_or(0) + 1);
+      io_->PostTask(FROM_HERE, base::BindOnce(&SourceWork::Retain, job->work, path));
+      const auto& expected = job->rows[job->offset].GetDict();
+      const auto* expected_id = expected.FindString("id");
+      if (expected.FindBool("idVerified").value_or(false) && expected_id && *expected_id != *installed)
+        job->errors.Append(Issue("extensions", "extension_id_mismatch", "The installed extension identifier did not match the verified manifest"));
+    } else job->errors.Append(Issue("extensions", "extension_install_failed", "The native extension installer did not confirm installation"));
+    ++job->offset; WriteNext(job);
+  }
+
+  void Complete(scoped_refptr<SourceJob> job) {
+    if (job->closing) return;
+    job->closing = true;
+    job->rows.clear(); job->batch.clear();
+    io_->PostTaskAndReply(FROM_HERE, base::BindOnce(&SourceWork::Close, job->work),
+        base::BindOnce(&Impl::Finish, base::RetainedRef(this), job));
+  }
+
+  void Finish(scoped_refptr<SourceJob> job) {
+    const bool cancelled = job->work->cancelled->load();
+    if (cancelled) job->errors.Append(Issue("profile", "cancelled", "The browser import was cancelled"));
+    base::DictValue result;
+    result.Set("ok", !cancelled && job->errors.empty());
+    result.Set("cancelled", cancelled);
+    const auto* source = job->request.FindString("sourceId");
+    const auto* profile = job->request.FindString("profileId");
+    result.Set("sourceId", source ? *source : std::string());
+    result.Set("profileId", profile ? *profile : std::string());
+    result.Set("counts", std::move(job->counts));
+    result.Set("errors", std::move(job->errors));
+    jobs_.erase(job->id);
+    if (active_import_ == job->id) active_import_.clear();
+    if (job->promise) job->promise->Resolve(result);
+    job->promise.reset();
+    if (closed_ && jobs_.empty()) keep_alive_.reset();
+  }
+
+  friend class base::RefCounted<Impl>;
+  ~Impl() { Dispose(); }
+  raw_ptr<NativeBrowserImport> writer_;
+  HistoryApplied history_;
+  base::FilePath profile_path_;
+  base::FilePath test_root_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  scoped_refptr<base::SequencedTaskRunner> io_;
+  bool mock_ = false;
+  bool closed_ = false;
+  bool test_root_rejected_ = false;
+  std::string active_import_;
+  std::map<std::string, scoped_refptr<SourceJob>> jobs_;
+};
+
+NativeBrowserSourceImporter::NativeBrowserSourceImporter(
+    Profile* profile, NativeBrowserImport* writer, HistoryApplied history)
+    : impl_(base::MakeRefCounted<Impl>(profile, writer, std::move(history))) {}
+NativeBrowserSourceImporter::~NativeBrowserSourceImporter() { impl_->Dispose(); }
+v8::Local<v8::Promise> NativeBrowserSourceImporter::ListProfiles(v8::Isolate* isolate, const std::string& id) { return impl_->List(isolate, id); }
+v8::Local<v8::Promise> NativeBrowserSourceImporter::ImportProfile(v8::Isolate* isolate, const std::string& id, const base::DictValue& request) { return impl_->Import(isolate, id, request); }
+void NativeBrowserSourceImporter::Cancel(const std::string& id) { impl_->Cancel(id); }
+void NativeBrowserSourceImporter::Dispose() { impl_->Dispose(); }
+}  // namespace electron::api
