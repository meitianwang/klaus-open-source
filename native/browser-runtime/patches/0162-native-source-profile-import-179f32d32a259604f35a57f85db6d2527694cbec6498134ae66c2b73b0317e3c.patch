+base::DictValue NativeBrowserSourceReader::ReadCategory(
+    const std::string& category) {
+  return impl_->ReadCategory(category);
+}
+
+void NativeBrowserSourceReader::Cancel() {
+  impl_->Cancel();
+}
+
+void NativeBrowserSourceReader::RetainExtension(const base::FilePath& path) {
+  impl_->RetainExtension(path);
+}
+
+void NativeBrowserSourceReader::Cleanup() {
+  impl_->Cleanup();
+}
