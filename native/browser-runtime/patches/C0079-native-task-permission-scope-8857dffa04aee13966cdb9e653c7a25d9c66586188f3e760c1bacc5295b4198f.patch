@@ -470,7 +472,54 @@ content::PermissionResult PermissionContextBase::GetPermissionStatus(
   auto permission_status =
       resolver.DeterminePermissionStatus(retrieved_permission_data);
 
+  // Native host pages may carry a task-scoped decision for this exact
+  // WebContents, requesting origin, embedding origin and permission. The scope
+  // is consulted only after the native origin, permissions-policy and
+  // persistent-setting checks above. A host ALLOW may only elevate ASK; a host
+  // DENY may tighten ASK or GRANTED. Native DENIED results stay DENIED.
+  std::optional<HostPermissionScope::Setting> host_setting;
+  if (render_frame_host) {
+    content::WebContents* web_contents =
+        content::WebContents::FromRenderFrameHost(render_frame_host);
+    if (web_contents) {
+      if (auto* scope = HostPermissionScope::FromWebContents(web_contents)) {
+        host_setting =
+            scope->Get(url::Origin::Create(requesting_origin),
+                       url::Origin::Create(embedding_origin),
+                       content_settings_type_);
+      }
+    }
+  }
+
+  const content_settings::PermissionSettingsInfo* permission_settings_info =
+      content_settings::PermissionSettingsRegistry::GetInstance()->Get(
+          content_settings_type_);
+
+  // Temporary host decisions must carry a PermissionSetting that agrees with
+  // the returned status. The registry delegate preserves permission-specific
+  // metadata (notably GeolocationSetting options) instead of reusing the ASK
+  // state that produced the original result.
+  auto host_permission_result =
+      [&](PermissionStatus status,
+          ContentSetting content_setting) -> std::optional<content::PermissionResult> {
+    if (!permission_settings_info)
+      return std::nullopt;
+    PermissionSetting setting =
+        permission_settings_info->delegate().ToPermissionSetting(
+            content_setting);
+    if (resolver.DeterminePermissionStatus(setting) != status)
+      return std::nullopt;
+    return content::PermissionResult(
+        status, content::PermissionStatusSource::UNSPECIFIED, setting);
+  };
+
   if (permission_status != PermissionStatus::ASK) {
+    if (host_setting == HostPermissionScope::Setting::kDeny) {
+      if (auto result = host_permission_result(PermissionStatus::DENIED,
+                                               CONTENT_SETTING_BLOCK)) {
+        return *result;
+      }
+    }
     return content::PermissionResult(
         permission_status, content::PermissionStatusSource::UNSPECIFIED,
         retrieved_permission_data);
@@ -486,6 +535,19 @@ content::PermissionResult PermissionContextBase::GetPermissionStatus(
       return std::move(result).value();
     }
   }
+
+  if (host_setting == HostPermissionScope::Setting::kDeny) {
+    if (auto result = host_permission_result(PermissionStatus::DENIED,
+                                             CONTENT_SETTING_BLOCK)) {
+      return *result;
+    }
+  } else if (host_setting == HostPermissionScope::Setting::kAllow) {
+    if (auto result = host_permission_result(PermissionStatus::GRANTED,
+                                             CONTENT_SETTING_ALLOW)) {
+      return *result;
+    }
+  }
+
   return content::PermissionResult(PermissionStatus::ASK,
                                    content::PermissionStatusSource::UNSPECIFIED,
                                    retrieved_permission_data);
