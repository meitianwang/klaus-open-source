@@ -0,0 +1,150 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/permissions/host_permission_scope.h"
+
+#include <utility>
+#include <vector>
+
+#include "content/public/browser/web_contents.h"
+
+namespace permissions {
+
+namespace {
+
+ContentSettingsType NormalizeType(ContentSettingsType type) {
+  // The geolocation context can use either entry point, but both must share
+  // the same host-scoped decision.
+  return type == ContentSettingsType::GEOLOCATION_WITH_OPTIONS
+             ? ContentSettingsType::GEOLOCATION
+             : type;
+}
+
+}  // namespace
+
+// static
+bool HostPermissionScope::IsSupported(ContentSettingsType type) {
+  switch (NormalizeType(type)) {
+    case ContentSettingsType::GEOLOCATION:
+    case ContentSettingsType::NOTIFICATIONS:
+    case ContentSettingsType::MEDIASTREAM_CAMERA:
+    case ContentSettingsType::MEDIASTREAM_MIC:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// static
+HostPermissionScope* HostPermissionScope::FromWebContents(
+    content::WebContents* contents) {
+  if (!contents)
+    return nullptr;
+  return content::WebContentsUserData<HostPermissionScope>::FromWebContents(
+      contents);
+}
+
+// static
+HostPermissionScope* HostPermissionScope::GetOrCreateForWebContents(
+    content::WebContents* contents,
+    ChangeCallback on_changed) {
+  CHECK(contents);
+  HostPermissionScope* scope = FromWebContents(contents);
+  if (!scope) {
+    content::WebContentsUserData<HostPermissionScope>::CreateForWebContents(
+        contents);
+    scope = FromWebContents(contents);
+  }
+  scope->on_changed_ = std::move(on_changed);
+  return scope;
+}
+
+HostPermissionScope::HostPermissionScope(content::WebContents* contents)
+    : content::WebContentsUserData<HostPermissionScope>(*contents) {}
+
+HostPermissionScope::~HostPermissionScope() = default;
+
+bool HostPermissionScope::Key::operator<(const Key& other) const {
+  if (requesting_origin != other.requesting_origin)
+    return requesting_origin < other.requesting_origin;
+  if (embedding_origin != other.embedding_origin)
+    return embedding_origin < other.embedding_origin;
+  return type < other.type;
+}
+
+bool HostPermissionScope::Set(const url::Origin& requesting_origin,
+                              const url::Origin& embedding_origin,
+                              ContentSettingsType type,
+                              Setting setting) {
+  if (!IsSupported(type))
+    return false;
+
+  const ContentSettingsType normalized_type = NormalizeType(type);
+  const Key key{requesting_origin, embedding_origin, normalized_type};
+  const auto existing = settings_.find(key);
+  if (existing != settings_.end() && existing->second == setting)
+    return true;
+
+  settings_[key] = setting;
+  if (!on_changed_.is_null()) {
+    on_changed_.Run(requesting_origin, embedding_origin, normalized_type);
+  }
+  return true;
+}
+
+size_t HostPermissionScope::Reset(
+    std::optional<url::Origin> requesting_origin,
+    std::optional<url::Origin> embedding_origin,
+    std::optional<ContentSettingsType> type) {
+  if (type.has_value() && !IsSupported(*type))
+    return 0;
+
+  const std::optional<ContentSettingsType> normalized_type =
+      type.has_value() ? std::optional<ContentSettingsType>(NormalizeType(*type))
+                       : std::nullopt;
+
+  std::vector<std::pair<url::Origin, url::Origin>> changed_origins;
+  std::vector<ContentSettingsType> changed_types;
+  for (auto it = settings_.begin(); it != settings_.end();) {
+    if ((!requesting_origin ||
+         it->first.requesting_origin == *requesting_origin) &&
+        (!embedding_origin ||
+         it->first.embedding_origin == *embedding_origin) &&
+        (!normalized_type || it->first.type == *normalized_type)) {
+      changed_origins.emplace_back(it->first.requesting_origin,
+                                   it->first.embedding_origin);
+      changed_types.push_back(it->first.type);
+      it = settings_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  if (!on_changed_.is_null()) {
+    for (size_t i = 0; i < changed_types.size(); ++i) {
+      on_changed_.Run(changed_origins[i].first, changed_origins[i].second,
+                      changed_types[i]);
+    }
+  }
+  return changed_types.size();
+}
+
+std::optional<HostPermissionScope::Setting> HostPermissionScope::Get(
+    const url::Origin& requesting_origin,
+    const url::Origin& embedding_origin,
+    ContentSettingsType type) const {
+  if (!IsSupported(type))
+    return std::nullopt;
+
+  const auto it =
+      settings_.find(Key{requesting_origin, embedding_origin,
+                         NormalizeType(type)});
+  if (it == settings_.end())
+    return std::nullopt;
+  return it->second;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(HostPermissionScope);
+
+}  // namespace permissions
