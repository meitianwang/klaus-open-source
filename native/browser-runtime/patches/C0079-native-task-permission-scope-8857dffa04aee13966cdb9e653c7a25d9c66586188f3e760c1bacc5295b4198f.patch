+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_PERMISSIONS_HOST_PERMISSION_SCOPE_H_
+#define COMPONENTS_PERMISSIONS_HOST_PERMISSION_SCOPE_H_
+
+#include <optional>
+
+#include "base/containers/flat_map.h"
+#include "base/functional/callback.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/origin.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace permissions {
+
+// A native-host-owned, page-scoped permission override. It is installed only
+// for WebContents explicitly registered by the native host; its absence has no
+// effect on Chromium's normal permission path.
+class HostPermissionScope
+    : public content::WebContentsUserData<HostPermissionScope> {
+ public:
+  enum class Setting { kAllow, kDeny };
+
+  using ChangeCallback = base::RepeatingCallback<void(
+      const url::Origin& requesting_origin,
+      const url::Origin& embedding_origin,
+      ContentSettingsType type)>;
+
+  HostPermissionScope(const HostPermissionScope&) = delete;
+  HostPermissionScope& operator=(const HostPermissionScope&) = delete;
+
+  ~HostPermissionScope() override;
+
+  static HostPermissionScope* FromWebContents(content::WebContents* contents);
+
+  static HostPermissionScope* GetOrCreateForWebContents(
+      content::WebContents* contents,
+      ChangeCallback on_changed);
+
+  // Returns false for permissions outside the supported native host set.
+  bool Set(const url::Origin& requesting_origin,
+           const url::Origin& embedding_origin,
+           ContentSettingsType type,
+           Setting setting);
+
+  // Removes matching entries. Null origin/type means "match all" for that
+  // field. Returns the number of removed entries.
+  size_t Reset(std::optional<url::Origin> requesting_origin,
+               std::optional<url::Origin> embedding_origin,
+               std::optional<ContentSettingsType> type);
+
+  std::optional<Setting> Get(const url::Origin& requesting_origin,
+                             const url::Origin& embedding_origin,
+                             ContentSettingsType type) const;
+
+  static bool IsSupported(ContentSettingsType type);
+
+ private:
+  friend class content::WebContentsUserData<HostPermissionScope>;
+
+  explicit HostPermissionScope(content::WebContents* contents);
+
+  struct Key {
+    url::Origin requesting_origin;
+    url::Origin embedding_origin;
+    ContentSettingsType type;
+
+    bool operator<(const Key& other) const;
+  };
+
+  base::flat_map<Key, Setting> settings_;
+  ChangeCallback on_changed_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace permissions
+
+#endif  // COMPONENTS_PERMISSIONS_HOST_PERMISSION_SCOPE_H_
