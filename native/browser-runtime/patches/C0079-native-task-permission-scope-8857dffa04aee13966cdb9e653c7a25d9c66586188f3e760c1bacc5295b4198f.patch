   return result;
 }
 
+void PermissionManager::NotifyHostPermissionScopeChanged(
+    const url::Origin& requesting_origin,
+    const url::Origin& embedding_origin,
+    ContentSettingsType type) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  // Scope the notification to the exact origin pair. OnPermissionChanged()
+  // recomputes each matching subscription but only invokes its callback when
+  // the resulting status or retrieved setting actually changed, so a sibling
+  // WebContents on the same origin with an unchanged result is not notified.
+  OnPermissionChanged(
+      ContentSettingsPattern::FromURLNoWildcard(requesting_origin.GetURL()),
+      ContentSettingsPattern::FromURLNoWildcard(embedding_origin.GetURL()),
+      ContentSettingsTypeSet(type));
+}
+
 }  // namespace permissions
