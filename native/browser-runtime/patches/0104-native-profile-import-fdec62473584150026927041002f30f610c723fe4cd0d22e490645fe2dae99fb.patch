+class NativeBrowserImport::Impl : public base::RefCounted<NativeBrowserImport::Impl> {
+ public:
+  explicit Impl(Profile* profile) : profile_(profile) {}
+  ~Impl() { Dispose(); }
+
+  v8::Local<v8::Promise> ImportCookies(v8::Isolate* isolate,
+                                       const std::string& request_id,
+                                       const base::ListValue& rows) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    auto request = CreateRequest(request_id, std::move(promise));
+    if (!request)
+      return handle;
+    if (!ValidateBatchSize(rows, request))
+      return handle;
+
+    for (size_t i = 0; i < rows.size(); ++i) {
+      ParsedCookie cookie;
+      std::string error;
+      if (!ParseCookie(rows[i], &cookie, &error)) {
+        Reject(request, std::move(error));
+        return handle;
+      }
+      request->cookies.push_back(std::move(cookie));
+    }
+    if (!profile_->GetDefaultStoragePartition()
+             ->GetCookieManagerForBrowserProcess()) {
+      Reject(request, "The native Profile has no cookie manager");
+      return handle;
+    }
+    pending_[request_id] = request;
+    WriteNextCookie(request);
+    return handle;
+  }
+
+  v8::Local<v8::Promise> ImportPasswords(v8::Isolate* isolate,
+                                         const std::string& request_id,
+                                         const base::ListValue& rows) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    auto request = CreateRequest(request_id, std::move(promise));
+    if (!request)
+      return handle;
+    if (!ValidateBatchSize(rows, request))
+      return handle;
+
+    for (size_t i = 0; i < rows.size(); ++i) {
+      password_manager::StoredCredential form;
+      std::string error;
+      if (!ParsePassword(rows[i], &form, &error)) {
+        Reject(request, std::move(error));
+        return handle;
+      }
+      request->passwords.push_back(std::move(form));
+    }
+    request->password_store = ProfilePasswordStoreFactory::GetForProfile(
+        profile_, ServiceAccessType::EXPLICIT_ACCESS);
+    if (!request->password_store) {
+      Reject(request, "The native Profile has no password store");
+      return handle;
+    }
+    pending_[request_id] = request;
+    WriteNextPassword(request);
+    return handle;
+  }
+
+  v8::Local<v8::Promise> ImportHistory(v8::Isolate* isolate,
+                                       const std::string& request_id,
+                                       const base::ListValue& rows) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    auto request = CreateRequest(request_id, std::move(promise));
+    if (!request)
+      return handle;
+    if (!ValidateBatchSize(rows, request))
+      return handle;
+
+    for (size_t i = 0; i < rows.size(); ++i) {
+      history::URLRow row;
+      std::string error;
+      if (!ParseHistory(rows[i], &row, &error)) {
+        Reject(request, std::move(error));
+        return handle;
+      }
+      request->history.push_back(std::move(row));
+    }
+    history::HistoryService* service = HistoryServiceFactory::GetForProfile(
+        profile_, ServiceAccessType::EXPLICIT_ACCESS);
+    if (!service) {
+      Reject(request, "The native Profile has no history service");
+      return handle;
+    }
+    request->history_tracker = std::make_unique<base::CancelableTaskTracker>();
+    pending_[request_id] = request;
+    auto completed = base::BindOnce(&Impl::OnHistoryDone,
+                                    base::RetainedRef(this), request);
+    service->ScheduleDBTask(
+        FROM_HERE,
+        std::make_unique<HistoryImportTask>(request, std::move(completed)),
+        request->history_tracker.get());
+    return handle;
+  }
+
+  v8::Local<v8::Promise> LoadExtension(v8::Isolate* isolate,
+                                       const base::FilePath& path) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    if (closed_) {
+      promise.RejectWithErrorMessage("The native Profile service has been closed");
+      return handle;
+    }
+    if (path.empty() || !path.IsAbsolute()) {
+      promise.RejectWithErrorMessage("Extension path must be absolute");
+      return handle;
+    }
+    auto installer = extensions::UnpackedInstaller::Create(profile_);
+    auto installer_keepalive = installer;
+    installer->set_be_noisy_on_failure(false);
+    installer->set_completion_callback(base::BindOnce(
+        [](gin_helper::Promise<base::DictValue> promise,
+           scoped_refptr<extensions::UnpackedInstaller> installer,
+           const extensions::Extension* extension,
+           const base::FilePath& extension_path,
+           const std::u16string& error) {
+          if (!error.empty() || !extension) {
+            promise.RejectWithErrorMessage(
+                "Extension installation failed: " +
+                base::UTF16ToUTF8(error));
+            return;
+          }
+          base::DictValue result;
+          result.Set("id", extension->id());
+          result.Set("name", extension->name());
+          result.Set("path", extension_path.AsUTF8Unsafe());
+          promise.Resolve(result);
+        },
+        std::move(promise), std::move(installer_keepalive)));
+    installer->Load(path);
+    return handle;
+  }
+
+  void Cancel(const std::string& request_id) {
+    auto found = pending_.find(request_id);
+    if (found == pending_.end())
+      return;
+    found->second->cancelled = true;
+    found->second->cancel_requested.store(true);
+  }
+
+  void Dispose() {
+    if (closed_)
+      return;
+    closed_ = true;
+    // Keep in-flight writes alive until their backend receipts arrive. This
+    // method also runs during V8 finalization, where executing JS is forbidden.
+    for (auto& [id, request] : pending_) {
+      request->cancelled = true;
+      request->cancel_requested.store(true);
+    }
+  }
+
+ private:
+  scoped_refptr<NativeImportRequest> CreateRequest(
+      const std::string& request_id,
+      gin_helper::Promise<base::DictValue> promise) {
+    if (closed_ || request_id.empty() ||
+        request_id.size() > kMaxRequestIdLength) {
+      promise.RejectWithErrorMessage(
+          "A live native Profile and bounded request id are required");
+      return nullptr;
+    }
+    if (pending_.contains(request_id) ||
+        pending_.size() >= kMaxPendingImports) {
+      promise.RejectWithErrorMessage(
+          "Native import capacity or duplicate request id");
+      return nullptr;
+    }
+    return base::MakeRefCounted<NativeImportRequest>(
+        request_id, std::move(promise));
+  }
+
+  bool ValidateBatchSize(const base::ListValue& rows,
+                         const scoped_refptr<NativeImportRequest>& request) {
+    if (rows.size() > kMaxRowsPerImport) {
+      Reject(request, "Native import batch exceeds 250 rows");
+      return false;
+    }
+    return true;
+  }
+
+  void Reject(const scoped_refptr<NativeImportRequest>& request,
+              std::string error) {
+    if (request->settled.exchange(true))
+      return;
+    if (request->promise_)
+      request->promise_->RejectWithErrorMessage(std::move(error));
+  }
+
+  void Finish(const scoped_refptr<NativeImportRequest>& request,
+              bool cancelled,
+              std::string error) {
+    if (request->settled.exchange(true))
+      return;
+    base::DictValue result;
+    result.Set("applied",
+               static_cast<int>(request->applied.load(std::memory_order_relaxed)));
+    if (cancelled)
+      result.Set("cancelled", true);
+    if (!error.empty())
+      result.Set("error", std::move(error));
+    if (request->promise_)
+      request->promise_->Resolve(result);
+    request->promise_.reset();
+    pending_.erase(request->id);
+  }
+
+  void WriteNextCookie(const scoped_refptr<NativeImportRequest>& request) {
+    if (request->settled)
+      return;
+    if (request->cancel_requested) {
+      Finish(request, true, std::string());
+      return;
+    }
+    if (request->next >= request->cookies.size()) {
+      Finish(request, false, std::string());
+      return;
+    }
+    const ParsedCookie& cookie = request->cookies[request->next];
+    auto* manager = profile_->GetDefaultStoragePartition()
+                        ->GetCookieManagerForBrowserProcess();
+    manager->SetCanonicalCookie(
+        *cookie.cookie, cookie.source_url, cookie.options,
+        base::BindOnce(&Impl::OnCookieWritten, base::RetainedRef(this),
+                       request));
+  }
+
+  void OnCookieWritten(const scoped_refptr<NativeImportRequest>& request,
+                       net::CookieAccessResult result) {
+    if (request->settled)
+      return;
+    if (!result.status.IsInclude()) {
+      Finish(request, false,
+             "Cookie row was rejected by the native cookie store");
+      return;
+    }
+    request->applied.fetch_add(1, std::memory_order_relaxed);
+    ++request->next;
+    if (request->cancel_requested) {
+      Finish(request, true, std::string());
+      return;
+    }
+    WriteNextCookie(request);
+  }
+
+  void WriteNextPassword(const scoped_refptr<NativeImportRequest>& request) {
+    if (request->settled)
+      return;
+    if (request->cancel_requested) {
+      Finish(request, true, std::string());
+      return;
+    }
+    if (request->next >= request->passwords.size()) {
+      Finish(request, false, std::string());
+      return;
+    }
+    ReadPassword(request, false);
+  }
+
+  void ReadPassword(const scoped_refptr<NativeImportRequest>& request, bool verify) {
+    const auto& form = verify ? *request->writing_password : request->passwords[request->next];
+    auto digest = password_manager::PasswordFormDigest(form.scheme, form.signon_realm, form.url);
+    request->password_reader = std::make_unique<NativePasswordReader>(base::BindOnce(
+        &Impl::OnPasswordRead, base::RetainedRef(this), request, verify));
+    request->password_store->GetLogins(digest, request->password_reader->GetWeakPtr());
+  }
+
+  void OnPasswordRead(const scoped_refptr<NativeImportRequest>& request, bool verify,
+                      password_manager::LoginsResultOrError results) {
+    request->password_reader.reset();
+    if (request->settled)
+      return;
+    auto* forms = std::get_if<password_manager::LoginsResult>(&results);
+    if (!forms) {
+      Finish(request, request->cancel_requested, "Native password store read failed");
+      return;
+    }
+    const auto& incoming = request->passwords[request->next];
+    if (verify) {
+      const auto& written = *request->writing_password;
+      const bool stored = std::ranges::any_of(*forms, [&](const auto& form) {
+        return form.signon_realm == written.signon_realm && form.url == written.url &&
+               form.username_value == written.username_value &&
+               form.password_value == written.password_value && !form.blocked_by_user;
+      });
+      request->writing_password.reset();
+      if (!stored) {
+        Finish(request, request->cancel_requested, "Password write could not be confirmed");
+        return;
+      }
+      request->applied.fetch_add(1, std::memory_order_relaxed);
+      ++request->next;
+      WriteNextPassword(request);
+      return;
+    }
+    if (request->cancel_requested) {
+      Finish(request, true, std::string());
+      return;
+    }
+    auto existing = std::ranges::find_if(*forms, [&](const auto& form) {
+      return form.signon_realm == incoming.signon_realm &&
+             form.username_value == incoming.username_value && !form.blocked_by_user;
+    });
+    const bool update = existing != forms->end();
+    request->writing_password = update ? std::move(*existing) : incoming;
+    request->writing_password->password_value = incoming.password_value;
+    auto complete = base::BindOnce(&Impl::ReadPassword, base::RetainedRef(this), request, true);
+    if (update)
+      request->password_store->UpdateLogin(*request->writing_password, std::move(complete));
+    else
+      request->password_store->AddLogin(*request->writing_password, std::move(complete));
+  }
+
+  void OnHistoryDone(const scoped_refptr<NativeImportRequest>& request,
+                     bool cancelled,
+                     std::string error) {
+    if (request->settled)
+      return;
+    if (request->cancel_requested)
+      cancelled = true;
+    Finish(request, cancelled, std::move(error));
+  }
+
+  raw_ptr<Profile> profile_;
+  bool closed_ = false;
+  std::map<std::string, scoped_refptr<NativeImportRequest>> pending_;
+
+};
+
+NativeBrowserImport::NativeBrowserImport(Profile* profile)
+    : impl_(base::MakeRefCounted<Impl>(profile)) {}
+
+NativeBrowserImport::~NativeBrowserImport() = default;
+
+v8::Local<v8::Promise> NativeBrowserImport::ImportCookies(
+    v8::Isolate* isolate,
+    const std::string& request_id,
+    const base::ListValue& rows) {
+  return impl_->ImportCookies(isolate, request_id, rows);
+}
+
+v8::Local<v8::Promise> NativeBrowserImport::ImportPasswords(
+    v8::Isolate* isolate,
+    const std::string& request_id,
+    const base::ListValue& rows) {
+  return impl_->ImportPasswords(isolate, request_id, rows);
+}
+
+v8::Local<v8::Promise> NativeBrowserImport::ImportHistory(
+    v8::Isolate* isolate,
+    const std::string& request_id,
+    const base::ListValue& rows) {
+  return impl_->ImportHistory(isolate, request_id, rows);
+}
+
+v8::Local<v8::Promise> NativeBrowserImport::LoadExtension(
+    v8::Isolate* isolate,
+    const base::FilePath& path) {
+  return impl_->LoadExtension(isolate, path);
+}
+
+void NativeBrowserImport::Cancel(const std::string& request_id) {
+  impl_->Cancel(request_id);
+}
+
+void NativeBrowserImport::Dispose() {
+  impl_->Dispose();
+}
