+class Profile;
+
+namespace electron::api {
+
+// Applies bounded, validated import batches to the real native Profile
+// services. The owner keeps one instance per NativeProfile and must call
+// Dispose() before releasing it.
+class NativeBrowserImport final {
+ public:
+  explicit NativeBrowserImport(Profile* profile);
+  ~NativeBrowserImport();
+
+  NativeBrowserImport(const NativeBrowserImport&) = delete;
+  NativeBrowserImport& operator=(const NativeBrowserImport&) = delete;
+
+  v8::Local<v8::Promise> ImportCookies(v8::Isolate* isolate,
+                                       const std::string& request_id,
+                                       const base::ListValue& rows);
+  v8::Local<v8::Promise> ImportPasswords(v8::Isolate* isolate,
+                                         const std::string& request_id,
+                                         const base::ListValue& rows);
+  v8::Local<v8::Promise> ImportHistory(v8::Isolate* isolate,
+                                       const std::string& request_id,
+                                       const base::ListValue& rows);
+  v8::Local<v8::Promise> LoadExtension(v8::Isolate* isolate,
+                                       const base::FilePath& path);
+  void Cancel(const std::string& request_id);
+  void Dispose();
+
+ private:
+  class Impl;
+  scoped_refptr<Impl> impl_;
+};
