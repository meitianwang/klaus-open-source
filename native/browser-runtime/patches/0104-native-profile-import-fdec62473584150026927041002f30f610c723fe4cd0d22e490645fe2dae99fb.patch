+struct ParsedCookie {
+  std::unique_ptr<net::CanonicalCookie> cookie;
+  GURL source_url;
+  net::CookieOptions options;
+};
+
+std::optional<std::string> GetString(const base::DictValue& row,
+                                     const char* key) {
+  const std::string* value = row.FindString(key);
+  if (!value)
+    return std::nullopt;
+  return *value;
+}
+
+bool GetOptionalBool(const base::DictValue& row,
+                     const char* key,
+                     bool* out) {
+  const base::Value* value = row.Find(key);
+  if (!value)
+    return true;
+  std::optional<bool> parsed = value->GetIfBool();
+  if (!parsed)
+    return false;
+  *out = *parsed;
+  return true;
+}
+
+std::optional<net::CookieSameSite> ParseSameSite(const std::string& value) {
+  if (value == "unspecified")
+    return net::CookieSameSite::UNSPECIFIED;
+  if (value == "no_restriction")
+    return net::CookieSameSite::NO_RESTRICTION;
+  if (value == "lax")
+    return net::CookieSameSite::LAX_MODE;
+  if (value == "strict")
+    return net::CookieSameSite::STRICT_MODE;
+  return std::nullopt;
+}
+
+bool ParseCookie(const base::Value& value,
+                 ParsedCookie* out,
+                 std::string* error) {
+  if (!value.is_dict()) {
+    *error = "Cookie row must be an object";
+    return false;
+  }
+  const base::DictValue& row = value.GetDict();
+  auto domain = GetString(row, "domain");
+  auto path = GetString(row, "path");
+  auto name = GetString(row, "name");
+  auto value_text = GetString(row, "value");
+  auto same_site_text = GetString(row, "sameSite");
+  if (!domain || !path || !name || !value_text || !same_site_text) {
+    *error = "Cookie row is missing a required string";
+    return false;
+  }
+  bool http_only = false;
+  bool secure = false;
+  if (!GetOptionalBool(row, "httpOnly", &http_only) ||
+      !GetOptionalBool(row, "secure", &secure)) {
+    *error = "Cookie row has a non-boolean attribute";
+    return false;
+  }
+  auto same_site = ParseSameSite(*same_site_text);
+  if (!same_site) {
+    *error = "Cookie row has an unsupported sameSite value";
+    return false;
+  }
+
+  base::Time expires;
+  const base::Value* expires_value = row.Find("expiresAt");
+  if (expires_value) {
+    std::optional<double> milliseconds = expires_value->GetIfDouble();
+    if (!milliseconds || *milliseconds <= 0 ||
+        *milliseconds > 253402300799999.0) {
+      *error = "Cookie row has an invalid expiresAt";
+      return false;
+    }
+    expires =
+        base::Time::FromMillisecondsSinceUnixEpoch(*milliseconds);
+    if (expires <= base::Time::Now()) {
+      *error = "Cookie row is already expired";
+      return false;
+    }
+  }
+
+  std::optional<net::CookiePartitionKey> partition_key;
+  const base::Value* top_frame_value = row.Find("topFrameSiteKey");
+  if (top_frame_value && !top_frame_value->is_string()) {
+    *error = "Cookie row has an invalid topFrameSiteKey";
+    return false;
+  }
+  auto top_frame_site_key = GetString(row, "topFrameSiteKey");
+  bool has_cross_site_ancestor = false;
+  if (!GetOptionalBool(row, "hasCrossSiteAncestor",
+                       &has_cross_site_ancestor)) {
+    *error = "Cookie row has an invalid hasCrossSiteAncestor";
+    return false;
+  }
+  if (top_frame_site_key && !top_frame_site_key->empty()) {
+    auto parsed_partition = net::CookiePartitionKey::FromStorage(
+        *top_frame_site_key, has_cross_site_ancestor);
+    if (!parsed_partition.has_value() || !parsed_partition->has_value()) {
+      *error = "Cookie row has an invalid partition key";
+      return false;
+    }
+    partition_key = parsed_partition.value();
+  } else if (has_cross_site_ancestor) {
+    *error = "A cross-site ancestor requires a top-frame site key";
+    return false;
+  }
+
+  std::string host = *domain;
+  if (!host.empty() && host.front() == '.')
+    host.erase(host.begin());
+  if (host.empty()) {
+    *error = "Cookie row has an empty domain";
+    return false;
+  }
+  std::string cookie_path = *path;
+  if (cookie_path.empty())
+    cookie_path = "/";
+  const std::string scheme = secure ? "https://" : "http://";
+  GURL source_url(scheme + host + cookie_path);
+  if (!source_url.is_valid() || !source_url.SchemeIsHTTPOrHTTPS()) {
+    *error = "Cookie row has an invalid domain or path";
+    return false;
+  }
+
+  net::CookieInclusionStatus status;
+  auto canonical = net::CanonicalCookie::CreateSanitizedCookie(
+      source_url, *name, *value_text,
+      domain->starts_with(".") ? *domain : std::string(), cookie_path, base::Time::Now(),
+      expires, base::Time::Now(), secure, http_only, *same_site,
+      net::COOKIE_PRIORITY_DEFAULT, partition_key, &status);
+  if (!canonical || !canonical->IsCanonical()) {
+    *error = "Cookie row failed canonical validation";
+    return false;
+  }
+
+  out->cookie = std::move(canonical);
+  out->source_url = std::move(source_url);
+  out->options = net::CookieOptions();
+  if (http_only)
+    out->options.set_include_httponly();
+  out->options.set_same_site_cookie_context(
+      net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+  return true;
+}
+
+bool ParsePassword(const base::Value& value,
+                   password_manager::StoredCredential* out,
+                   std::string* error) {
+  if (!value.is_dict()) {
+    *error = "Password row must be an object";
+    return false;
+  }
+  const base::DictValue& row = value.GetDict();
+  auto origin_url = GetString(row, "originUrl");
+  auto username = GetString(row, "username");
+  auto password = GetString(row, "password");
+  if (!origin_url || !username || !password || password->empty()) {
+    *error = "Password row is missing a required value";
+    return false;
+  }
+  GURL url(*origin_url);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    *error = "Password row has an invalid originUrl";
+    return false;
+  }
+  out->scheme = password_manager::PasswordForm::Scheme::kHtml;
+  out->signon_realm = url.DeprecatedGetOriginAsURL().spec();
+  out->url = url;
+  out->action = url;
+  out->username_value = base::UTF8ToUTF16(*username);
+  out->password_value = base::UTF8ToUTF16(*password);
+  out->date_created = base::Time::Now();
+  out->type = password_manager::PasswordForm::Type::kImported;
+  return true;
+}
+
+bool ParseHistory(const base::Value& value,
+                  history::URLRow* out,
+                  std::string* error) {
+  if (!value.is_dict()) {
+    *error = "History row must be an object";
+    return false;
+  }
+  const base::DictValue& row = value.GetDict();
+  auto url_text = GetString(row, "url");
+  auto title = GetString(row, "title");
+  const base::Value* visited_value = row.Find("visitedAt");
+  std::optional<double> visited_at =
+      visited_value ? visited_value->GetIfDouble() : std::nullopt;
+  if (!url_text || !title || !visited_at || *visited_at <= 0) {
+    *error = "History row is missing a required value";
+    return false;
+  }
+  GURL url(*url_text);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    *error = "History row has an invalid url";
+    return false;
+  }
+  out->set_url(url);
+  out->set_title(base::UTF8ToUTF16(*title));
+  out->set_visit_count(1);
+  out->set_typed_count(0);
+  out->set_hidden(false);
+  out->set_last_visit(
+      base::Time::FromMillisecondsSinceUnixEpoch(*visited_at));
+  return true;
+}
