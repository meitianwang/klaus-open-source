+class NativePasswordReader final : public password_manager::PasswordStoreConsumer {
+ public:
+  using Callback = base::OnceCallback<void(password_manager::LoginsResultOrError)>;
+  explicit NativePasswordReader(Callback callback) : callback_(std::move(callback)) {}
+  ~NativePasswordReader() override = default;
+  base::WeakPtr<NativePasswordReader> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+  void OnGetPasswordStoreResultsOrErrorFrom(
+      password_manager::PasswordStoreInterface* store,
+      password_manager::LoginsResultOrError results) override {
+    auto callback = std::move(callback_);
+    std::move(callback).Run(std::move(results));
+  }
+ private:
+  Callback callback_;
+  base::WeakPtrFactory<NativePasswordReader> weak_factory_{this};
+};
