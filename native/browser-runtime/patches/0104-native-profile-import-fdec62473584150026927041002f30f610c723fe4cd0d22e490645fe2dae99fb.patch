+
+class HistoryImportTask final : public history::HistoryDBTask {
+ public:
+  using DoneCallback = base::OnceCallback<void(bool cancelled,
+                                               std::string error)>;
+
+  HistoryImportTask(scoped_refptr<NativeImportRequest> request,
+                    DoneCallback done)
+      : request_(std::move(request)), done_(std::move(done)) {}
+
+  HistoryImportTask(const HistoryImportTask&) = delete;
+  HistoryImportTask& operator=(const HistoryImportTask&) = delete;
+
+  bool RunOnDBThread(history::HistoryBackend* backend,
+                     history::HistoryDatabase* db) override {
+    if (!db) {
+      error_ = "History database is unavailable";
+      return true;
+    }
+    for (; request_->next < request_->history.size(); ++request_->next) {
+      if (request_->cancel_requested.load(std::memory_order_relaxed)) {
+        cancelled_ = true;
+        return true;
+      }
+      const history::URLRow& row = request_->history[request_->next];
+      history::URLRows rows{row};
+      backend->AddPagesWithDetails(rows,
+                                   history::SOURCE_OS_MIGRATION_IMPORTED);
+
+      history::URLRow stored;
+      history::URLID url_id = db->GetRowForURL(row.url(), &stored);
+      if (!url_id) {
+        error_ = "History row was not stored";
+        return true;
+      }
+      history::VisitVector visits;
+      if (!db->GetVisitsForURL(url_id, &visits)) {
+        error_ = "History visit lookup failed";
+        return true;
+      }
+      bool found = false;
+      for (const history::VisitRow& visit : visits) {
+        if (visit.visit_time == row.last_visit() &&
+            db->GetVisitSource(visit.visit_id) == history::SOURCE_OS_MIGRATION_IMPORTED) {
+          found = true;
+          break;
+        }
+      }
+      if (!found) {
+        error_ = "History visit was not stored";
+        return true;
+      }
+      request_->applied.fetch_add(1, std::memory_order_relaxed);
+    }
+    return true;
+  }
+
+  void DoneRunOnMainThread() override {
+    std::move(done_).Run(cancelled_, std::move(error_));
+  }
+
+ private:
+  scoped_refptr<NativeImportRequest> request_;
+  DoneCallback done_;
+  bool cancelled_ = false;
+  std::string error_;
+};
+
+}  // namespace
