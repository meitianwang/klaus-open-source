   std::string GetTitle() const {
     return web_contents() ? base::UTF16ToUTF8(web_contents()->GetTitle()) : "";
   }
+  base::DictValue GetState() const {
+    base::DictValue state;
+    state.Set("url", GetURL());
+    state.Set("title", GetTitle());
+    state.Set("loading", web_contents() && web_contents()->IsLoading());
+    state.Set("canGoBack", web_contents() &&
+                               web_contents()->GetController().CanGoBack());
+    state.Set("canGoForward", web_contents() &&
+                                  web_contents()->GetController().CanGoForward());
+    return state;
+  }
+  void BeginActivity(gin::Arguments* args) {
+    if (IsClosed()) {
+      gin_helper::ErrorThrower(args->isolate()).ThrowError(
+          "Native browser has been closed");
+      return;
+    }
+    if (activity_users_++ == 0) {
+      // A bounded capture lease keeps background compositor frames available.
+      // The native window stays hidden and normal idle scheduling resumes when
+      // the final operation releases its lease.
+      activity_capture_ = web_contents()->IncrementCapturerCount(
+          gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+          /*is_activity=*/true);
+    }
+  }
+  void EndActivity() {
+    if (activity_users_ == 0)
+      return;
+    if (--activity_users_ == 0)
+      activity_capture_.RunAndReset();
+  }
