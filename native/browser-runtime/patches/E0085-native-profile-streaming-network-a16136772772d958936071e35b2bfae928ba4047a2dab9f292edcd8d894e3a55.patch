+  v8::Local<v8::Promise> StartRequest(v8::Isolate* isolate,
+                                     const std::string& id, const GURL& url) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    if (IsClosed() || id.empty() || id.size() > 256 || !url.SchemeIsHTTPOrHTTPS()) {
+      promise.RejectWithErrorMessage(
+          "A live native page, request id and HTTP URL are required");
+      return handle;
+    }
+    if (requests_.contains(id) || requests_.size() >= 16) {
+      promise.RejectWithErrorMessage("Native request capacity or duplicate id");
+      return handle;
+    }
+    auto request = std::make_unique<NativeProfileRequest>(
+        browser_->GetProfile(), url, std::move(promise));
+    auto* pending = request.get();
+    requests_.emplace(id, std::move(request));
+    pending->Start();
+    return handle;
+  }
+  v8::Local<v8::Promise> ReadRequest(v8::Isolate* isolate,
+                                    const std::string& id) {
+    auto found = requests_.find(id);
+    if (found != requests_.end())
+      return found->second->Read(isolate);
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    promise.RejectWithErrorMessage("The native request has been released");
+    return handle;
+  }
