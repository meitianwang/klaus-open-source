+// A native Profile request retains only one unread chunk. The host must read
+// or cancel it; redirect responses are returned before following another URL so
+// the host can authorize each destination using the original Profile cookies.
+class NativeProfileRequest final : public network::SimpleURLLoaderStreamConsumer {
+ public:
+  NativeProfileRequest(Profile* profile, const GURL& url,
+                       gin_helper::Promise<base::DictValue> headers)
+      : headers_(std::make_unique<gin_helper::Promise<base::DictValue>>(
+            std::move(headers))) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+    request->site_for_cookies = net::SiteForCookies::FromUrl(url);
+    request->trusted_params = network::ResourceRequest::TrustedParams();
+    request->trusted_params->isolation_info =
+        net::IsolationInfo::CreateForInternalRequest(url::Origin::Create(url));
+    static constexpr auto annotation = net::DefineNetworkTrafficAnnotation(
+        "embedded_browser_profile_download", R"(
+        semantics {
+          sender: "Embedded browser download"
+          description: "Downloads an explicitly selected resource using the browser profile."
+          trigger: "A user or authorized browser operation requests a download."
+          data: "The resource URL and cookies belonging to the browser profile."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: YES
+          cookies_store: "The native browser profile cookie store."
+          setting: "Browser access and download permissions control requests."
+          policy_exception_justification: "The host authorizes every destination."
+        })");
+    loader_ = network::SimpleURLLoader::Create(std::move(request), annotation);
+    loader_->SetAllowHttpErrorResults(true);
+    loader_->SetTimeoutDuration(base::Minutes(5));
+    loader_->SetOnResponseStartedCallback(base::BindOnce(
+        &NativeProfileRequest::OnHeaders, base::Unretained(this)));
+    loader_->SetOnRedirectCallback(base::BindRepeating(
+        &NativeProfileRequest::OnRedirect, base::Unretained(this)));
+    factory_ = profile->GetDefaultStoragePartition()
+                   ->GetURLLoaderFactoryForBrowserProcess();
+  }
+  ~NativeProfileRequest() override = default;
+
+  void Start() { loader_->DownloadAsStream(factory_.get(), this); }
+  v8::Local<v8::Promise> Read(v8::Isolate* isolate) {
+    gin_helper::Promise<base::DictValue> promise(isolate);
+    auto handle = promise.GetHandle();
+    if (reader_) {
+      promise.RejectWithErrorMessage("A native response read is already pending");
+      return handle;
+    }
+    reader_ = std::make_unique<gin_helper::Promise<base::DictValue>>(
+        std::move(promise));
+    FlushRead();
+    return handle;
+  }
+  void Cancel() {
+    loader_.reset();
+    resume_.Reset();
+    chunk_.clear();
+    done_ = true;
+    error_ = "Native profile request was cancelled";
+    if (headers_) {
+      headers_->RejectWithErrorMessage(error_);
+      headers_.reset();
+    }
+    FlushRead();
+  }
+
+ private:
+  void ResolveHeaders(const GURL& url,
+                      const network::mojom::URLResponseHead& response) {
+    if (!headers_)
+      return;
+    base::DictValue result;
+    result.Set("url", url.spec());
+    result.Set("status", response.headers ? response.headers->response_code() : 0);
+    base::ListValue headers;
+    if (response.headers) {
+      size_t iterator = 0;
+      std::string name, value;
+      while (response.headers->EnumerateHeaderLines(&iterator, &name, &value)) {
+        base::ListValue pair;
+        pair.Append(name);
+        pair.Append(value);
+        headers.Append(std::move(pair));
+      }
+    }
+    result.Set("headers", std::move(headers));
+    headers_->Resolve(result);
+    headers_.reset();
+  }
+  void OnHeaders(const GURL& url,
+                 const network::mojom::URLResponseHead& response) {
+    ResolveHeaders(url, response);
+  }
+  void OnRedirect(const GURL& previous, const net::RedirectInfo& redirect,
+                  const network::mojom::URLResponseHead& response,
+                  std::vector<std::string>* removed_headers) {
+    // SimpleURLLoader explicitly permits destruction in this callback. Stop
+    // before the redirect is followed, retaining the normal response cookies.
+    loader_.reset();
+    done_ = true;
+    ResolveHeaders(previous, response);
+    FlushRead();
+  }
+  void OnDataReceived(std::string_view data, base::OnceClosure resume) override {
+    chunk_.assign(data);
+    resume_ = std::move(resume);
+    FlushRead();
+  }
+  void OnComplete(bool success) override {
+    done_ = true;
+    if (!success)
+      error_ = "Native profile request failed: " +
+               std::to_string(loader_ ? loader_->NetError() : -1);
+    if (headers_) {
+      headers_->RejectWithErrorMessage(error_.empty()
+          ? "The native request returned no response headers" : error_);
+      headers_.reset();
+    }
+    FlushRead();
+  }
+  void OnRetry(base::OnceClosure start_retry) override {
+    std::move(start_retry).Run();
+  }
+  void FlushRead() {
+    if (!reader_ || (chunk_.empty() && !done_))
+      return;
+    auto reader = std::move(reader_);
+    if (!error_.empty()) {
+      reader->RejectWithErrorMessage(error_);
+      return;
+    }
+    base::DictValue result;
+    result.Set("done", chunk_.empty() && done_);
+    if (!chunk_.empty()) {
+      result.Set("data", base::Base64Encode(chunk_));
+      chunk_.clear();
+    }
+    auto resume = std::move(resume_);
+    reader->Resolve(result);
+    if (resume)
+      std::move(resume).Run();
+  }
+
+  std::unique_ptr<gin_helper::Promise<base::DictValue>> headers_;
+  std::unique_ptr<gin_helper::Promise<base::DictValue>> reader_;
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::string chunk_;
+  std::string error_;
+  base::OnceClosure resume_;
+  bool done_ = false;
+};
