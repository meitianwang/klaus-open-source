+void ElectronBrowserProcessImpl::RunNativeProfileProbeIfRequested() {
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kNativeProfileProbeSwitch))
+    return;
+
+  base::DictValue result;
+  result.Set("probe", "native-profile");
+  result.Set("ok", false);
+
+  const auto finish = [&command_line](base::DictValue value) {
+    const base::FilePath output_path =
+        command_line->GetSwitchValuePath(kNativeProfileProbeOutputSwitch);
+    if (!output_path.empty()) {
+      std::string json;
+      base::Value root(std::move(value));
+      base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+      base::WriteFile(output_path, json);
+    }
+    electron::Browser::Get()->Quit();
+  };
+
+  if (!command_line->HasSwitch("use-mock-keychain")) {
+    result.Set("error", "probe requires --use-mock-keychain");
+    finish(std::move(result));
+    return;
+  }
+
+  ProfileManager* manager = profile_manager();
+  if (manager == nullptr) {
+    result.Set("error", "profile_manager_null");
+    finish(std::move(result));
+    return;
+  }
+
+  base::FilePath data_dir;
+  if (command_line->HasSwitch(kNativeProfileProbeDataDirSwitch)) {
+    data_dir =
+        command_line->GetSwitchValuePath(kNativeProfileProbeDataDirSwitch);
+  } else {
+    CHECK(base::PathService::Get(electron::DIR_SESSION_DATA, &data_dir));
+  }
+  const base::FilePath profile_dir =
+      data_dir.Append(FILE_PATH_LITERAL("NativeProfileProbe"));
+  base::CreateDirectory(profile_dir);
+
+  Profile* profile = manager->GetProfile(profile_dir);
+  if (profile == nullptr) {
+    result.Set("error", "profile_null");
+    finish(std::move(result));
+    return;
+  }
+
+  result.Set("profile_path", profile->GetPath().value());
+  result.Set("prefs", profile->GetPrefs() != nullptr);
+  // The process-wide ExtensionsBrowserClient is Electron's client. Chrome
+  // extension services are deferred until a profile-aware delegate exists;
+  // do not report a nullable service lookup as success here.
+  result.Set("extension_system_state", "deferred_electron_global_client");
+  result.Set(
+      "personal_data_manager",
+      autofill::PersonalDataManagerFactory::GetForBrowserContext(profile) !=
+          nullptr);
+  const auto password_store = ProfilePasswordStoreFactory::GetForProfile(
+      profile, ServiceAccessType::EXPLICIT_ACCESS);
+  result.Set("password_store", password_store != nullptr);
+
+  content::WebContents::CreateParams params(profile);
+  auto web_contents = content::WebContents::Create(params);
+  result.Set("web_contents", web_contents != nullptr);
+
+  // Prove the existing Electron context still coexists. Use an in-memory
+  // context so the probe never reads or writes the application's real data.
+  ElectronBrowserContext* electron_context = ElectronBrowserContext::From(
+      "native-profile-probe-electron", true, base::DictValue());
+  content::WebContents::CreateParams electron_params(electron_context);
+  auto electron_contents = content::WebContents::Create(electron_params);
+  result.Set("electron_context_web_contents", electron_contents != nullptr);
+  electron_contents.reset();
+  // This WebContents is created directly from content::WebContents, not from
+  // api::WebContents, so no Electron preload, Node integration, or IPC bridge
+  // is installed for the probe profile.
+  result.Set("electron_bridge", false);
+
+  web_contents.reset();
+  result.Set("ok", true);
+  finish(std::move(result));
+}
