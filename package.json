{
  "name": "klaus-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Klaus desktop client. TypeScript owns host business logic and the single engine process.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meitianwang/klaus-open-source.git"
  },
  "type": "commonjs",
  "main": "dist/main/index.js",
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": false
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build:bindings",
    "start": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "package:test": "node scripts/test-packaging.mjs",
    "package:smoke": "node scripts/smoke-package.mjs",
    "package:measure": "node scripts/measure-package.mjs",
    "test:app": "node scripts/run-app-test.mjs",
    "audit:runtime-channels": "node scripts/audit-runtime-channels.mjs",
    "test:engine": "npm run build && node scripts/run-tests.mjs engine-protocol",
    "test:manager": "npm run build && node scripts/run-tests.mjs engine-manager",
    "test:live": "npm run build && node scripts/run-tests.mjs engine-live",
    "test:ipc": "npm run build && node scripts/run-tests.mjs ipc-router ipc-contract ipc-binding project",
    "test": "node scripts/gate.mjs",
    "build:main": "tsc -p tsconfig.build.json && npm run build:bindings",
    "build:preload": "node scripts/build-preload.mjs",
    "build:native": "node native/scripts/build.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:browser": "npm run build && node dist/tests/browser-policy.test.js && node dist/tests/browser-electron.test.js",
    "test:browser-tab-mentions": "node scripts/run-browser-tab-mentions-test.mjs",
    "test:models-source-ui": "node scripts/run-models-source-ui-test.mjs",
    "test:search-browser": "npm run build && node dist/tests/web-search-browser-electron.test.js",
    "test:project": "npm run build && node scripts/run-tests.mjs project",
    "test:services": "npm run build && node scripts/run-tests.mjs services",
    "test:session": "npm run build && node scripts/run-tests.mjs session-wire",
    "package:installer": "node scripts/package-installer.mjs",
    "build:frontend": "vite build --config vite.config.mts",
    "dev:frontend": "vite --config vite.config.mts",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "canvas:sdk-types": "tsc -p tsconfig.canvas-sdk.json",
    "test:frontend": "bun test ./frontend/src",
    "test:composer-context": "node scripts/run-electron-test.mjs tests/composer-context-electron.cjs",
    "test:composer-context-performance": "node scripts/run-electron-test.mjs tests/composer-context-performance.cjs",
    "test:turn-navigation": "node scripts/run-turn-navigation-test.mjs",
    "test:transcript-scroll": "node scripts/run-transcript-scroll-test.mjs",
    "test:subagent-lifecycle": "node scripts/run-subagent-lifecycle-test.mjs",
    "audit:command-map": "node scripts/audit-runtime-channels.mjs",
    "audit:ui": "node scripts/ui-token-audit.mjs",
    "dev": "node scripts/dev.mjs",
    "test:host": "npm run build && node scripts/run-tests.mjs",
    "test:pdf": "npm run build && node scripts/test-workspace-pdf.mjs",
    "test:dev-lifecycle": "node scripts/test-dev-lifecycle.mjs",
    "build:all": "node scripts/dev.mjs --prepare-only",
    "build:bindings": "tsc -p tsconfig.native-bindings.json",
    "test:workspace-editor": "node scripts/run-workspace-editor-test.mjs",
    "test:workspace-file-browser": "node scripts/run-workspace-file-browser-test.mjs",
    "test:editor-assets": "node scripts/run-editor-assets-test.mjs",
    "test:diagram-layout": "node scripts/run-diagram-layout-test.mjs",
    "test:composer-predictions": "node scripts/run-composer-prediction-host-test.mjs && node scripts/run-composer-prediction-test.mjs && node scripts/run-composer-prediction-settings-test.mjs",
    "test:hooks-settings": "node scripts/run-hooks-settings-test.mjs",
    "test:follow-up-queue": "node scripts/run-follow-up-queue-test.mjs",
    "test:planning-goals": "node scripts/run-planning-goals-test.mjs",
    "test:offscreen-turn": "node scripts/run-offscreen-turn-test.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/asar": "4.3.0",
    "@electron/packager": "20.0.4",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/core": "^2.1.1",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "5.104.1",
    "@types/iarna__toml": "2.0.5",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "7.7.1",
    "@types/three": "^0.186.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/xterm": "6.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "11.11.1",
    "katex": "0.17.0",
    "lodash-es": "4.18.1",
    "lucide-static": "^1.33.0",
    "marked": "15.0.12",
    "mermaid": "^12.2.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sucrase": "^3.35.1",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "xatlas-web": "0.1.0",
    "zustand": "5.0.14",
    "happy-dom": "^20.11.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@iarna/toml": "2.2.5",
    "@kreuzberg/wasm": "4.10.2",
    "@noble/hashes": "1.8.0",
    "croner": "10.0.1",
    "diff": "^8.0.4",
    "js-yaml": "4.3.2",
    "jsqr": "1.4.0",
    "manifold-3d": "3.2.1",
    "mdast-util-directive": "3.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "node-html-parser": "9.0.4",
    "nodemailer": "10.0.1",
    "qrcode": "1.5.4",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "ws": "8.21.3",
    "yauzl": "3.4.0"
  },
  "author": "Klaus"
}
